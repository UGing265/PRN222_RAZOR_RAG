@page "/documents/{slug}"
@model GUI.Pages.Documents.DetailsModel
@using System.Security.Claims
@{
    ViewData["Title"] = Model.ViewModel.Title;
    var currentUserId = Guid.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var parsedId) ? parsedId : Guid.Empty;
    var roleId = short.TryParse(User.FindFirstValue("role_id"), out var parsedRoleId) ? parsedRoleId : (short)0;
    var isOwner = Model.ViewModel.OwnerUserId == currentUserId;
}

<style>
    /* Premium Details Glassmorphism & Custom Typo */
    .details-panel-glass {
        background: rgba(255, 255, 255, 0.55) !important;
        backdrop-filter: blur(16px) !important;
        -webkit-backdrop-filter: blur(16px) !important;
        border: 1px solid rgba(82, 39, 27, 0.06) !important;
        border-radius: 24px !important;
        padding: 32px !important;
        transition: all 0.3s ease;
    }

    .badge-approved-glass {
        background: rgba(20, 110, 80, 0.08) !important;
        border: 1px solid rgba(20, 110, 80, 0.2) !important;
        color: #106e50 !important;
        font-weight: 700;
        letter-spacing: 0.05em;
    }

    .badge-pending-glass {
        background: rgba(216, 106, 88, 0.08) !important;
        border: 1px solid rgba(216, 106, 88, 0.2) !important;
        color: var(--coral) !important;
        font-weight: 700;
        letter-spacing: 0.05em;
    }

    .badge-rejected-glass {
        background: rgba(220, 53, 69, 0.08) !important;
        border: 1px solid rgba(220, 53, 69, 0.2) !important;
        color: #dc3545 !important;
        font-weight: 700;
        letter-spacing: 0.05em;
    }

    /* Cards inside Details */
    .item-card-glass {
        background: rgba(255, 255, 255, 0.4) !important;
        backdrop-filter: blur(8px) !important;
        border: 1.5px solid rgba(82, 39, 27, 0.06) !important;
        border-radius: 18px !important;
        padding: 20px !important;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
    }

    .item-card-glass:hover {
        background: rgba(255, 255, 255, 0.7) !important;
        border-color: rgba(216, 106, 88, 0.25) !important;
        transform: translateY(-2px) !important;
        box-shadow: 0 8px 22px rgba(82, 39, 27, 0.04) !important;
    }

    /* Custom Premium Accent Chips */
    .premium-accent-chip {
        background: rgba(216, 106, 88, 0.08) !important;
        border: 1px solid rgba(216, 106, 88, 0.15) !important;
        color: var(--coral) !important;
        font-size: 0.72rem !important;
        font-weight: 600 !important;
        border-radius: 9999px !important;
        padding: 4px 10px !important;
        font-family: var(--font-mono) !important;
    }

    /* Wrap-Word Text Overflow Fixes */
    .text-overflow-safe {
        word-wrap: break-word !important;
        word-break: break-word !important;
        overflow-wrap: break-word !important;
        white-space: normal !important;
        min-width: 0 !important;
    }

    .file-meta-key {
        font-size: 9px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted-foreground);
        font-family: var(--font-mono);
        margin-bottom: 4px;
    }

    .file-meta-value {
        font-weight: 600;
        color: var(--brown);
        font-size: 0.98rem;
    }
</style>

<div class="page-shell grain">
    <div class="container-fluid px-4 px-md-5 py-5" style="max-width: 1300px;">
        
        <!-- Header -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-4 mb-5">
            <div class="min-w-0 flex-grow-1">
                <span class="font-mono-xs text-coral-deep" style="font-weight: 700; letter-spacing: 0.15em;">KHO TÀI LIỆU</span>
                <h1 class="hero-title text-overflow-safe mt-2 mb-3" style="font-size: clamp(2.5rem, 5vw, 3.5rem); color: var(--brown); line-height: 1.1;">@Model.ViewModel.Title</h1>
                <div class="font-mono-xs text-muted-foreground d-flex align-items-center gap-2">
                    <span style="font-weight: 600; color: var(--coral);">[@Model.ViewModel.SubjectCode] @Model.ViewModel.SubjectName</span>
                </div>
            </div>
            
            <div class="d-flex gap-2 flex-wrap flex-shrink-0">
                @if (isOwner)
                {
                    <a asp-page="/Documents/Edit" asp-route-slug="@Model.ViewModel.Slug" class="btn btn-premium-primary pill-button px-4 py-2.5 d-inline-flex align-items-center gap-2" style="font-size: 0.88rem;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4z"/>
                        </svg>
                        Chỉnh Sửa
                    </a>
                    <a asp-page="/Documents/Delete" asp-route-slug="@Model.ViewModel.Slug" class="btn btn-premium-danger pill-button px-4 py-2.5 d-inline-flex align-items-center gap-2" style="font-size: 0.88rem;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                        </svg>
                        Xoá Tài Liệu
                    </a>
                }
                else if (roleId == 2 || roleId == 3)
                {
                    <button type="button" class="btn btn-premium-danger pill-button px-4 py-2.5 d-inline-flex align-items-center gap-2" style="font-size: 0.88rem;" data-bs-toggle="modal" data-bs-target="#reportModal">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>
                        </svg>
                        Báo Cáo Vi Phạm
                    </button>
                }
            </div>
        </div>


        <div class="row g-4">
            
            <!-- Left Main Content -->
            <div class="col-lg-8">
                
                <!-- Metadata Card -->
                <div class="details-panel-glass shadow-sm mb-4">
                    <div class="row g-4 text-overflow-safe">

                        <div class="col-md-6">
                            <div class="file-meta-key">MÔN HỌC</div>
                            <div class="file-meta-value">@(string.IsNullOrWhiteSpace(Model.ViewModel.SubjectName) ? "—" : $"{Model.ViewModel.SubjectCode} - {Model.ViewModel.SubjectName}")</div>
                        </div>
                        <div class="col-md-6">
                            <div class="file-meta-key">LOẠI HỌC LIỆU</div>
                            <div class="file-meta-value">@(string.IsNullOrWhiteSpace(Model.ViewModel.DocumentTypeName) ? "—" : Model.ViewModel.DocumentTypeName)</div>
                        </div>
                        <div class="col-md-6">
                            <div class="file-meta-key">HỌC KỲ ACADEMIC</div>
                            <div class="file-meta-value">@(string.IsNullOrWhiteSpace(Model.ViewModel.AcademicTermName) ? "—" : Model.ViewModel.AcademicTermName)</div>
                        </div>
                        <div class="col-md-6">
                            <div class="file-meta-key">QUYỀN HIỂN THỊ</div>
                            <div class="file-meta-value text-capitalize">
                                @if (Model.ViewModel.Visibility == "private")
                                {
                                    <span>Riêng Tư</span>
                                }
                                else if (Model.ViewModel.Visibility == "public")
                                {
                                    <span>Công Khai</span>
                                }
                                else if (Model.ViewModel.Visibility == "internal")
                                {
                                    <span>Nội Bộ</span>
                                }
                                else
                                {
                                    <span>@Model.ViewModel.Visibility</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="file-meta-key">NGÔN NGỮ</div>
                            <div class="file-meta-value">@(string.IsNullOrWhiteSpace(Model.ViewModel.LanguageName) ? "—" : Model.ViewModel.LanguageName)</div>
                        </div>
                        <div class="col-md-6">
                            <div class="file-meta-key">NGUỒN TÀI LIỆU</div>
                            <div class="file-meta-value">@(string.IsNullOrWhiteSpace(Model.ViewModel.DocumentSourceName) ? "—" : Model.ViewModel.DocumentSourceName)</div>
                        </div>
                        <div class="col-12 mt-4 pt-3 border-top border-border">
                            <div class="file-meta-key">MÔ TẢ CHI TIẾT</div>
                            <div class="file-meta-value fw-normal text-muted-foreground text-overflow-safe" style="line-height: 1.6; font-size: 0.95rem;">
                                @(string.IsNullOrWhiteSpace(Model.ViewModel.Description) ? "Chưa có mô tả chi tiết." : Model.ViewModel.Description)
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Attached Files Card -->
                <div class="details-panel-glass shadow-sm mb-4 p-0 overflow-hidden">
                    <div class="p-4 border-bottom border-border d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h5 mb-1 text-overflow-safe" style="font-weight: 700; color: var(--brown);">Tệp đã đính kèm</h2>
                            <div class="font-mono-xs text-muted-foreground">Danh sách file gốc gắn với tài liệu</div>
                        </div>

                    </div>
                    
                    @if (!Model.ViewModel.Files.Any())
                    {
                        <div class="p-5 text-center text-muted-foreground">Chưa có tệp đính kèm nào.</div>
                    }
                    else
                    {
                        <div class="p-4">
                            <div class="row g-3">
                                @foreach (var file in Model.ViewModel.Files)
                                {
                                    <div class="col-12">
                                        <div class="item-card-glass d-flex align-items-center justify-content-between gap-3 flex-wrap" style="background: rgba(255, 255, 255, 0.3) !important;">
                                            <div class="d-flex align-items-center gap-3 min-w-0">
                                                <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 42px; height: 42px; background: rgba(216, 106, 88, 0.1); color: var(--coral);">
                                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                                                    </svg>
                                                </div>
                                                <div class="min-w-0">
                                                    <div class="fw-bold text-dark text-truncate text-overflow-safe" style="font-size: 0.92rem;">@file.OriginalFilename</div>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center gap-3 flex-wrap ms-auto">
                                                <div class="font-mono-xs text-muted-foreground fw-semibold">
                                                    @((file.FileSizeBytes / 1024.0 / 1024.0).ToString("0.00")) MB
                                                </div>
                                                @{
                                                    var status = file.ExtractionStatus?.ToLower() ?? "";
                                                    var statusClass = status switch {
                                                        "success" or "completed" => "badge-approved-glass",
                                                        "failed" or "error" => "badge-rejected-glass",
                                                        "pending" or "processing" => "badge-pending-glass",
                                                        _ => "premium-accent-chip"
                                                    };
                                                }
                                                <span class="badge @statusClass rounded-pill" style="font-size: 0.72rem; padding: 4px 10px;">@file.ExtractionStatus</span>
                                                <div class="font-mono-xs text-muted-foreground">@file.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Chapters Card -->
                <div class="details-panel-glass shadow-sm mb-4 p-0 overflow-hidden">
                    <div class="p-4 border-bottom border-border d-flex justify-content-between align-items-center">
                        <div>
                            <div class="kicker mb-1">Mục lục chương</div>
                            <h2 class="h5 mb-1" style="font-weight: 700; color: var(--brown);">Các chương học thuật</h2>
                            <div class="font-mono-xs text-muted-foreground">Phân tích từ AI · @Model.ViewModel.TotalChapters chương</div>
                        </div>

                    </div>

                    @if (!Model.ViewModel.Chapters.Any())
                    {
                        <div class="p-5 text-center text-muted-foreground">Chưa có phân mục chương học thuật.</div>
                    }
                    else
                    {
                        <div class="p-4">
                            <div class="row g-3">
                                @foreach (var chapter in Model.ViewModel.Chapters)
                                {
                                    <div class="col-12 col-xl-6">
                                        <div class="item-card-glass h-100">
                                            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                                <div>
                                                    <div class="font-mono-xs text-muted-foreground fw-bold mb-1">CHƯƠNG @chapter.ChapterOrder</div>
                                                    <h3 class="h6 mb-0 text-overflow-safe text-dark" style="font-size: 0.98rem; font-weight: 700;">@chapter.Title</h3>
                                                </div>
                                                <span class="premium-accent-chip flex-shrink-0">@chapter.ChunkCount chunks</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(chapter.Summary))
                                            {
                                                <p class="text-muted-foreground mb-3 text-overflow-safe" style="font-size: 0.88rem; line-height: 1.5;">@chapter.Summary</p>
                                            }
                                            <div class="d-flex flex-wrap gap-2 align-items-center mt-auto">
                                                <span class="premium-accent-chip" style="background: rgba(82, 39, 27, 0.04) !important; border-color: rgba(82, 39, 27, 0.08) !important; color: var(--muted-foreground) !important;">
                                                    Chunk @chapter.StartChunkIndex → @chapter.EndChunkIndex
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Chunks Card -->
                <div id="chunks-card" class="details-panel-glass shadow-sm p-0 overflow-hidden" style="transition: opacity 0.25s ease;">
                    <div class="p-4 border-bottom border-border d-flex justify-content-between align-items-center gap-3 flex-wrap">
                        <div>
                            <div class="kicker mb-1">Các phân đoạn</div>
                            <h2 class="h5 mb-1" style="font-weight: 700; color: var(--brown);">Đoạn dữ liệu văn bản</h2>
                            <div class="font-mono-xs text-muted-foreground">Trang @Model.ViewModel.ChunkPage / @Model.ViewModel.TotalChunkPages</div>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <a asp-page="/Documents/Details" asp-route-slug="@Model.ViewModel.Slug" asp-route-chunkPage="@Math.Max(1, Model.ViewModel.ChunkPage - 1)" asp-route-chunkPageSize="@Model.ViewModel.ChunkPageSize" class="btn btn-premium-secondary btn-sm pill-button px-3 @(Model.ViewModel.ChunkPage <= 1 ? "disabled" : "")">Trước</a>
                            <a asp-page="/Documents/Details" asp-route-slug="@Model.ViewModel.Slug" asp-route-chunkPage="@Math.Min(Model.ViewModel.TotalChunkPages, Model.ViewModel.ChunkPage + 1)" asp-route-chunkPageSize="@Model.ViewModel.ChunkPageSize" class="btn btn-premium-secondary btn-sm pill-button px-3 @(Model.ViewModel.ChunkPage >= Model.ViewModel.TotalChunkPages ? "disabled" : "")">Sau</a>
                        </div>
                    </div>

                    @if (!Model.ViewModel.Chunks.Any())
                    {
                        <div class="p-5 text-center text-muted-foreground">Chưa có phân đoạn văn bản nào được tải lên.</div>
                    }
                    else
                    {
                        <div class="p-4">
                            <div class="row g-3">
                                @foreach (var chunk in Model.ViewModel.Chunks)
                                {
                                    var previewText = chunk.Content;
                                    if (previewText.Length > 180)
                                    {
                                        previewText = previewText[..180] + "…";
                                    }
                                    <div class="col-12 col-xl-6">
                                        <div class="item-card-glass h-100" style="padding: 16px 20px !important; cursor: pointer;" data-bs-toggle="modal" data-bs-target="#chunkModal-@chunk.ChunkOrder">
                                            <div class="d-flex justify-content-between align-items-start gap-3">
                                                <div class="flex-grow-1 min-w-0">
                                                    <div class="d-flex align-items-center justify-content-between gap-3 mb-2">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="font-mono-xs text-muted-foreground fw-bold">PHÂN ĐOẠN @chunk.ChunkOrder</div>
                                                            @if (chunk.HasEmbedding)
                                                            {
                                                                <span class="badge badge-approved-glass" style="font-size: 0.58rem; padding: 2px 6px; border-radius: 4px; line-height: 1;">INDEXED</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge badge-pending-glass" style="font-size: 0.58rem; padding: 2px 6px; border-radius: 4px; line-height: 1;">NO INDEX</span>
                                                            }
                                                        </div>
                                                        <span class="text-muted-foreground font-mono-xs fw-semibold" style="font-size: 0.72rem; letter-spacing: 0.05em;">#@(chunk.ChunkOrder.ToString("000"))</span>
                                                    </div>
                                                    <div class="fw-bold mb-2 text-dark" style="font-size: 0.88rem; font-family: 'Source Serif 4', Georgia, serif;">@chunk.WordCount từ</div>
                                                    <div class="text-muted-foreground text-overflow-safe" style="word-break: break-word; line-height: 1.5; font-size: 0.85rem; opacity: 0.9;">@previewText</div>
                                                </div>
                                                <svg class="flex-shrink-0 mt-1 text-muted" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
                                                </svg>
                                            </div>
                                        </div>


                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Right Sidebar Panel -->
            <div class="col-lg-4">
                <div class="details-panel-glass shadow-lg sticky-top p-4 p-md-5" style="top: 24px; border: 1px solid rgba(216, 106, 88, 0.15) !important; background: linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.5)) !important;">
                    <div class="font-mono-xs mb-2" style="letter-spacing: 0.1em; font-weight: 800; color: var(--coral);">TÓM LƯỢC</div>
                    <h2 class="h4 mb-4 text-overflow-safe" style="font-weight: 800; color: var(--brown); letter-spacing: -0.02em;">Thông tin nhanh</h2>
                    
                    <div class="d-flex flex-column gap-1 text-overflow-safe">
                        <div class="d-flex justify-content-between align-items-center py-3 border-bottom" style="border-color: rgba(82, 39, 27, 0.08) !important;">
                            <span class="font-mono-xs text-muted-foreground fw-bold" style="font-size: 10px; letter-spacing: 0.08em;">TỔNG SỐ TỆP</span>
                            <strong style="color: var(--brown); font-size: 1.1rem;">@Model.ViewModel.FileCount</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-3 border-bottom" style="border-color: rgba(82, 39, 27, 0.08) !important;">
                            <span class="font-mono-xs text-muted-foreground fw-bold" style="font-size: 10px; letter-spacing: 0.08em;">TỔNG PHÂN ĐOẠN</span>
                            <strong style="color: var(--brown); font-size: 1.1rem;">@Model.ViewModel.TotalChunks</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-3 border-bottom" style="border-color: rgba(82, 39, 27, 0.08) !important;">
                            <span class="font-mono-xs text-muted-foreground fw-bold" style="font-size: 10px; letter-spacing: 0.08em;">TỔNG SỐ CHƯƠNG</span>
                            <strong style="color: var(--brown); font-size: 1.1rem;">@Model.ViewModel.TotalChapters</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-3">
                            <span class="font-mono-xs text-muted-foreground fw-bold" style="font-size: 10px; letter-spacing: 0.08em;">LƯỢT XEM</span>
                            <strong style="color: var(--brown); font-size: 1.1rem;">@Model.ViewModel.ViewCount</strong>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</div>

<!-- Report Modal -->
<div class="modal fade" id="reportModal" tabindex="-1" aria-labelledby="reportModalLabel" aria-hidden="true" style="backdrop-filter: blur(8px); background: rgba(139, 0, 0, 0.05);">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
        <div class="modal-content border-0 shadow-lg" style="background: var(--card); border-radius: 24px; color: var(--foreground); overflow: hidden;">
            <div class="modal-header border-0 p-4 pb-0 d-flex justify-content-between align-items-center">
                <h5 class="modal-title fw-bold" id="reportModalLabel" style="font-size: 1.25rem; color: #8b0000;">Báo Cáo Tài Liệu Vi Phạm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="background-color: rgba(0, 0, 0, 0.05); padding: 0.75rem; border-radius: 50%;"></button>
            </div>
            <form asp-page-handler="Report" asp-route-slug="@Model.ViewModel.Slug" method="post">
                <div class="modal-body p-4">
                    <p class="text-muted-foreground small mb-4" style="line-height: 1.5;">
                        Nếu bạn phát hiện tài liệu này có nội dung sai lệch, vi phạm bản quyền hoặc không phù hợp, vui lòng gửi báo cáo cho Ban quản trị xử lý.
                    </p>
                    <div class="mb-3">
                        <label for="reportReason" class="form-label small fw-semibold text-muted-foreground">Lý do báo cáo</label>
                        <textarea class="form-control pill-input px-3 py-2.5" id="reportReason" name="reason" placeholder="Nhập lý do chi tiết..." rows="4" required style="border-color: rgba(139, 0, 0, 0.15); border-radius: 12px; resize: none;"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-premium-secondary pill-button px-4 py-2" data-bs-dismiss="modal" style="font-size: 0.85rem; border-color: rgba(0,0,0,0.15); border-radius: 100px;">Hủy</button>
                    <button type="submit" class="btn btn-danger pill-button px-4 py-2" style="font-size: 0.85rem; background-color: #8b0000; border: none; box-shadow: 0 4px 12px rgba(139, 0, 0, 0.2); border-radius: 100px; color: white;">Gửi Báo Cáo</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Chunk Modals -->
@if (Model.ViewModel.Chunks.Any())
{
    foreach (var chunk in Model.ViewModel.Chunks)
    {
        <div class="modal fade" id="chunkModal-@chunk.ChunkOrder" tabindex="-1" aria-hidden="true" style="backdrop-filter: blur(8px); background: rgba(82, 39, 27, 0.05);">
            <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
                <div class="modal-content border-0 shadow-lg" style="background: var(--card); border-radius: 24px; color: var(--foreground); overflow: hidden;">
                    <div class="modal-header border-0 p-4 pb-0 d-flex justify-content-between align-items-center">
                        <h5 class="modal-title fw-bold" style="font-size: 1.25rem; color: var(--brown);">Nội dung phân đoạn @chunk.ChunkOrder</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="background-color: rgba(0, 0, 0, 0.05); padding: 0.75rem; border-radius: 50%;"></button>
                    </div>
                    <div class="modal-body p-4 text-overflow-safe text-dark" style="font-family: 'Source Serif 4', Georgia, serif; font-size: 1rem; white-space: pre-wrap; line-height: 1.7;">@chunk.Content</div>
                    <div class="modal-footer border-0 p-4 pt-0 d-flex justify-content-between align-items-center">
                        <div class="font-mono-xs text-muted-foreground">@chunk.WordCount từ vựng</div>
                        <button type="button" class="btn btn-premium-secondary pill-button px-4 py-2" data-bs-dismiss="modal" style="font-size: 0.85rem; border-color: rgba(0,0,0,0.15); border-radius: 100px;">Đóng</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        (() => {
            function bindAccordionRotate(container) {
                container.querySelectorAll('details').forEach(det => {
                    const icon = det.querySelector('.chevron-icon');
                    if (!icon) return;
                    det.addEventListener('toggle', () => {
                        if (det.open) {
                            icon.style.transform = 'rotate(180deg)';
                            icon.style.color = 'var(--coral)';
                        } else {
                            icon.style.transform = 'rotate(0deg)';
                            icon.style.color = '';
                        }
                    });
                });
            }

            // Initial binding for accordion details elements
            const chunksCard = document.getElementById('chunks-card');
            if (chunksCard) {
                bindAccordionRotate(chunksCard);

                // AJAX pagination logic
                chunksCard.addEventListener('click', async (e) => {
                    const link = e.target.closest('a');
                    if (link && (link.textContent.trim() === 'Trước' || link.textContent.trim() === 'Sau')) {
                        if (link.classList.contains('disabled')) {
                            e.preventDefault();
                            return;
                        }
                        e.preventDefault();
                        const href = link.getAttribute('href');
                        if (!href) return;

                        try {
                            // Fade out transition
                            chunksCard.style.opacity = '0.5';
                            chunksCard.style.pointerEvents = 'none';

                            const response = await fetch(href);
                            if (!response.ok) throw new Error('Failed to fetch data.');

                            const htmlText = await response.text();
                            const parser = new DOMParser();
                            const doc = parser.parseFromString(htmlText, 'text/html');
                            const newChunksCard = doc.getElementById('chunks-card');

                            if (newChunksCard) {
                                // Replace content dynamically
                                chunksCard.innerHTML = newChunksCard.innerHTML;
                                
                                // Update URL without refreshing the whole page
                                window.history.pushState(null, '', href);

                                // Re-bind accordion events on the new HTML elements
                                bindAccordionRotate(chunksCard);
                            }
                        } catch (err) {
                            console.error('AJAX Pagination error, falling back to full refresh:', err);
                            window.location.href = href;
                        } finally {
                            // Fade back in
                            chunksCard.style.opacity = '1';
                            chunksCard.style.pointerEvents = 'auto';
                        }
                    }
                });
            }
        })();
    </script>

    <script>
        // SignalR: Real-time document deletion guard
        (() => {
            const currentDocumentId = '@Model.ViewModel.Id';

            function setupDocumentDeletedListener() {
                const connection = window.signalrConnection;
                if (!connection) { setTimeout(setupDocumentDeletedListener, 100); return; }

                connection.on('ReceiveDocumentDeleted', (payload) => {
                    const deletedId = (payload.documentId || '').toLowerCase();
                    const currentId = (currentDocumentId || '').toLowerCase();
                    if (deletedId !== currentId) return;

                    showPremiumToast(`Tài liệu "${payload.title || 'này'}" đã bị Admin xóa khỏi hệ thống. Đang chuyển hướng...`, 'danger');
                    setTimeout(() => { window.location.href = '/Documents/All'; }, 3000);
                });
            }

            setupDocumentDeletedListener();
        })();
    </script>
}

