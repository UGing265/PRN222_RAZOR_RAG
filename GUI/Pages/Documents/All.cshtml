@page "/documents/all"
@model GUI.Pages.Documents.AllModel
@{
    ViewData["Title"] = "Khám Phá Tài Liệu";
    var query = Model.Q ?? "";
    var selectedSubjectId = Model.SubjectId;
    var selectedTermId = Model.TermId;
    
    var allTerms = Model.AcademicTerms;
    var allSubjects = Model.Subjects;
    
    var selectedTerm = allTerms.FirstOrDefault(t => t.Id == selectedTermId);
    var selectedSubject = allSubjects.FirstOrDefault(s => s.Id == selectedSubjectId);
    
    var selectedTypeId = Model.DocumentTypeId;
    var selectedLangId = Model.LanguageId;
    var selectedSourceId = Model.DocumentSourceId;

    var allTypes = Model.DocumentTypes;
    var allLangs = Model.Languages;
    var allSources = Model.DocumentSources;
    
    bool isSearchMode = !string.IsNullOrEmpty(query);
    bool isSubjectMode = selectedSubjectId.HasValue;
    bool isTermMode = selectedTermId.HasValue && !isSubjectMode && !isSearchMode;
    bool isRootMode = !selectedTermId.HasValue && !isSubjectMode && !isSearchMode;
}

<style>
    /* New Explore Flow Styles */
    .breadcrumb-glass {
        background: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 16px;
        padding: 12px 24px;
        border: 1px solid rgba(82, 39, 27, 0.08);
        box-shadow: 0 4px 15px rgba(74, 31, 22, 0.03);
    }
    
    .breadcrumb-glass a {
        color: var(--brown);
        text-decoration: none;
        transition: color 0.2s ease;
    }
    .breadcrumb-glass a:hover {
        color: var(--coral);
    }
    .breadcrumb-item + .breadcrumb-item::before {
        content: "›";
        color: rgba(82, 39, 27, 0.4);
        font-size: 1.2rem;
        line-height: 1;
        padding: 0 8px;
    }

    .term-card, .subject-card {
        background: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 24px;
        padding: 32px 24px;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        cursor: pointer;
        text-align: center;
        box-shadow: 0 10px 30px rgba(74, 31, 22, 0.04);
        text-decoration: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        color: var(--foreground);
    }
    
    .term-card:hover, .subject-card:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 20px 45px rgba(216, 106, 88, 0.12);
        border-color: rgba(216, 106, 88, 0.25);
        color: var(--brown);
    }

    .term-icon-wrapper {
        background: rgba(216, 106, 88, 0.08);
        width: 72px;
        height: 72px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        transition: all 0.3s ease;
    }
    .term-card:hover .term-icon-wrapper {
        background: var(--coral);
        transform: rotate(-5deg);
    }
    .term-card:hover .term-icon-wrapper svg {
        stroke: white;
    }

    /* Existing Explore Styles */
    .search-glass-container {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 10px 40px rgba(74, 31, 22, 0.06);
        transition: all 0.3s ease;
        position: relative;
        z-index: 1000;
    }
    .search-glass-container:focus-within {
        box-shadow: 0 15px 50px rgba(216, 106, 88, 0.15);
        border-color: rgba(216, 106, 88, 0.3);
        transform: translateY(-2px);
    }
    
    .explore-card {
        background: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 24px;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 10px 30px rgba(74, 31, 22, 0.04);
    }
    .explore-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(216, 106, 88, 0.12);
        border-color: rgba(216, 106, 88, 0.2);
    }
    
    .subject-badge {
        background: rgba(216, 106, 88, 0.1);
        color: var(--coral);
        padding: 6px 14px;
        border-radius: 100px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        border: 1px solid rgba(216, 106, 88, 0.15);
        font-family: var(--font-mono);
    }

    .card-footer-action {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 16px;
        border-top: 1px solid rgba(82, 39, 27, 0.05);
        margin-top: 12px;
    }

    .read-doc-btn {
        background: var(--brown);
        color: white !important;
        border: none;
        padding: 8px 20px;
        border-radius: 100px;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.3s ease;
        text-decoration: none;
        box-shadow: 0 4px 12px rgba(74, 31, 22, 0.2);
    }
    .read-doc-btn:hover {
        background: var(--coral);
        transform: translateX(4px);
        box-shadow: 0 6px 18px rgba(216, 106, 88, 0.3);
    }

    .author-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.8rem;
        color: var(--foreground);
        font-weight: 600;
        font-family: var(--font-mono);
    }
    .author-avatar {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: rgba(82, 39, 27, 0.1);
        color: var(--brown);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        border: 1px solid rgba(82, 39, 27, 0.15);
    }
    .dropdown-item.active, .dropdown-item:active {
        background-color: rgba(216, 106, 88, 0.1) !important;
        color: var(--coral) !important;
        font-weight: 600;
    }
</style>

<div class="page-shell">
    <div class="container-fluid px-4 px-md-5 py-5" style="max-width: 1400px;">
        
        <!-- Header & Breadcrumbs -->
        <div class="mb-5">
            <h1 class="hero-title mb-4" style="font-size: clamp(2.5rem, 5vw, 3.5rem);">Khám Phá</h1>
            
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb breadcrumb-glass d-inline-flex mb-0 font-mono-xs align-items-center">
                    <li class="breadcrumb-item"><a href="?">Tất Cả Học Kỳ</a></li>
                    @if (selectedTerm != null || isSubjectMode || isSearchMode)
                    {
                        if (isSearchMode && !selectedTermId.HasValue && !selectedSubjectId.HasValue)
                        {
                            <li class="breadcrumb-item active text-muted">Kết quả tìm kiếm: "@query"</li>
                        }
                        else if (selectedTerm != null)
                        {
                            if (isSubjectMode)
                            {
                                <li class="breadcrumb-item"><a href="?termId=@selectedTerm.Id">@selectedTerm.Name</a></li>
                            }
                            else
                            {
                                <li class="breadcrumb-item active text-muted">@selectedTerm.Name</li>
                            }
                        }
                    }
                    @if (selectedSubject != null)
                    {
                        <li class="breadcrumb-item active text-muted">@selectedSubject.Code</li>
                    }
                </ol>
            </nav>
        </div>

        @if (isRootMode)
        {
            <!-- ========================= -->
            <!-- STATE 1: ACADEMIC TERMS   -->
            <!-- ========================= -->
            <div class="row g-4">
                @foreach (var term in allTerms.OrderBy(t => t.Order))
                {
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <a href="?termId=@term.Id" class="term-card h-100">
                            <div class="term-icon-wrapper">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--coral)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
                                </svg>
                            </div>
                            <h4 class="fw-bold mb-2">@term.Name</h4>
                            <span class="text-muted-foreground small font-mono-xs" style="opacity: 0.8;">
                                @allSubjects.Count(s => s.AcademicTermId == term.Id) môn học
                            </span>
                        </a>
                    </div>
                }
            </div>
        }
        else if (isTermMode)
        {
            <!-- ========================= -->
            <!-- STATE 2: SUBJECTS LIST    -->
            <!-- ========================= -->
            var termSubjects = allSubjects.Where(s => s.AcademicTermId == selectedTermId).ToList();
            if (!termSubjects.Any())
            {
                <div class="text-center py-5 rounded-4" style="background: rgba(255,255,255,0.3); border: 1px dashed rgba(82, 39, 27, 0.12);">
                    <p class="text-muted-foreground mb-4">Học kỳ này chưa có môn học nào.</p>
                    <a href="?" class="btn btn-dark pill-button px-4 py-2 font-mono-xs text-white" style="background: var(--brown); border: none;">Quay Lại Học Kỳ</a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var sub in termSubjects)
                    {
                        <div class="col-sm-6 col-md-4 col-lg-3">
                            <a href="?subjectId=@sub.Id&termId=@selectedTermId" class="subject-card h-100 px-4">
                                <h3 class="fw-bold mb-3" style="color: var(--brown);">@sub.Code</h3>
                                <p class="text-muted-foreground small mb-0" style="line-height: 1.4;">@sub.Name</p>
                            </a>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <!-- ========================= -->
            <!-- STATE 3: DOCUMENTS & DOCS -->
            <!-- ========================= -->
            
            <!-- Search & Filter Form -->
            <form method="get" asp-page="/Documents/All" class="mb-5">
                <input type="hidden" name="termId" value="@selectedTermId" />
                <div class="search-glass-container p-3 d-flex flex-column gap-3">
                    
                    <!-- ROW 1: Search Input & Search Button -->
                    <div class="d-flex flex-wrap gap-3 align-items-center justify-content-between">
                        <!-- Search Input -->
                        <div class="d-flex flex-grow-1 align-items-center px-3 gap-3 search-glass-container" style="min-width: 250px; background: rgba(255,255,255,0.4) !important; border-radius: 14px; box-shadow: none; border: 1px solid rgba(82, 39, 27, 0.04) !important;">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-muted-foreground"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                            <input type="text" name="q" value="@query" placeholder="Tìm Kiếm Tài Liệu..." class="form-control border-0 bg-transparent shadow-none px-0" style="font-size: 1.05rem; min-height: 44px;">
                        </div>
                        
                        <button type="submit" class="btn btn-premium-primary pill-button px-5 py-2.5 font-mono-xs text-white flex-shrink-0" style="min-width: 120px; font-size: 0.85rem;">
                            TÌM KIẾM
                        </button>
                    </div>
                    
                    <!-- ROW 2: Structured Filters (Subject, Type, Language, Source, Sort) -->
                    <div class="d-flex flex-wrap gap-3 align-items-center">
                        <!-- 1. Subject Select -->
                        <div style="min-width: 160px; flex: 1;">
                            @if (selectedTermId.HasValue)
                            {
                                <select name="subjectId" class="form-select form-glass-select" onchange="this.form.submit()">
                                    <option value="">Tất Cả Môn Học</option>
                                    @foreach (var subject in allSubjects.Where(s => s.AcademicTermId == selectedTermId))
                                    {
                                        if (selectedSubjectId.HasValue && selectedSubjectId.Value == subject.Id)
                                        {
                                            <option value="@subject.Id" selected>@subject.Code</option>
                                        }
                                        else
                                        {
                                            <option value="@subject.Id">@subject.Code</option>
                                        }
                                    }
                                </select>
                            }
                            else
                            {
                                <select name="subjectId" class="form-select form-glass-select" onchange="this.form.submit()">
                                    <option value="">Tất Cả Môn Học</option>
                                    @foreach (var subject in allSubjects)
                                    {
                                        if (selectedSubjectId.HasValue && selectedSubjectId.Value == subject.Id)
                                        {
                                            <option value="@subject.Id" selected>@subject.Code</option>
                                        }
                                        else
                                        {
                                            <option value="@subject.Id">@subject.Code</option>
                                        }
                                    }
                                </select>
                            }
                        </div>
                        
                        <!-- 2. Document Type Select -->
                        <div style="min-width: 160px; flex: 1;">
                            <select name="documentTypeId" class="form-select form-glass-select" onchange="this.form.submit()">
                                <option value="">Tất Cả Học Liệu</option>
                                @foreach (var type in allTypes)
                                {
                                    if (selectedTypeId.HasValue && selectedTypeId.Value == type.Id)
                                    {
                                        <option value="@type.Id" selected>@type.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@type.Id">@type.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- 3. Language Select -->
                        <div style="min-width: 140px; flex: 1;">
                            <select name="languageId" class="form-select form-glass-select" onchange="this.form.submit()">
                                <option value="">Tất Cả Ngôn Ngữ</option>
                                @foreach (var lang in allLangs)
                                {
                                    if (selectedLangId.HasValue && selectedLangId.Value == lang.Id)
                                    {
                                        <option value="@lang.Id" selected>@lang.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@lang.Id">@lang.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- 4. Document Source Select -->
                        <div style="min-width: 150px; flex: 1;">
                            <select name="documentSourceId" class="form-select form-glass-select" onchange="this.form.submit()">
                                <option value="">Tất Cả Nguồn</option>
                                @foreach (var src in allSources)
                                {
                                    if (selectedSourceId.HasValue && selectedSourceId.Value == src.Id)
                                    {
                                        <option value="@src.Id" selected>@src.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@src.Id">@src.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- 5. Sort Dropdown -->
                        <div style="min-width: 160px; flex: 1;">
                            <select name="sortBy" class="form-select form-glass-select" onchange="this.form.submit()">
                                @{
                                    var sortOptions = new Dictionary<string, string>
                                    {
                                        { "date_desc", "Ngày Đăng ↓" },
                                        { "date_asc", "Ngày Đăng ↑" },
                                        { "title_asc", "A - Z ↑" },
                                        { "title_desc", "Z - A ↓" },
                                        { "views_desc", "Lượt Xem ↓" },
                                        { "views_asc", "Lượt Xem ↑" }
                                    };
                                    
                                    string currentSort = Model.SortBy ?? "date_desc";
                                    if (currentSort == "date") currentSort = "date_desc";
                                    if (currentSort == "title") currentSort = "title_asc";
                                    if (currentSort == "views") currentSort = "views_desc";

                                    foreach (var opt in sortOptions)
                                    {
                                        if (currentSort == opt.Key)
                                        {
                                            <option value="@opt.Key" selected>@opt.Value</option>
                                        }
                                        else
                                        {
                                            <option value="@opt.Key">@opt.Value</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </form>

            <!-- Document List Header -->
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h4 class="mb-0 fw-bold" style="color: var(--brown);">Danh Sách Tài Liệu</h4>
                <span class="font-mono-xs text-muted-foreground" style="font-size: 11px; background: rgba(255,255,255,0.6); padding: 6px 14px; border-radius: 99px; border: 1px solid rgba(0,0,0,0.05);">
                    Tìm thấy <strong style="color: var(--coral);">@Model.ViewModel.TotalDocuments</strong> kết quả
                </span>
            </div>

            <!-- Documents Grid -->
            @if (Model.ViewModel.Documents.Count == 0)
            {
                <div class="text-center py-5 rounded-4" style="background: rgba(255,255,255,0.3); border: 1px dashed rgba(82, 39, 27, 0.12);">
                    <div class="mb-3 text-muted-foreground">
                        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/>
                        </svg>
                    </div>
                    <h5 class="fw-semibold text-dark">Không tìm thấy tài liệu phù hợp</h5>
                    <p class="text-muted-foreground small">Vui lòng thử từ khóa khác hoặc xóa lọc để xem toàn bộ danh mục.</p>
                    <a href="?" class="btn btn-outline-dark btn-sm pill-button px-4 py-2 mt-2">Xem Tất Cả</a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var item in Model.ViewModel.Documents)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="explore-card h-100 p-4">
                                <div>
                                    <!-- Top Badges -->
                                    <div class="d-flex align-items-center justify-content-between gap-2 mb-3 flex-wrap">
                                        <div class="d-flex align-items-center gap-3 flex-wrap">
                                            <span class="subject-badge">
                                                @(string.IsNullOrWhiteSpace(item.SubjectCode) ? (string.IsNullOrWhiteSpace(item.SubjectName) ? "Tài liệu" : item.SubjectName) : item.SubjectCode)
                                            </span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2 font-mono-xs text-muted-foreground" style="font-size: 10px;">
                                            <span>@item.UpdatedAt.ToString("dd/MM/yyyy")</span>
                                            <span>•</span>
                                            <span class="d-inline-flex align-items-center gap-1" title="Lượt xem">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.8;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                                @item.ViewCount
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Title -->
                                    <h4 class="fw-bold mb-2 text-truncate-2" style="font-size: 1.15rem; color: var(--brown); line-height: 1.4; min-height: 3.2rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-wrap: break-word; word-break: break-word;" title="@item.Title">
                                        @item.Title
                                    </h4>

                                    <!-- Excerpt -->
                                    <p class="text-muted-foreground small mb-4 text-truncate-3" style="line-height: 1.6; min-height: 4.8rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; word-wrap: break-word; word-break: break-word;">
                                        @(string.IsNullOrWhiteSpace(item.PreviewText) ? "Bản xem trước tài liệu hiện chưa khả dụng. Nhấp mở để xem chi tiết nội dung." : item.PreviewText)
                                    </p>
                                </div>

                                <!-- Footer -->
                                <div class="card-footer-action">
                                    <div class="author-badge">
                                        <div class="author-avatar">
                                            @((string.IsNullOrWhiteSpace(item.OwnerEmail) ? "U" : item.OwnerEmail.Substring(0, 1)).ToUpper())
                                        </div>
                                        <span class="text-truncate" style="max-width: 120px;" title="@item.OwnerEmail">
                                            @(string.IsNullOrWhiteSpace(item.OwnerEmail) ? "Anonymous" : item.OwnerEmail.Split('@')[0])
                                        </span>
                                    </div>

                                    <a asp-page="/Documents/Details" asp-route-slug="@item.Slug" class="read-doc-btn">
                                        <span>Đọc ngay</span>
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.ViewModel.TotalPages > 1)
                {
                    <nav class="d-flex justify-content-center mt-5">
                        <ul class="pagination gap-2 border-0">
                            <li class="page-item @(Model.ViewModel.Page == 1 ? "disabled" : "")">
                                <a class="page-link pill-button px-3 py-2 border-0" href="?q=@(query)&termId=@(selectedTermId)&subjectId=@(selectedSubjectId)&documentTypeId=@(selectedTypeId)&languageId=@(selectedLangId)&documentSourceId=@(selectedSourceId)&sortBy=@(Model.SortBy)&page=@(Model.ViewModel.Page - 1)" style="border-radius: 12px; color: var(--brown); background: rgba(255,255,255,0.4); font-size: 0.85rem;">
                                    Trước
                                </a>
                            </li>
                            @for (int i = 1; i <= Model.ViewModel.TotalPages; i++)
                            {
                                <li class="page-item @(Model.ViewModel.Page == i ? "active" : "")">
                                    <a class="page-link pill-button px-3.5 py-2 border-0" href="?q=@(query)&termId=@(selectedTermId)&subjectId=@(selectedSubjectId)&documentTypeId=@(selectedTypeId)&languageId=@(selectedLangId)&documentSourceId=@(selectedSourceId)&sortBy=@(Model.SortBy)&page=@i" 
                                       style="border-radius: 12px; font-size: 0.85rem; font-weight: 600; @(Model.ViewModel.Page == i ? "background: var(--brown) !important; color: #fff !important;" : "color: var(--brown); background: rgba(255,255,255,0.4);")">
                                        @i
                                    </a>
                                </li>
                            }
                            <li class="page-item @(Model.ViewModel.Page == Model.ViewModel.TotalPages ? "disabled" : "")">
                                <a class="page-link pill-button px-3 py-2 border-0" href="?q=@(query)&termId=@(selectedTermId)&subjectId=@(selectedSubjectId)&documentTypeId=@(selectedTypeId)&languageId=@(selectedLangId)&documentSourceId=@(selectedSourceId)&sortBy=@(Model.SortBy)&page=@(Model.ViewModel.Page + 1)" style="border-radius: 12px; color: var(--brown); background: rgba(255,255,255,0.4); font-size: 0.85rem;">
                                    Sau
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        function toggleSort(base) {
            let current = document.getElementById('sortByInput').value;
            let nextSort = base + '_desc'; 
            
            if (base === 'title') {
                if (current === 'title_asc' || current === 'title') nextSort = 'title_desc';
                else nextSort = 'title_asc';
            } else if (base === 'date') {
                if (current === 'date_desc' || current === 'date' || current === '') nextSort = 'date_asc';
                else nextSort = 'date_desc';
            } else if (base === 'views') {
                if (current === 'views_desc' || current === 'views') nextSort = 'views_asc';
                else nextSort = 'views_desc';
            }
            
            document.getElementById('sortByInput').value = nextSort;
            document.getElementById('sortByInput').form.submit();
        }
    </script>
}
