@page "/upload"
@model GUI.Pages.Documents.CreateModel
@{
    ViewData["Title"] = "Tải lên tài liệu";
}

<style>
    /* Premium Upload Form Glassmorphism Styling */
    .upload-card-glass {
        background: rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(82, 39, 27, 0.06);
        border-radius: 24px;
        padding: 32px;
        transition: all 0.3s ease;
    }

    .upload-dropzone-glass {
        background: rgba(255, 255, 255, 0.45);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 2px dashed rgba(216, 106, 88, 0.25);
        border-radius: 22px;
        padding: 42px 24px;
        transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        cursor: pointer;
        outline: none;
    }

    .upload-dropzone-glass:hover, .upload-dropzone-glass:focus {
        background: rgba(255, 255, 255, 0.8);
        border-color: var(--coral);
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(82, 39, 27, 0.04);
    }

    .form-glass-input {
        background: rgba(255, 255, 255, 0.65) !important;
        backdrop-filter: blur(8px) !important;
        border: 1px solid rgba(82, 39, 27, 0.08) !important;
        border-radius: 14px !important;
        padding: 12px 16px !important;
        font-size: 0.92rem !important;
        color: var(--foreground) !important;
        transition: all 0.25s ease !important;
        box-shadow: none !important;
    }

    .form-glass-input:focus {
        background: rgba(255, 255, 255, 0.95) !important;
        border-color: var(--coral) !important;
        box-shadow: 0 6px 18px rgba(216, 106, 88, 0.06) !important;
    }

    .form-glass-select {
        background: rgba(255, 255, 255, 0.65) !important;
        backdrop-filter: blur(8px) !important;
        border: 1px solid rgba(82, 39, 27, 0.08) !important;
        border-radius: 14px !important;
        padding: 12px 16px !important;
        font-size: 0.92rem !important;
        color: var(--foreground) !important;
        transition: all 0.25s ease !important;
        box-shadow: none !important;
        height: auto !important;
    }

    .form-glass-select:focus {
        background: rgba(255, 255, 255, 0.95) !important;
        border-color: var(--coral) !important;
        box-shadow: 0 6px 18px rgba(216, 106, 88, 0.06) !important;
    }

    /* Premium Interactive Visibility Selection Cards */
    .visibility-option-card {
        background: rgba(255, 255, 255, 0.45);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1.5px solid rgba(82, 39, 27, 0.08);
        border-radius: 18px;
        padding: 18px 20px;
        cursor: pointer;
        transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        align-items: center;
        gap: 16px;
        position: relative;
        overflow: hidden;
        user-select: none;
    }

    .visibility-option-card:hover {
        background: rgba(255, 255, 255, 0.75);
        border-color: rgba(216, 106, 88, 0.3);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(82, 39, 27, 0.04);
    }

    .visibility-option-card.active {
        background: rgba(255, 255, 255, 0.95);
        border-color: var(--coral);
        box-shadow: 0 10px 25px rgba(216, 106, 88, 0.08);
    }

    .visibility-option-card.active::after {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 0;
        height: 0;
        border-style: solid;
        border-width: 0 24px 24px 0;
        border-color: transparent var(--coral) transparent transparent;
    }

    .visibility-option-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: rgba(216, 106, 88, 0.08);
        color: var(--coral);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: all 0.3s ease;
    }

    .visibility-option-card.active .visibility-option-icon {
        background: var(--coral);
        color: #ffffff;
    }

    .visibility-option-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--brown);
        margin-bottom: 3px;
    }

    .visibility-option-desc {
        font-size: 0.78rem;
        color: var(--muted-foreground);
        line-height: 1.3;
    }

    .progress-glass {
        background: rgba(255, 255, 255, 0.45);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(82, 39, 27, 0.06);
        border-radius: 20px;
        padding: 20px;
    }
</style>

<div class="page-shell grain">
    <div class="container-fluid px-4 px-md-5 py-4 py-md-5" style="max-width: 900px;">
        
        <!-- Header -->
        <div class="d-flex align-items-center justify-content-between mb-5 flex-wrap gap-3">
            <div>
                <span class="font-mono-xs text-coral-deep" style="font-weight: 700; letter-spacing: 0.15em;">KHÔNG GIAN LÀM VIỆC</span>
                <h1 class="hero-title mt-2 mb-0" style="font-size: clamp(2.2rem, 5vw, 3.2rem); color: var(--brown); line-height: 1.1;">Tải Lên Tài Liệu</h1>
            </div>
            <div>
                <a asp-page="/Documents/Mine" class="btn btn-outline-dark pill-button px-4 py-2 d-inline-flex align-items-center gap-2" style="font-size: 0.88rem;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                    </svg>
                    Quay Lại Thư Viện
                </a>
            </div>
        </div>

        <div class="upload-card-glass shadow-sm">
            <form method="post" enctype="multipart/form-data" id="uploadForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 rounded-3 mb-4"></div>

                <!-- Dropzone Area -->
                <div class="upload-dropzone-glass mb-4 text-center" id="uploadDropzone" role="button" tabindex="0">
                    <div class="d-flex justify-content-center mb-3">
                        <div class="d-flex align-items-center justify-content-center rounded-circle text-white shadow-sm" 
                             style="width: 64px; height: 64px; background: linear-gradient(135deg, var(--brown) 0%, var(--coral) 100%);">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
                            </svg>
                        </div>
                    </div>
                    <h2 class="h5 fw-bold mb-1" style="color: var(--brown);">Kéo thả tập tin của bạn vào đây</h2>
                    <p class="text-muted-foreground mb-3 small" style="font-weight: 500;">Hỗ trợ định dạng PDF, DOC, DOCX, PPT, PPTX</p>
                    <input asp-for="Input.UploadFile" type="file" class="d-none" id="uploadFileInput" accept=".pdf,.doc,.docx,.ppt,.pptx" />
                    
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-2 bg-light border rounded-3 font-mono-xs text-muted-foreground" id="selectedFileName" style="font-size: 0.78rem;">
                        Chưa chọn tệp nào
                    </div>
                </div>
                <span asp-validation-for="Input.UploadFile" class="text-danger small d-block mb-4"></span>

                <!-- Form Inputs -->
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Input.Title" class="form-label font-mono-xs text-muted-foreground mb-1" style="font-size: 9px; letter-spacing: 0.08em;">TIÊU ĐỀ TÀI LIỆU</label>
                        <input asp-for="Input.Title" id="Title" class="form-control form-glass-input" placeholder="Nhập tiêu đề tài liệu rõ ràng..." />
                        <span asp-validation-for="Input.Title" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.SubjectId" class="form-label font-mono-xs text-muted-foreground mb-1" style="font-size: 9px; letter-spacing: 0.08em;">MÔN HỌC</label>
                        <select asp-for="Input.SubjectId" id="SubjectId" class="form-select form-glass-select" asp-items="@(new SelectList(Model.Subjects, "Id", "Code"))">
                            <option value="">Chọn Môn Học</option>
                        </select>
                        <span asp-validation-for="Input.SubjectId" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <label asp-for="Input.DocumentTypeId" class="form-label font-mono-xs text-muted-foreground mb-1" style="font-size: 9px; letter-spacing: 0.08em;">LOẠI HỌC LIỆU</label>
                        <select asp-for="Input.DocumentTypeId" id="DocumentTypeId" class="form-select form-glass-select" asp-items="@(new SelectList(Model.DocumentTypes, "Id", "Name"))">
                            <option value="">Chọn Loại Học Liệu</option>
                        </select>
                        <span asp-validation-for="Input.DocumentTypeId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.AcademicTermId" class="form-label font-mono-xs text-muted-foreground mb-1" style="font-size: 9px; letter-spacing: 0.08em;">HỌC KỲ</label>
                        <select asp-for="Input.AcademicTermId" id="AcademicTermId" class="form-select form-glass-select" asp-items="@(new SelectList(Model.AcademicTerms, "Id", "Name"))">
                            <option value="">Chọn Học Kỳ</option>
                        </select>
                        <span asp-validation-for="Input.AcademicTermId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.LanguageId" class="form-label font-mono-xs text-muted-foreground mb-1" style="font-size: 9px; letter-spacing: 0.08em;">NGÔN NGỮ</label>
                        <select asp-for="Input.LanguageId" id="LanguageId" class="form-select form-glass-select" asp-items="@(new SelectList(Model.Languages, "Id", "Name"))">
                            <option value="">Chọn Ngôn Ngữ</option>
                        </select>
                        <span asp-validation-for="Input.LanguageId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.DocumentSourceId" class="form-label font-mono-xs text-muted-foreground mb-1" style="font-size: 9px; letter-spacing: 0.08em;">NGUỒN TÀI LIỆU</label>
                        <select asp-for="Input.DocumentSourceId" id="DocumentSourceId" class="form-select form-glass-select" asp-items="@(new SelectList(Model.DocumentSources, "Id", "Name"))">
                            <option value="">-- Chọn nguồn (tuỳ chọn) --</option>
                        </select>
                        <span asp-validation-for="Input.DocumentSourceId" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-12 my-3">
                        <label class="form-label font-mono-xs text-muted-foreground mb-2" style="font-size: 9px; letter-spacing: 0.08em;">QUYỀN RIÊNG TƯ</label>
                        <input type="hidden" asp-for="Input.Visibility" id="visibilityInput" value="private" />
                        
                        <div class="row g-3">
                            <!-- Private Card -->
                            <div class="col-md-4">
                                <div class="visibility-option-card active" data-value="private" tabindex="0">
                                    <div>
                                        <div class="visibility-option-title">Riêng Tư</div>
                                        <div class="visibility-option-desc">Chỉ mình bạn có thể xem và trò chuyện.</div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Public Card -->
                            <div class="col-md-4">
                                <div class="visibility-option-card" data-value="public" tabindex="0">
                                    <div>
                                        <div class="visibility-option-title">Công Khai</div>
                                        <div class="visibility-option-desc">Mọi thành viên đều có thể xem và tham khảo.</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Internal Card -->
                            <div class="col-md-4">
                                <div class="visibility-option-card" data-value="internal" tabindex="0">
                                    <div>
                                        <div class="visibility-option-title">Nội Bộ</div>
                                        <div class="visibility-option-desc">Chỉ chia sẻ nội bộ giảng viên và quản trị viên.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <span asp-validation-for="Input.Visibility" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Input.Description" class="form-label font-mono-xs text-muted-foreground mb-1" style="font-size: 9px; letter-spacing: 0.08em;">MÔ TẢ NGẮN</label>
                        <input asp-for="Input.Description" id="Description" class="form-control form-glass-input" placeholder="Nhập tóm tắt mô tả ngắn gọn về tài liệu này..." />
                        <span asp-validation-for="Input.Description" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Submit Button and Progress -->
                <div class="d-flex align-items-center gap-2 mt-5">
                    <button type="submit" class="btn btn-premium-primary pill-button px-5 py-3 w-100 w-md-auto d-inline-flex align-items-center justify-content-center gap-2" style="font-size: 0.95rem;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/><polyline points="16 16 12 12 8 16"/>
                        </svg>
                        Bắt Đầu Tải Lên
                    </button>
                </div>

                <div id="uploadProgressShell" class="mt-4 d-none progress-glass">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="spinner-border spinner-border-sm text-coral-deep" role="status" aria-hidden="true" style="border-width: 2.5px;"></span>
                            <div class="font-mono-xs text-muted-foreground fw-semibold" style="color: var(--brown) !important;">Đang tải lên và xử lý AI...</div>
                        </div>
                        <div class="font-mono-xs text-muted-foreground fw-bold" id="uploadProgressLabel">0%</div>
                    </div>
                    <div class="progress" style="height: 10px; border-radius: 9999px; background: rgba(82, 39, 27, 0.08);">
                        <div id="uploadProgressBar" class="progress-bar" role="progressbar" style="width: 0%; background: linear-gradient(90deg, var(--coral), var(--brown));"></div>
                    </div>
                    <div class="font-mono-xs text-muted-foreground mt-2" id="uploadProgressMeta">Khởi động hàng đợi...</div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const dropzone = document.getElementById('uploadDropzone');
            const input = document.getElementById('uploadFileInput');
            const fileLabel = document.getElementById('selectedFileName');
            const form = document.getElementById('uploadForm');
            const progressShell = document.getElementById('uploadProgressShell');
            const progressBar = document.getElementById('uploadProgressBar');
            const progressLabel = document.getElementById('uploadProgressLabel');
            const progressMeta = document.getElementById('uploadProgressMeta');
            if (!dropzone || !input || !fileLabel || !form || !progressShell || !progressBar || !progressLabel || !progressMeta) return;

            // Visibility Card Selection Logic
            const visibilityCards = document.querySelectorAll('.visibility-option-card');
            const visibilityInput = document.getElementById('visibilityInput');
            if (visibilityCards.length && visibilityInput) {
                const initVal = visibilityInput.value;
                visibilityCards.forEach(card => {
                    if (card.dataset.value === initVal) {
                        card.classList.add('active');
                    } else {
                        card.classList.remove('active');
                    }

                    const selectCard = () => {
                        visibilityCards.forEach(c => c.classList.remove('active'));
                        card.classList.add('active');
                        visibilityInput.value = card.dataset.value;
                    };

                    card.addEventListener('click', selectCard);
                    card.addEventListener('keydown', (e) => {
                        if (e.key === 'Enter' || e.key === ' ') {
                            e.preventDefault();
                            selectCard();
                        }
                    });
                });
            }

            let lastAutoFilledTitle = '';
            let lastAutoFilledDesc = '';

            const updateLabel = () => {
                if (input.files && input.files.length) {
                    const file = input.files[0];
                    fileLabel.textContent = file.name;
                    fileLabel.classList.remove('text-muted-foreground');
                    fileLabel.classList.add('text-dark', 'fw-semibold');
                    fileLabel.style.borderColor = 'rgba(216, 106, 88, 0.3)';

                    // Extract file name without extension
                    const lastDot = file.name.lastIndexOf('.');
                    const fileNameWithoutExt = lastDot !== -1 ? file.name.substring(0, lastDot) : file.name;

                    // Clean the filename for the Title field (replace hyphens/underscores with spaces)
                    let cleanTitle = fileNameWithoutExt
                        .replace(/[-_]+/g, ' ')
                        .replace(/\s+/g, ' ')
                        .trim();

                    // Capitalize the first letter if it is lowercase
                    if (cleanTitle.length > 0) {
                        cleanTitle = cleanTitle.charAt(0).toUpperCase() + cleanTitle.slice(1);
                    }

                    // Auto-fill Title if empty or matches last auto-filled title
                    const titleInput = document.getElementById('Title');
                    if (titleInput && (!titleInput.value || titleInput.value === lastAutoFilledTitle)) {
                        titleInput.value = cleanTitle;
                        lastAutoFilledTitle = cleanTitle;
                        // Trigger input event in case validation is listening
                        titleInput.dispatchEvent(new Event('input'));
                    }

                    // Auto-fill Description if empty or matches last auto-filled description
                    const descInput = document.getElementById('Description');
                    if (descInput && (!descInput.value || descInput.value === lastAutoFilledDesc)) {
                        const newDesc = `Tài liệu học tập: ${cleanTitle}`;
                        descInput.value = newDesc;
                        lastAutoFilledDesc = newDesc;
                        descInput.dispatchEvent(new Event('input'));
                    }

                    // Auto-detect Subject (Môn Học) from filename (e.g. PRN222, SWD392, etc.)
                    const subjectSelect = document.getElementById('SubjectId');
                    if (subjectSelect) {
                        const fileNameLower = file.name.toLowerCase();
                        let foundSubject = false;
                        
                        // First, try matching options by value/code
                        for (let i = 1; i < subjectSelect.options.length; i++) {
                            const option = subjectSelect.options[i];
                            const subjectCode = option.text.toLowerCase().trim();
                            // Exact match or contains code (e.g. "prn222" in "prn222_razor_rag")
                            if (subjectCode && (fileNameLower.includes(subjectCode) || subjectCode.includes(fileNameLower))) {
                                subjectSelect.selectedIndex = i;
                                subjectSelect.dispatchEvent(new Event('change'));
                                foundSubject = true;
                                break;
                            }
                        }
                    }

                    // Auto-detect Document Type from filename keywords
                    const docTypeSelect = document.getElementById('DocumentTypeId');
                    if (docTypeSelect) {
                        const fileNameLower = file.name.toLowerCase();
                        const docTypes = [
                            { keywords: ['slide', 'lecture', 'bài giảng', 'pptx', 'ppt'], type: 'Slide' },
                            { keywords: ['syllabus', 'đề cương'], type: 'Syllabus' },
                            { keywords: ['report', 'báo cáo', 'đề tài', 'luận văn', 'thesis', 'rp'], type: 'Báo cáo' },
                            { keywords: ['assignment', 'asm', 'bài tập', 'exercise', 'homework', 'ex'], type: 'Assignment' },
                            { keywords: ['lab', 'thực hành'], type: 'Lab' },
                            { keywords: ['exam', 'test', 'quiz', 'đề thi', 'kiểm tra'], type: 'Đề thi' },
                            { keywords: ['book', 'textbook', 'sách', 'giáo trình'], type: 'Giáo trình' }
                        ];

                        for (const dt of docTypes) {
                            if (dt.keywords.some(kw => fileNameLower.includes(kw))) {
                                for (let i = 1; i < docTypeSelect.options.length; i++) {
                                    const option = docTypeSelect.options[i];
                                    if (option.text.toLowerCase().includes(dt.type.toLowerCase()) || 
                                        dt.type.toLowerCase().includes(option.text.toLowerCase())) {
                                        docTypeSelect.selectedIndex = i;
                                        docTypeSelect.dispatchEvent(new Event('change'));
                                        break;
                                    }
                                }
                                break;
                            }
                        }
                    }

                    // Auto-detect Language
                    const langSelect = document.getElementById('LanguageId');
                    if (langSelect) {
                        const fileNameLower = file.name.toLowerCase();
                        const enKeywords = ['english', 'en', 'report', 'assignment', 'syllabus', 'lecture', 'slide'];
                        const isEnglish = enKeywords.some(kw => fileNameLower.includes(kw)) && !/[áàảãạăắằẳẵặâấầẩẫậéèẻẽẹêếềểễệíìỉĩịóòỏõọôốồổỗộơớờởỡợúùủũụưứừửữựýỳỷỹỵđ]/i.test(file.name);
                        
                        const targetLang = isEnglish ? 'English' : 'Tiếng Việt';
                        for (let i = 1; i < langSelect.options.length; i++) {
                            const option = langSelect.options[i];
                            if (option.text.toLowerCase().includes(targetLang.toLowerCase())) {
                                langSelect.selectedIndex = i;
                                langSelect.dispatchEvent(new Event('change'));
                                break;
                            }
                        }
                    }
                } else {
                    fileLabel.textContent = 'Chưa chọn tệp nào';
                    fileLabel.classList.add('text-muted-foreground');
                    fileLabel.classList.remove('text-dark', 'fw-semibold');
                }
            };

            dropzone.addEventListener('click', () => input.click());
            dropzone.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    input.click();
                }
            });
            input.addEventListener('change', updateLabel);

            // Drag and drop events
            ['dragenter', 'dragover'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    dropzone.style.background = 'rgba(255, 255, 255, 0.85)';
                    dropzone.style.borderColor = 'var(--coral)';
                }, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    dropzone.style.background = 'rgba(255, 255, 255, 0.45)';
                    dropzone.style.borderColor = 'rgba(216, 106, 88, 0.25)';
                }, false);
            });

            dropzone.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                const files = dt.files;
                if (files.length) {
                    input.files = files;
                    updateLabel();
                }
            });

            form.addEventListener('submit', async (e) => {
                // If form is valid (using jQuery validate)
                if (window.jQuery && jQuery(form).valid && !jQuery(form).valid()) {
                    return;
                }
                
                if (!input.files || input.files.length === 0) return;
                e.preventDefault();

                progressShell.classList.remove('d-none');
                progressBar.style.width = '0%';
                progressLabel.textContent = '0%';
                progressMeta.textContent = 'Đang đẩy file vào hàng đợi...';

                let current = 0;
                const timer = setInterval(() => {
                    current = Math.min(95, current + Math.max(3, Math.floor(Math.random() * 12)));
                    progressBar.style.width = `${current}%`;
                    progressLabel.textContent = `${current}%`;
                    progressMeta.textContent = current < 40 ? 'Đang tải file...' : current < 80 ? 'Đang phân tích cấu trúc tài liệu...' : 'Đang lập chỉ mục AI...';
                }, 220);

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    clearInterval(timer);

                    if (!response.ok) {
                        throw new Error('Upload failed');
                    }

                    const data = await response.json();
                    progressBar.style.width = '100%';
                    progressLabel.textContent = '100%';
                    progressMeta.textContent = 'Hoàn tất. Đang chuyển hướng...';
                    
                    setTimeout(() => {
                        window.location.href = data.redirectUrl;
                    }, 800);
                } catch (error) {
                    clearInterval(timer);
                    form.submit();
                }
            });
        })();
    </script>

    <script>
        // Subject-Term dynamic binding
        (function () {
            var rawMap = @Html.Raw(Model.SubjectTermMapJson);
            var subjectToTerm = {};
            for (var k in rawMap) {
                if (rawMap.hasOwnProperty(k)) {
                    subjectToTerm[k.toLowerCase()] = rawMap[k].toLowerCase();
                }
            }

            var subjectEl = document.getElementById('SubjectId');
            var termEl = document.getElementById('AcademicTermId');

            if (!subjectEl || !termEl) return;

            // Snapshot all original subject <option> elements
            var allSubjectOptions = [];
            for (var i = 0; i < subjectEl.options.length; i++) {
                var o = subjectEl.options[i];
                allSubjectOptions.push({
                    val: o.value,
                    text: o.text,
                    termId: o.value ? (subjectToTerm[o.value.toLowerCase()] || null) : null
                });
            }

            // Flag to prevent circular event firing
            var isProgrammaticTermChange = false;

            // When SUBJECT changes → auto-select the matching Term
            subjectEl.addEventListener('change', function () {
                var subVal = this.value ? this.value.toLowerCase() : '';
                if (subVal && subjectToTerm[subVal]) {
                    var targetTermLower = subjectToTerm[subVal];
                    for (var i = 0; i < termEl.options.length; i++) {
                        if (termEl.options[i].value && termEl.options[i].value.toLowerCase() === targetTermLower) {
                            termEl.selectedIndex = i;
                            isProgrammaticTermChange = true;
                            termEl.dispatchEvent(new Event('change'));
                            isProgrammaticTermChange = false;
                            break;
                        }
                    }
                }
            });

            // When TERM changes → filter subjects to only those belonging to that term
            termEl.addEventListener('change', function () {
                if (isProgrammaticTermChange) return;

                var termVal = this.value ? this.value.toLowerCase() : '';
                var prevSubjectVal = subjectEl.value ? subjectEl.value.toLowerCase() : '';

                // Remove all options, then re-add only matching ones
                while (subjectEl.options.length > 0) {
                    subjectEl.remove(0);
                }
                for (var i = 0; i < allSubjectOptions.length; i++) {
                    var opt = allSubjectOptions[i];
                    if (!opt.val || !termVal || opt.termId === termVal) {
                        var newOpt = document.createElement('option');
                        newOpt.value = opt.val;
                        newOpt.textContent = opt.text;
                        subjectEl.add(newOpt);
                    }
                }

                // Restore previously selected subject if still valid
                var restored = false;
                for (var j = 0; j < subjectEl.options.length; j++) {
                    if (subjectEl.options[j].value && subjectEl.options[j].value.toLowerCase() === prevSubjectVal) {
                        subjectEl.selectedIndex = j;
                        restored = true;
                        break;
                    }
                }
                if (!restored) {
                    subjectEl.selectedIndex = 0;
                }

                // Re-initialize the custom glass-dropdown UI if applicable
                if (window.reinitGlassDropdown) {
                    window.reinitGlassDropdown('SubjectId');
                }
            });
        })();
    </script>
}
