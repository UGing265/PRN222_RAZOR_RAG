@page "/documents/mine"
@model GUI.Pages.Documents.MineModel
@{
    ViewData["Title"] = "Thư viện của tôi";

    var query = Model.Q ?? "";
    var selectedSubjectId = Model.SubjectId;
    var selectedTermId = Model.TermId;
    
    var allTerms = Model.AcademicTerms;
    var allSubjects = Model.Subjects;
    
    var selectedTypeId = Model.DocumentTypeId;
    var selectedLangId = Model.LanguageId;
    var selectedSourceId = Model.DocumentSourceId;

    var allTypes = Model.DocumentTypes;
    var allLangs = Model.Languages;
    var allSources = Model.DocumentSources;
}

<style>
    /* Premium Library Portal Styling */
    .library-card {
        background: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(82, 39, 27, 0.06);
        border-radius: 22px;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
    }

    .library-card:hover {
        transform: translateY(-6px);
        background: rgba(255, 255, 255, 0.95);
        border-color: rgba(216, 106, 88, 0.2);
        box-shadow: 0 20px 40px rgba(74, 31, 22, 0.05);
    }

    .library-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, var(--brown) 0%, var(--coral) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .library-card:hover::before {
        opacity: 1;
    }

    .subject-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 99px;
        background: rgba(216, 106, 88, 0.08) !important;
        color: var(--coral) !important;
        font-size: 0.72rem;
        font-weight: 600;
        padding: 4px 12px;
        border: 1px solid rgba(216, 106, 88, 0.1);
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 99px;
        font-size: 0.72rem;
        font-weight: 600;
        padding: 4px 12px;
    }

    .status-pending {
        background: rgba(255, 193, 7, 0.1) !important;
        color: #b58900 !important;
        border: 1px solid rgba(255, 193, 7, 0.15);
    }

    .status-approved {
        background: rgba(40, 167, 69, 0.1) !important;
        color: #28a745 !important;
        border: 1px solid rgba(40, 167, 69, 0.15);
    }

    .status-rejected {
        background: rgba(220, 53, 69, 0.1) !important;
        color: #dc3545 !important;
        border: 1px solid rgba(220, 53, 69, 0.15);
    }

    .metric-card {
        background: rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(82, 39, 27, 0.06);
        border-radius: 20px;
        padding: 16px 20px;
        transition: all 0.3s ease;
    }

    .metric-card:hover {
        background: rgba(255, 255, 255, 0.75);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(82, 39, 27, 0.03);
    }

    .card-footer-action {
        border-top: 1px solid rgba(82, 39, 27, 0.05);
        padding-top: 14px;
        margin-top: 16px;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 8px;
    }

    .action-btn-primary {
        border-radius: 99px;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 6px 16px;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--brown);
        color: #fff !important;
        border: none;
        box-shadow: 0 4px 10px rgba(82, 39, 27, 0.15);
    }
    
    .action-btn-primary:hover {
        background: #3a1610;
        transform: translateY(-1px);
        box-shadow: 0 6px 14px rgba(82, 39, 27, 0.25);
    }

    .action-btn-outline {
        border-radius: 99px;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 6px 16px;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(82, 39, 27, 0.05);
        color: var(--brown) !important;
        border: 1px solid rgba(82, 39, 27, 0.1);
    }

    .action-btn-outline:hover {
        background: rgba(82, 39, 27, 0.1);
        border-color: rgba(82, 39, 27, 0.15);
    }

    .action-btn-danger {
        border-radius: 99px;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 6px 16px;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #dc3545 !important;
        background: rgba(220, 53, 69, 0.08);
        border: 1px solid rgba(220, 53, 69, 0.15);
    }

    .action-btn-danger:hover {
        background: rgba(220, 53, 69, 0.15);
        border-color: rgba(220, 53, 69, 0.25);
    }

    .progress-glass {
        background: rgba(255, 255, 255, 0.45);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(82, 39, 27, 0.06);
        border-radius: 24px;
    }

    /* Premium Search & Filter Styling */
    .search-glass-panel {
        background: rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(82, 39, 27, 0.06);
        border-radius: 24px;
        transition: all 0.3s ease;
        position: relative;
        z-index: 100;
    }

    .search-glass-panel:focus-within {
        background: rgba(255, 255, 255, 0.85);
        border-color: rgba(216, 106, 88, 0.3);
        box-shadow: 0 10px 25px rgba(82, 39, 27, 0.04);
    }

    .search-input-clean {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        font-size: 0.95rem;
        color: var(--foreground);
    }

    .search-input-clean::placeholder {
        color: var(--muted);
        opacity: 0.7;
    }

    .filter-chip {
        display: inline-flex;
        align-items: center;
        padding: 6px 16px;
        border-radius: 99px;
        font-size: 0.82rem;
        font-weight: 500;
        color: var(--muted);
        background: rgba(255, 255, 255, 0.4);
        border: 1px solid rgba(82, 39, 27, 0.06);
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .filter-chip:hover {
        background: rgba(255, 255, 255, 0.8);
        color: var(--brown);
        border-color: rgba(82, 39, 27, 0.12);
        transform: translateY(-1px);
    }

    .filter-chip.active {
        background: var(--brown);
        color: #ffffff;
        border-color: var(--brown);
    }
</style>

<div class="page-shell grain">
    <div class="container-fluid px-4 px-md-5 py-5" style="max-width: 1300px;">
        
        <!-- Header Section -->
        <div class="d-flex align-items-center justify-content-between mb-5 flex-wrap gap-3">
            <div>
                <span class="font-mono-xs text-coral-deep" style="font-weight: 700; letter-spacing: 0.15em;">KHÔNG GIAN CÁ NHÂN</span>
                <div class="d-flex align-items-center gap-3 mt-2 mb-3">
                    <h1 class="hero-title mb-0" style="font-size: clamp(2.5rem, 5vw, 3.5rem); color: var(--brown); line-height: 1.1;">Thư Viện Của Tôi</h1>
                    
                    <!-- Premium Double-Bezel Badge -->
                    <div class="d-inline-flex p-1.5" style="background: rgba(74, 31, 22, 0.05); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(74, 31, 22, 0.1); border-radius: 100px;">
                        <div class="d-inline-flex align-items-center gap-3 px-4 py-2" style="background: var(--brown); border-radius: 100px; box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.15), 0 4px 16px rgba(74, 31, 22, 0.2);">
                            <div class="d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; background: rgba(255, 255, 255, 0.15); border-radius: 50%;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
                                </svg>
                            </div>
                            <span style="font-family: 'Product Sans', 'Google Sans', sans-serif; font-size: 1.15rem; font-weight: 800; color: var(--coral-soft, #f4c9bb); letter-spacing: -0.02em;">
                                @Model.ViewModel.TotalDocuments <span style="color: #ffffff; font-weight: 500; font-size: 1rem; margin-left: 2px;">Tài Liệu</span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Processing Queue Status Panel -->
        <div class="progress-glass p-4 mb-5 shadow-sm">
            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="spinner-grow spinner-grow-sm text-coral-deep" role="status" aria-hidden="true"></span>
                    <h2 class="h5 mb-0 fw-semibold" style="color: var(--brown);">Đang Xử Lý Nền (AI Parsing)</h2>
                </div>
                <span class="badge rounded-pill bg-light text-dark font-mono-xs px-3 py-2 border" id="uploadJobCount" style="letter-spacing: 0.05em;">@Model.ViewModel.ActiveUploadJobs.Count TIẾN TRÌNH</span>
            </div>
            <div id="uploadJobList" class="d-grid gap-3">
                <partial name="_UploadJobs" model="Model.ViewModel.ActiveUploadJobs" />
            </div>
        </div>



        <!-- Search & Filter Form -->
        <form method="get" asp-page="/Documents/Mine" class="mb-5" id="filterForm">
            <input type="hidden" name="termId" value="@selectedTermId" />
            <div class="search-glass-container p-3 d-flex flex-column gap-3">
                
                <!-- ROW 1: Search Input & Search Button -->
                <div class="d-flex flex-wrap gap-3 align-items-center">
                    <!-- Search Input -->
                    <div class="flex-grow-1 premium-search-box" style="max-width: 600px;">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="premium-search-icon"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                        <input type="text" name="q" value="@query" placeholder="Tìm Kiếm Tài Liệu..." class="premium-search-input">
                    </div>
                    
                    <button type="submit" class="btn btn-premium-primary pill-button px-5 py-2.5 font-mono-xs text-white flex-shrink-0" style="min-width: 120px; font-size: 0.85rem;">
                        TÌM KIẾM
                    </button>
                    @if (!string.IsNullOrWhiteSpace(query) || selectedSubjectId != null || selectedTermId != null || selectedTypeId != null || selectedLangId != null || selectedSourceId != null)
                    {
                        <a asp-page="/Documents/Mine" class="btn btn-link text-muted px-2 text-decoration-none small hover-text-dark" style="font-size: 0.88rem;">Xoá Lọc</a>
                    }
                </div>
                
                <!-- ROW 2: Structured Filters (Subject, Type, Language, Source, Sort) -->
                <div class="d-flex flex-wrap gap-3 align-items-center">
                    <!-- 1. Subject Select -->
                    <div style="min-width: 160px; flex: 1;">
                        <select name="subjectId" class="form-select form-glass-select" onchange="this.form.submit()">
                            <option value="">Tất Cả Môn Học</option>
                            @foreach (var subject in allSubjects)
                            {
                                if (selectedSubjectId.HasValue && selectedSubjectId.Value == subject.Id)
                                {
                                    <option value="@subject.Id" selected>@subject.Code</option>
                                }
                                else
                                {
                                    <option value="@subject.Id">@subject.Code</option>
                                }
                            }
                        </select>
                    </div>
                    
                    <!-- 2. Document Type Select -->
                    <div style="min-width: 160px; flex: 1;">
                        <select name="documentTypeId" class="form-select form-glass-select" onchange="this.form.submit()">
                            <option value="">Tất Cả Học Liệu</option>
                            @foreach (var type in allTypes)
                            {
                                if (selectedTypeId.HasValue && selectedTypeId.Value == type.Id)
                                {
                                    <option value="@type.Id" selected>@type.Name</option>
                                }
                                else
                                {
                                    <option value="@type.Id">@type.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- 3. Language Select -->
                    <div style="min-width: 140px; flex: 1;">
                        <select name="languageId" class="form-select form-glass-select" onchange="this.form.submit()">
                            <option value="">Tất Cả Ngôn Ngữ</option>
                            @foreach (var lang in allLangs)
                            {
                                if (selectedLangId.HasValue && selectedLangId.Value == lang.Id)
                                {
                                    <option value="@lang.Id" selected>@lang.Name</option>
                                }
                                else
                                {
                                    <option value="@lang.Id">@lang.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- 4. Document Source Select -->
                    <div style="min-width: 150px; flex: 1;">
                        <select name="documentSourceId" class="form-select form-glass-select" onchange="this.form.submit()">
                            <option value="">Tất Cả Nguồn</option>
                            @foreach (var src in allSources)
                            {
                                if (selectedSourceId.HasValue && selectedSourceId.Value == src.Id)
                                {
                                    <option value="@src.Id" selected>@src.Name</option>
                                }
                                else
                                {
                                    <option value="@src.Id">@src.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- 5. Sort Dropdown -->
                    <div style="min-width: 160px; flex: 1;">
                        <select name="sortBy" class="form-select form-glass-select" onchange="this.form.submit()">
                            @{
                                var sortOptions = new Dictionary<string, string>
                                {
                                    { "date_desc", "Ngày Đăng ↓" },
                                    { "date_asc", "Ngày Đăng ↑" },
                                    { "title_asc", "A - Z ↑" },
                                    { "title_desc", "Z - A ↓" },
                                    { "views_desc", "Lượt Xem ↓" },
                                    { "views_asc", "Lượt Xem ↑" }
                                };
                                
                                string currentSort = Model.SortBy ?? "date_desc";
                                if (currentSort == "date") currentSort = "date_desc";
                                if (currentSort == "title") currentSort = "title_asc";
                                if (currentSort == "views") currentSort = "views_desc";

                                foreach (var opt in sortOptions)
                                {
                                    if (currentSort == opt.Key)
                                    {
                                        <option value="@opt.Key" selected>@opt.Value</option>
                                    }
                                    else
                                    {
                                        <option value="@opt.Key">@opt.Value</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
        </form>

        <div id="resultsContainer" style="transition: opacity 0.3s ease;">
            <div class="d-flex align-items-center justify-content-end mb-4">
                <span class="font-mono-xs text-muted-foreground" style="font-size: 11px;">
                    Tìm thấy <strong>@Model.ViewModel.TotalDocuments</strong> tài liệu của bạn
                </span>
            </div>

        <!-- Document Grid -->
        <div class="row g-4">
            @if (Model.ViewModel.Documents.Count == 0)
            {
                <div class="col-12 text-center py-5">
                    <div class="p-5 progress-glass text-muted d-inline-block rounded-4">
                        @if (!string.IsNullOrWhiteSpace(query) || selectedSubjectId != null)
                        {
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-3 text-muted" style="opacity: 0.5;">
                                <circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/>
                            </svg>
                            <p class="mb-0 fw-medium">Không tìm thấy tài liệu phù hợp trong không gian cá nhân của bạn.</p>
                            <a asp-page="/Documents/Mine" class="btn btn-premium-secondary btn-sm pill-button mt-3 px-4">Xem Tất Cả</a>
                        }
                        else
                        {
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-3 text-muted" style="opacity: 0.5;">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
                            </svg>
                            <p class="mb-0 fw-medium">Bạn chưa tải lên tài liệu nào trong thư viện cá nhân.</p>
                            <a asp-page="/Documents/Create" class="btn btn-premium-primary btn-sm pill-button mt-3 px-4">Tải Lên Ngay</a>
                        }
                    </div>
                </div>
            }
            else
            {
                @foreach (var item in Model.ViewModel.Documents.OrderByDescending(x => x.UpdatedAt))
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="library-card h-100 p-4">
                            <div>
                                <!-- Subject Badge -->
                                <div class="d-flex align-items-center mb-3">
                                    <span class="subject-badge">
                                        @(string.IsNullOrWhiteSpace(item.SubjectName) ? "Tài Liệu" : item.SubjectName)
                                    </span>
                                </div>
                                
                                <!-- Document Title -->
                                <h3 class="fw-semibold text-foreground text-truncate-2" style="font-size: 1.15rem; color: var(--brown); margin-bottom: 8px; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" title="@item.Title">
                                    @item.Title
                                </h3>

                                <!-- Document Preview -->
                                <p class="text-muted-foreground" style="font-size: 0.85rem; line-height: 1.5; margin-bottom: 12px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; opacity: 0.85;" title="@item.PreviewText">
                                    @(string.IsNullOrWhiteSpace(item.PreviewText) ? "Chưa có mô tả cho tài liệu này." : item.PreviewText)
                                </p>
                            </div>
                            
                            <!-- Card Actions and Meta Details -->
                            <div>
                                <!-- Metadata: Date & Views (placed above separator line) -->
                                <div class="d-flex align-items-center justify-content-between font-mono-xs text-muted-foreground px-1 mb-2" style="font-size: 0.72rem;">
                                    <span>@item.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                    <span class="d-inline-flex align-items-center gap-1" title="Lượt xem">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.85;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        @item.ViewCount lượt xem
                                    </span>
                                </div>
                                
                                <div class="card-footer-action">
                                    <button type="button" class="btn btn-premium-secondary px-0 d-inline-flex align-items-center justify-content-center bookmark-toggle-btn shadow-sm" 
                                            data-document-id="@item.Id" 
                                            data-bookmarked="@item.IsBookmarked.ToString().ToLower()"
                                            style="border-radius: 50%; width: 32px; height: 32px; background: rgba(255, 255, 255, 0.7); border: 1.5px solid rgba(82, 39, 27, 0.08); margin-right: auto;"
                                            title="@(item.IsBookmarked ? "Bỏ lưu tài liệu" : "Lưu tài liệu")">
                                        <svg class="bookmark-icon" width="14" height="14" viewBox="0 0 24 24" fill="@(item.IsBookmarked ? "var(--coral)" : "none")" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: @(item.IsBookmarked ? "var(--coral)" : "var(--brown)"); transition: all 0.3s ease;">
                                            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                                        </svg>
                                    </button>
                                    <a asp-page="/Documents/Details" asp-route-slug="@item.Slug" class="action-btn-primary">
                                        Xem
                                    </a>
                                    <a asp-page="/Documents/Edit" asp-route-slug="@item.Slug" class="action-btn-outline">
                                        Sửa
                                    </a>
                                    <a asp-page="/Documents/Delete" asp-route-slug="@item.Slug" class="action-btn-danger">
                                        Xoá
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Premium Minimalist Pagination -->
        @if (Model.ViewModel.TotalPages > 1)
        {
            <nav class="d-flex justify-content-center mt-5">
                <ul class="pagination gap-2 border-0">
                    <li class="page-item @(Model.ViewModel.Page == 1 ? "disabled" : "")">
                        <a class="page-link pill-button px-3 py-2 border-0" href="?q=@(query)&termId=@(selectedTermId)&subjectId=@(selectedSubjectId)&documentTypeId=@(selectedTypeId)&languageId=@(selectedLangId)&documentSourceId=@(selectedSourceId)&sortBy=@(Model.SortBy)&page=@(Model.ViewModel.Page - 1)" style="border-radius: 12px; color: var(--brown); background: rgba(255,255,255,0.4); font-size: 0.85rem;">
                             Trước
                        </a>
                    </li>
                    @for (int i = 1; i <= Model.ViewModel.TotalPages; i++)
                    {
                        <li class="page-item @(Model.ViewModel.Page == i ? "active" : "")">
                            <a class="page-link pill-button px-3.5 py-2 border-0" href="?q=@(query)&termId=@(selectedTermId)&subjectId=@(selectedSubjectId)&documentTypeId=@(selectedTypeId)&languageId=@(selectedLangId)&documentSourceId=@(selectedSourceId)&sortBy=@(Model.SortBy)&page=@i" 
                               style="border-radius: 12px; font-size: 0.85rem; font-weight: 600; @(Model.ViewModel.Page == i ? "background: var(--brown) !important; color: #fff !important;" : "color: var(--brown); background: rgba(255,255,255,0.4);")">
                                @i
                            </a>
                        </li>
                    }
                    <li class="page-item @(Model.ViewModel.Page == Model.ViewModel.TotalPages ? "disabled" : "")">
                        <a class="page-link pill-button px-3 py-2 border-0" href="?q=@(query)&termId=@(selectedTermId)&subjectId=@(selectedSubjectId)&documentTypeId=@(selectedTypeId)&languageId=@(selectedLangId)&documentSourceId=@(selectedSourceId)&sortBy=@(Model.SortBy)&page=@(Model.ViewModel.Page + 1)" style="border-radius: 12px; color: var(--brown); background: rgba(255,255,255,0.4); font-size: 0.85rem;">
                            Sau
                        </a>
                    </li>
                </ul>
            </nav>
        }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function selectSubject(subject) {
            const input = document.getElementById('selectedSubjectInput');
            if (input) {
                input.value = subject;
                input.form.submit();
            }
        }

        function toggleSort(field) {
            const input = document.getElementById('sortByInput');
            if (!input) return;
            let current = input.value;
            let newSort = field + '_desc';
            if (current === field + '_desc' || current === field) {
                newSort = field + '_asc';
            } else if (current === field + '_asc') {
                newSort = field + '_desc';
            }
            input.value = newSort;
            input.form.submit();
        }

        document.addEventListener("DOMContentLoaded", function() {
            const form = document.getElementById('filterForm');
            const container = document.getElementById('resultsContainer');
            
            if (form && container) {
                // Remove onchange inline attributes and use event listeners
                const selects = form.querySelectorAll('select');
                selects.forEach(s => {
                    s.removeAttribute('onchange');
                    s.addEventListener('change', function() {
                        submitAjaxForm();
                    });
                });
                
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    submitAjaxForm();
                });
                
                function bindBookmarkToggles() {
                    const container = document.getElementById('resultsContainer');
                    if (!container) return;
                    container.querySelectorAll('.bookmark-toggle-btn').forEach(btn => {
                        if (btn.dataset.bound) return;
                        btn.dataset.bound = "true";
                        
                        btn.addEventListener('click', async function(e) {
                            e.preventDefault();
                            e.stopPropagation();
                            const docId = this.dataset.documentId;
                            const isCurrentlyBookmarked = this.dataset.bookmarked === 'true';
                            const originalTitle = this.getAttribute('title');
                            
                            this.dataset.bookmarked = (!isCurrentlyBookmarked).toString();
                            this.setAttribute('title', !isCurrentlyBookmarked ? "Bỏ lưu tài liệu" : "Lưu tài liệu");
                            const svg = this.querySelector('.bookmark-icon');
                            if (!isCurrentlyBookmarked) {
                                svg.setAttribute('fill', 'var(--coral)');
                                svg.style.color = 'var(--coral)';
                            } else {
                                svg.setAttribute('fill', 'none');
                                svg.style.color = 'var(--brown)';
                            }
                            
                            try {
                                const response = await fetch(`/api/documents/${docId}/bookmark`, {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' }
                                });
                                if (!response.ok) throw new Error('Failed');
                                const data = await response.json();
                                
                                this.dataset.bookmarked = data.isBookmarked.toString();
                                this.setAttribute('title', data.isBookmarked ? "Bỏ lưu tài liệu" : "Lưu tài liệu");
                                if (data.isBookmarked) {
                                    svg.setAttribute('fill', 'var(--coral)');
                                    svg.style.color = 'var(--coral)';
                                    if (typeof showPremiumToast === 'function') showPremiumToast('Đã lưu tài liệu vào Bookmark', 'success');
                                } else {
                                    svg.setAttribute('fill', 'none');
                                    svg.style.color = 'var(--brown)';
                                    if (typeof showPremiumToast === 'function') showPremiumToast('Đã xóa tài liệu khỏi Bookmark', 'info');
                                }
                            } catch (error) {
                                console.error('Bookmark error:', error);
                                this.dataset.bookmarked = isCurrentlyBookmarked.toString();
                                this.setAttribute('title', originalTitle);
                                if (isCurrentlyBookmarked) {
                                    svg.setAttribute('fill', 'var(--coral)');
                                    svg.style.color = 'var(--coral)';
                                } else {
                                    svg.setAttribute('fill', 'none');
                                    svg.style.color = 'var(--brown)';
                                }
                                if (typeof showPremiumToast === 'function') showPremiumToast('Lỗi khi lưu tài liệu', 'danger');
                            }
                        });
                    });
                }
                
                function submitAjaxForm() {
                    const url = new URL(form.action || window.location.href);
                    const formData = new FormData(form);
                    const searchParams = new URLSearchParams();
                    formData.forEach((value, key) => {
                        if (value) searchParams.append(key, value);
                    });
                    url.search = searchParams.toString();
                    
                    container.style.opacity = '0.4';
                    
                    fetch(url)
                    .then(res => res.text())
                    .then(html => {
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, 'text/html');
                        const newContainer = doc.getElementById('resultsContainer');
                        if (newContainer) {
                            container.innerHTML = newContainer.innerHTML;
                            window.history.pushState({}, '', url);
                            bindPaginationLinks();
                            bindBookmarkToggles();
                        } else {
                            form.submit();
                        }
                        container.style.opacity = '1';
                    })
                    .catch(err => {
                        console.error(err);
                        container.style.opacity = '1';
                        form.submit(); // fallback
                    });
                }
                
                window.submitAjaxForm = submitAjaxForm;
                
                function bindPaginationLinks() {
                    const pageLinks = container.querySelectorAll('.pagination a.page-link');
                    pageLinks.forEach(link => {
                        link.addEventListener('click', function(e) {
                            e.preventDefault();
                            const url = new URL(this.href);
                            container.style.opacity = '0.4';
                            
                            fetch(url)
                            .then(res => res.text())
                            .then(html => {
                                const parser = new DOMParser();
                                const doc = parser.parseFromString(html, 'text/html');
                                const newContainer = doc.getElementById('resultsContainer');
                                if (newContainer) {
                                    container.innerHTML = newContainer.innerHTML;
                                    window.history.pushState({}, '', url);
                                    bindPaginationLinks();
                                    bindBookmarkToggles();
                                } else {
                                    window.location.href = url;
                                }
                                container.style.opacity = '1';
                            })
                            .catch(err => {
                                window.location.href = url; // fallback
                            });
                        });
                    });
                }
                
                bindPaginationLinks();
                bindBookmarkToggles();
                
                window.addEventListener('popstate', function() {
                    window.location.reload();
                });
            }
        });


        document.addEventListener("DOMContentLoaded", function () {
            const list = document.getElementById('uploadJobList');
            const count = document.getElementById('uploadJobCount');
            if (!list || !count) return;

            const refreshJobs = async () => {
                try {
                    const response = await fetch('/documents/mine', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!response.ok) return;
                    const html = await response.text();
                    list.innerHTML = html;
                    const items = list.querySelectorAll('[data-upload-job]');
                    count.textContent = `${items.length} TIẾN TRÌNH`;
                } catch (_) {
                }
            };

            function setupSignalRListeners() {
                const connection = window.signalrConnection;
                if (!connection) {
                    setTimeout(setupSignalRListeners, 100);
                    return;
                }

                connection.on("ReceiveUploadProgress", function (data) {
                    console.log("ReceiveUploadProgress:", data);
                    
                    // Dynamically refresh the active job cards in the queue
                    refreshJobs();

                    // If job completed successfully or failed, show toast notification and reload document grid
                    if (data.progressPercent >= 100) {
                        showPremiumToast("Xử lý tài liệu và trích xuất AI thành công!", "success");
                        setTimeout(function () {
                            if (window.submitAjaxForm) window.submitAjaxForm(); else window.location.reload();
                        }, 1500);
                    }
                });

                connection.on("ReceiveDocumentStatusUpdated", function (data) {
                    console.log("ReceiveDocumentStatusUpdated:", data);
                    if (data.status === "deleted") {
                        showPremiumToast(`Tài liệu "${data.title}" đã bị gỡ bỏ khỏi hệ thống.`, "danger");
                    } else if (data.status === "completed") {
                        showPremiumToast(`Tài liệu "${data.title}" đã xử lý hoàn tất.`, "success");
                    } else {
                        showPremiumToast(`Trạng thái tài liệu "${data.title}" đã được cập nhật.`, "info");
                    }
                    setTimeout(function () {
                        if (window.submitAjaxForm) window.submitAjaxForm(); else window.location.reload();
                    }, 1500);
                });

                // Bookmark sync
                connection.on("ReceiveBookmarkUpdated", function (data) {
                    console.log("ReceiveBookmarkUpdated:", data);
                    const container = document.getElementById('resultsContainer');
                    if (container) {
                        const btn = container.querySelector(`.bookmark-toggle-btn[data-document-id="${data.documentId}"]`);
                        if (btn) {
                            btn.dataset.bookmarked = data.isBookmarked.toString();
                            btn.setAttribute('title', data.isBookmarked ? "Bỏ lưu tài liệu" : "Lưu tài liệu");
                            const svg = btn.querySelector('.bookmark-icon');
                            if (data.isBookmarked) {
                                svg.setAttribute('fill', 'var(--coral)');
                                svg.style.color = 'var(--coral)';
                            } else {
                                svg.setAttribute('fill', 'none');
                                svg.style.color = 'var(--brown)';
                            }
                        }
                    }
                });

                connection.on('ReceiveDocumentDeleted', (payload) => {
                    showPremiumToast(`Tài liệu "${payload.title || 'này'}" đã bị Admin xóa khỏi hệ thống.`, 'danger');
                    setTimeout(() => {
                        if (typeof submitAjaxForm === 'function') submitAjaxForm();
                        else window.location.reload();
                    }, 1500);
                });

                connection.on('ReceiveDocumentUpdated', (payload) => {
                    if (document.getElementById('doc-card-' + payload.documentId)) {
                        if (typeof submitAjaxForm === 'function') submitAjaxForm();
                        else window.location.reload();
                    }
                });
            }

            setupSignalRListeners();
        });
    </script>
}
