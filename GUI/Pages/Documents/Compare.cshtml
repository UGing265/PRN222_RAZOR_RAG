@page "/documents/compare"
@model GUI.Pages.Documents.CompareModel
@using System.Text.Json
@{
    ViewData["Title"] = "So Sánh Tài Liệu";
}

<style>
    /* Premium Compare Page Styles Sync with System */
    .compare-glass-container {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 10px 40px rgba(74, 31, 22, 0.05);
        transition: all 0.3s ease;
        padding: 32px;
    }

    .compare-glass-container:focus-within {
        box-shadow: 0 15px 50px rgba(216, 106, 88, 0.12);
        border-color: rgba(216, 106, 88, 0.2);
    }

    .doc-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        background: rgba(255, 255, 255, 0.8);
        border: 1px solid var(--border);
        border-radius: 9999px;
        font-size: 0.9rem;
        color: var(--brown);
        font-weight: 500;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        animation: popIn 300ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .doc-pill:hover {
        background: var(--coral-soft);
        border-color: var(--coral);
        color: var(--brown);
        transform: translateY(-2px);
    }
    .doc-pill button {
        background: transparent;
        border: none;
        color: var(--muted);
        display: flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        cursor: pointer;
        transition: all 0.2s ease;
        padding: 0;
    }
    .doc-pill:hover button {
        color: var(--brown);
        background: rgba(255, 255, 255, 0.5);
    }

    .result-dropdown {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(16px);
        border: 1px solid var(--border);
        border-radius: 16px;
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .result-item {
        padding: 14px 18px;
        cursor: pointer;
        transition: all 0.2s ease;
        border-bottom: 1px solid rgba(82, 39, 27, 0.04);
    }
    .result-item:last-child {
        border-bottom: none;
    }
    .result-item:hover {
        background: rgba(216, 106, 88, 0.05);
    }

    /* Markdown Overrides for StudyMate Theme */
    .markdown-premium {
        color: var(--foreground);
        font-family: var(--font-sans);
        line-height: 1.7;
    }
    .markdown-premium h1, .markdown-premium h2, .markdown-premium h3 {
        color: var(--brown);
        font-family: inherit;
        font-weight: 700;
        margin-top: 2rem;
        margin-bottom: 1rem;
    }
    .markdown-premium table {
        width: 100%;
        border-collapse: collapse;
        margin: 2rem 0;
        background: rgba(255, 255, 255, 0.6);
        border-radius: 12px;
        overflow: hidden;
    }
    .markdown-premium th {
        background: rgba(216, 106, 88, 0.08);
        color: var(--brown);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        padding: 1rem;
        text-align: left;
    }
    .markdown-premium td {
        padding: 1.25rem 1rem;
        border-bottom: 1px solid var(--border);
        color: var(--foreground);
        vertical-align: top;
    }
    .markdown-premium tr:last-child td {
        border-bottom: none;
    }

    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @@keyframes popIn {
        from { opacity: 0; transform: scale(0.9); }
        to { opacity: 1; transform: scale(1); }
    }
</style>

<div class="page-shell grain">
    <div class="container-fluid px-4 px-md-5 py-5" style="max-width: 1300px;">

        <!-- Header Section -->
        <div class="d-flex align-items-center justify-content-between mb-5 flex-wrap gap-3">
            <div>
                <span class="font-mono-xs" style="font-weight: 700; letter-spacing: 0.15em; color: var(--coral);">TRÍ TUỆ NHÂN TẠO</span>
                <h1 class="hero-title mt-2 mb-3" style="font-size: clamp(2.5rem, 5vw, 3.5rem); color: var(--brown); line-height: 1.1;">So Sánh Tài Liệu</h1>
                <p class="text-muted-foreground mb-0" style="max-width: 600px; font-size: 1.05rem; line-height: 1.6;">
                    Phân tích sự khác biệt và tương đồng giữa các tài liệu.
                </p>
            </div>
        </div>



        <!-- Compare Input Form -->
        <div class="compare-glass-container mb-5">
            <form method="post" id="compareForm">
                <div class="d-flex justify-content-center mb-5">
                    <button type="button" onclick="window.openSearch()"
                            class="btn btn-premium-secondary pill-button px-4 py-3 font-mono-xs d-flex align-items-center gap-2"
                            style="background: rgba(255,255,255,0.9); border-color: rgba(216, 106, 88, 0.3); color: var(--brown); box-shadow: 0 4px 15px rgba(82, 39, 27, 0.05); transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);"
                            onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 25px rgba(216, 106, 88, 0.15)';"
                            onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(82, 39, 27, 0.05)';">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
                        </svg>
                        TÌM TÀI LIỆU SO SÁNH
                    </button>
                </div>

                <!-- Selected Documents -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-end mb-3">
                        <label class="form-label font-mono-xs mb-0" style="color: var(--muted);">Tài Liệu Đã Chọn (<span id="selectedCount">0</span>/5)</label>
                    </div>

                    <div id="selectedDocsContainer" class="d-flex flex-wrap gap-2" style="min-height: 52px;">
                        <div id="emptySelectionMsg" class="w-100 py-3 px-4" style="border: 1px dashed rgba(82, 39, 27, 0.15); border-radius: 16px; background: rgba(255,255,255,0.4);">
                            <span class="text-muted-foreground text-sm">Chưa có tài liệu nào được chọn. Hãy tìm kiếm ở trên.</span>
                        </div>
                    </div>
                </div>

                <!-- Hidden Inputs -->
                <div id="hiddenInputsContainer">
                    @foreach (var id in Model.SelectedDocumentIds)
                    {
                        <input type="hidden" name="SelectedDocumentIds" value="@id" />
                    }
                </div>

                <div class="text-end border-top pt-4 mt-4" style="border-color: var(--border) !important;">
                    <button type="submit" id="btnCompare" class="btn btn-premium-primary pill-button px-5 py-2.5 font-mono-xs text-white d-inline-flex align-items-center gap-2" disabled>
                        PHÂN TÍCH KHÁC BIỆT
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </button>
                </div>
            </form>
        </div>

        <!-- Results Section -->
        @if (!string.IsNullOrEmpty(Model.ComparisonResultHtml))
        {
            <div class="feature-card-premium" style="animation: fadeUp 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards;">
                <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">
                    <h2 class="hero-title m-0" style="font-size: 1.8rem; color: var(--brown);">Báo Cáo Phân Tích</h2>

                    @if (!string.IsNullOrEmpty(Model.ExportKey))
                    {
                        <a href="?handler=ExportPdf&amp;key=@Model.ExportKey"
                           class="btn btn-premium-secondary pill-button d-flex align-items-center gap-2"
                           download>
                           <span class="font-mono-xs">XUẤT PDF</span>
                           <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        </a>
                    }
                </div>

                <div class="markdown-premium">
                    <div id="markdownContent" style="word-break: break-word;">
                        @Html.Raw(Model.ComparisonResultHtml)
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Search Modal -->
<div id="modal" style="display: none; position: fixed; inset: 0; z-index: 1060; align-items: center; justify-content: center; padding: 16px;">
    <div style="position: absolute; inset: 0; background: rgba(0,0,0,.5);" onclick="window.closeSearch()"></div>
    <div style="position: relative; width: 100%; max-width: 64rem; max-height: 85vh; border-radius: 24px; display: flex; flex-direction: column; overflow: hidden; background: var(--card, #fff); border: 1px solid var(--border); padding: 32px; z-index: 1061;">
        <button type="button" onclick="window.closeSearch()" style="position: absolute; right: 20px; top: 20px; color: var(--muted-foreground); background: none; border: none; cursor: pointer; font-size: 1.25rem;">✕</button>
        <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 16px; color: var(--foreground);">Tìm & gắn tài liệu</h3>

        <div style="display: grid; grid-template-columns: 2fr 1.2fr 1.2fr 1.2fr; gap: 12px; margin-bottom: 24px;">
            <input id="nameQ" placeholder="Tên tài liệu..." style="height: 44px; border-radius: 12px; background: var(--bg); padding: 0 16px; font-size: 0.92rem; border: 1px solid var(--border); outline: none; color: var(--foreground);" />
            <select id="semesterFilter" class="form-select" style="height: 44px; border-radius: 12px; background: var(--bg); border: 1px solid var(--border); color: var(--foreground);">
                <option value="">Tất cả học kỳ</option>
            </select>
            <select id="subjectFilter" class="form-select" style="height: 44px; border-radius: 12px; background: var(--bg); border: 1px solid var(--border); color: var(--foreground);">
                <option value="">Chọn kỳ trước</option>
            </select>
            <select id="materialFilter" class="form-select" style="height: 44px; border-radius: 12px; background: var(--bg); border: 1px solid var(--border); color: var(--foreground);">
                <option value="">Tất cả loại</option>
            </select>
        </div>

        <div id="modal-body" style="flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 16px; padding-bottom: 12px; padding-right: 8px;">
            <!-- Search results will be injected here -->
        </div>

        <div style="display: flex; justify-content: flex-end; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border);">
            <button type="button" onclick="window.closeSearch()" style="border-radius: 12px; background: var(--brown, #4a1f16); color: #fff; padding: 10px 32px; font-size: 0.9rem; font-weight: 500; border: none; cursor: pointer; transition: opacity 0.15s;" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">Xong</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const DOCS = @Html.Raw(JsonSerializer.Serialize(Model.CompareDocuments.Select(d => new
            {
                id = d.Id,
                title = d.Title,
                semester = d.AcademicTermName ?? "Chưa xác định",
                subject = d.SubjectCode ?? d.SubjectName ?? "Chưa xác định",
                material = d.DocumentTypeName ?? "Chưa xác định"
            })));

            const SEMESTERS = [...new Set(DOCS.map(d => d.semester))].filter(Boolean).sort();
            const MATERIAL_TYPES = [...new Set(DOCS.map(d => d.material))].filter(Boolean).sort();
            const SUBJECTS_BY_SEMESTER = {};
            DOCS.forEach(d => {
                if (!SUBJECTS_BY_SEMESTER[d.semester]) SUBJECTS_BY_SEMESTER[d.semester] = new Set();
                SUBJECTS_BY_SEMESTER[d.semester].add(d.subject);
            });
            Object.keys(SUBJECTS_BY_SEMESTER).forEach(k => {
                SUBJECTS_BY_SEMESTER[k] = [...SUBJECTS_BY_SEMESTER[k]].sort();
            });

            // ── DOM refs ──
            const nameQ = document.getElementById("nameQ");
            const semesterFilter = document.getElementById("semesterFilter");
            const subjectFilter = document.getElementById("subjectFilter");
            const materialFilter = document.getElementById("materialFilter");
            const modalBody = document.getElementById("modal-body");
            const modal = document.getElementById("modal");

            const selectedDocsContainer = document.getElementById("selectedDocsContainer");
            const emptySelectionMsg = document.getElementById("emptySelectionMsg");
            const hiddenInputsContainer = document.getElementById("hiddenInputsContainer");
            const btnCompare = document.getElementById("btnCompare");
            const selectedCount = document.getElementById("selectedCount");

            let selectedDocs = [];

            // Re-populate if coming back from POST
            @if (Model.SelectedDocuments != null && Model.SelectedDocuments.Any())
            {
                @foreach (var doc in Model.SelectedDocuments)
                {
                    var escapedTitle = doc.Title.Replace("'", "\\'");
                    <text>
                    selectedDocs.push({
                        id: '@doc.Id',
                        title: '@Html.Raw(escapedTitle)',
                        subjectId: '@doc.SubjectId'
                    });
                    </text>
                }
                <text>
                renderSelectedDocs();
                </text>
            }
            else
            {
                <text>
                const existingInputs = hiddenInputsContainer.querySelectorAll("input");
                if (existingInputs.length > 0) {
                    existingInputs.forEach(input => {
                        selectedDocs.push({ id: input.value, title: "Tài liệu đã chọn (" + input.value.substring(0, 8) + ")", subjectId: null });
                    });
                    renderSelectedDocs();
                }
                </text>
            }

            // ── Setup Filters for Modal ──
            function initFilters() {
                SEMESTERS.forEach(s => semesterFilter.insertAdjacentHTML("beforeend", `<option value="${escapeHtml(s)}">${escapeHtml(s)}</option>`));
                MATERIAL_TYPES.forEach(x => materialFilter.insertAdjacentHTML("beforeend", `<option value="${escapeHtml(x)}">${escapeHtml(x)}</option>`));

                if (window.reinitGlassDropdown) {
                    window.reinitGlassDropdown('semesterFilter');
                    window.reinitGlassDropdown('materialFilter');
                }
            }

            function escapeHtml(str) {
                if (!str) return "";
                return str.replace(/[&<>'"]/g, tag => ({
                    '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
                }[tag]));
            }

            semesterFilter.addEventListener('change', function () {
                const sem = this.value;
                subjectFilter.innerHTML = `<option value="">-- Chọn kỳ trước --</option>`;
                if (sem) {
                    (SUBJECTS_BY_SEMESTER[sem] || []).forEach(s => {
                        subjectFilter.insertAdjacentHTML("beforeend", `<option value="${escapeHtml(s)}">${escapeHtml(s)}</option>`);
                    });
                }

                if (window.reinitGlassDropdown) {
                    window.reinitGlassDropdown('subjectFilter');
                }

                renderModal();
            });

            subjectFilter.addEventListener('change', renderModal);
            materialFilter.addEventListener('change', renderModal);
            nameQ.addEventListener('input', renderModal);

            window.openSearch = function () {
                modal.style.display = 'flex';
                renderModal();
            }

            window.closeSearch = function () {
                modal.style.display = 'none';
            }

            function renderModal() {
                const q = nameQ.value.toLowerCase();
                const sem = semesterFilter.value;
                const sub = subjectFilter.value;
                const mat = materialFilter.value;

                const filtered = DOCS.filter(d => {
                    const matchQ = d.title.toLowerCase().includes(q) || d.subject.toLowerCase().includes(q);
                    const matchSem = !sem || d.semester === sem;
                    const matchSub = !sub || d.subject === sub;
                    const matchMat = !mat || d.material === mat;
                    return matchQ && matchSem && matchSub && matchMat;
                }).slice(0, 50);

                let html = `<div style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.05em; color: var(--muted-foreground);">KẾT QUẢ (${filtered.length})</div>`;
                if (filtered.length === 0) {
                    html += `<div style="text-align: center; color: var(--muted-foreground); padding: 40px 0;">Không tìm thấy tài liệu phù hợp.</div>`;
                }

                filtered.forEach(d => {
                    const isSelected = selectedDocs.some(x => x.id === d.id);
                    const btnStyle = isSelected
                        ? `background: var(--bg); color: var(--foreground); border: 1px solid var(--border);`
                        : `background: var(--coral-soft); color: var(--brown); border: 1px solid transparent;`;
                    const btnText = isSelected ? "Đã chọn" : "Chọn";
                    const btnOnclick = isSelected ? `onclick="removeDocument('${d.id}')"` : `onclick="addDocument('${d.id}', '${escapeHtml(d.title)}', '${escapeHtml(d.subject)}')";`;

                    html += `
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 16px; background: var(--bg); border: 1px solid var(--border); border-radius: 16px;">
                            <div>
                                <div style="font-weight: 500; font-size: 0.95rem; color: var(--foreground); margin-bottom: 4px;">${escapeHtml(d.title)}</div>
                                <div style="font-size: 0.8rem; color: var(--muted-foreground); display: flex; gap: 8px; align-items: center;">
                                    <span>${escapeHtml(d.material)}</span>
                                    <span style="display: inline-block; width: 4px; height: 4px; border-radius: 50%; background: currentColor; opacity: 0.5;"></span>
                                    <span>${escapeHtml(d.subject)}</span>
                                </div>
                            </div>
                            <button type="button" ${btnOnclick} style="border-radius: 9999px; padding: 6px 16px; font-size: 0.85rem; font-weight: 500; cursor: pointer; transition: all 0.15s; ${btnStyle}">
                                ${btnText}
                            </button>
                        </div>
                    `;
                });

                modalBody.innerHTML = html;
            }

            window.addDocument = function(id, title, subject) {
                if (selectedDocs.length >= 5) {
                    if(typeof showPremiumToast === "function") {
                        showPremiumToast("Chỉ chọn tối đa 5 tài liệu.", "danger");
                    } else {
                        alert("Bạn chỉ có thể chọn tối đa 5 tài liệu để so sánh.");
                    }
                    return;
                }

                // Enforce that all selected documents belong to the same subject if needed
                // For comparison, they usually do. Since chat search doesn't easily expose subjectId, we compare subject string.
                if (selectedDocs.length > 0) {
                    const currentSubject = selectedDocs[0].subjectId;
                    if (currentSubject !== subject) {
                        const errorMsg = "Tài liệu này thuộc môn học khác. Bạn chỉ có thể so sánh các tài liệu chung một môn học.";
                        if(typeof showPremiumToast === "function") {
                            showPremiumToast(errorMsg, "danger");
                        } else {
                            alert(errorMsg);
                        }
                        return;
                    }
                }

                if (!selectedDocs.find(d => d.id === id)) {
                    selectedDocs.push({ id, title, subjectId: subject });
                    renderSelectedDocs();
                    renderModal(); // Update modal buttons
                }
            }

            window.removeDocument = function(id) {
                selectedDocs = selectedDocs.filter(d => d.id !== id);
                renderSelectedDocs();
                if(modal.style.display === 'flex') {
                    renderModal();
                }
            }

            function renderSelectedDocs() {
                const pills = selectedDocsContainer.querySelectorAll('.doc-pill');
                pills.forEach(p => p.remove());

                hiddenInputsContainer.innerHTML = "";
                selectedCount.textContent = selectedDocs.length;

                if (selectedDocs.length === 0) {
                    emptySelectionMsg.style.display = "block";
                } else {
                    emptySelectionMsg.style.display = "none";

                    selectedDocs.forEach(doc => {
                        const pill = document.createElement("div");
                        pill.className = "doc-pill";
                        pill.innerHTML = `
                            <span class="text-truncate" style="max-width: 200px;">${doc.title}</span>
                            <button type="button" onclick="removeDocument('${doc.id}')" title="Xóa">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            </button>
                        `;
                        selectedDocsContainer.insertBefore(pill, emptySelectionMsg);

                        const input = document.createElement("input");
                        input.type = "hidden";
                        input.name = "SelectedDocumentIds";
                        input.value = doc.id;
                        hiddenInputsContainer.appendChild(input);
                    });
                }

                btnCompare.disabled = selectedDocs.length < 2 || selectedDocs.length > 5;
            }

            initFilters();
            renderSelectedDocs();
        });
    </script>
}
