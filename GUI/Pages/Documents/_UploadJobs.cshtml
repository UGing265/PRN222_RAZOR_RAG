@model List<GUI.Pages.Documents.UploadJobViewModel>

@if (Model.Any())
{
    foreach (var job in Model.OrderByDescending(x => x.UpdatedAt))
    {
        var barWidth = Math.Clamp(job.ProgressPercent, 0, 100);
        <div class="file-card" data-upload-job="true">
            <div class="d-flex justify-content-between gap-3 mb-2">
                <div class="fw-semibold text-truncate">@job.FileName</div>
                <span class="font-mono-xs text-muted-foreground">@barWidth%</span>
            </div>
            <div class="progress mb-2" style="height: 8px; border-radius: 9999px; background: rgba(82,39,27,.08);">
                <div class="progress-bar" role="progressbar"
                     style="width: @barWidth%; background: linear-gradient(90deg, #d86a58, #4a1f16);"></div>
            </div>
            <div class="d-flex justify-content-between gap-3 small text-muted-foreground">
                <span>@(string.IsNullOrWhiteSpace(job.Message) ? "Đang xử lý" : job.Message)</span>
                <span>@job.Status</span>
            </div>
        </div>
    }
}
else
{
    <div class="text-muted-foreground small">Chưa Có Tiến Trình</div>
}
