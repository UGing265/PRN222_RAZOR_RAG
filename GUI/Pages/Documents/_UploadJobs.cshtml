@model List<GUI.Pages.Documents.UploadJobViewModel>

<style>
    @@keyframes shimmer {
        0% { background-position: -200% center; }
        100% { background-position: 200% center; }
    }

    @@keyframes jobFadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @@keyframes pulse-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%       { opacity: 0.5; transform: scale(0.8); }
    }

    .upload-job-card {
        animation: jobFadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .upload-job-card:nth-child(1) { animation-delay: 0ms; }
    .upload-job-card:nth-child(2) { animation-delay: 60ms; }
    .upload-job-card:nth-child(3) { animation-delay: 120ms; }
    .upload-job-card:nth-child(4) { animation-delay: 180ms; }

    .job-progress-bar {
        transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        background: linear-gradient(
            90deg,
            #d86a58 0%,
            #4a1f16 45%,
            #d86a58 55%,
            #4a1f16 100%
        );
        background-size: 200% auto;
        animation: shimmer 2.2s linear infinite;
    }

    .job-progress-bar.done {
        animation: none;
        background: linear-gradient(90deg, #2b5c43, #3a7a5b);
    }

    .job-progress-bar.failed {
        animation: none;
        background: linear-gradient(90deg, #dc3545, #9b1c2a);
    }

    .job-status-dot {
        width: 8px; height: 8px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 5px;
        animation: pulse-dot 1.4s ease-in-out infinite;
    }
    .job-status-dot.done   { background: #2b5c43; animation: none; }
    .job-status-dot.failed { background: #dc3545; animation: none; }
    .job-status-dot.active { background: #d86a58; }
</style>

@if (Model.Any())
{
    foreach (var job in Model.OrderByDescending(x => x.UpdatedAt))
    {
        var barWidth   = Math.Clamp(job.ProgressPercent, 0, 100);
        var statusLow  = (job.Status ?? "").ToLower();
        var isDone     = statusLow is "completed" or "success" or "done";
        var isFailed   = statusLow is "failed" or "error";
        var barClass   = isDone ? "done" : isFailed ? "failed" : "";
        var dotClass   = isDone ? "done" : isFailed ? "failed" : "active";

        <div class="file-card upload-job-card" data-upload-job="true">
            <div class="d-flex justify-content-between gap-3 mb-2 align-items-center">
                <div class="fw-semibold text-truncate" style="font-size: 0.92rem;">@job.FileName</div>
                <span class="font-mono-xs text-muted-foreground flex-shrink-0" style="font-size: 0.78rem;">@barWidth%</span>
            </div>
            <div class="progress mb-2" style="height: 7px; border-radius: 9999px; background: rgba(82,39,27,.08); overflow: hidden;">
                <div class="progress-bar job-progress-bar @barClass"
                     role="progressbar"
                     style="width: @barWidth%;"
                     aria-valuenow="@barWidth"
                     aria-valuemin="0"
                     aria-valuemax="100">
                </div>
            </div>
            <div class="d-flex justify-content-between gap-3 small text-muted-foreground align-items-center">
                <span class="d-flex align-items-center">
                    <span class="job-status-dot @dotClass"></span>
                    @(string.IsNullOrWhiteSpace(job.Message) ? "Đang xử lý" : job.Message)
                </span>
                <span class="font-mono-xs" style="font-size: 0.72rem; letter-spacing: 0.04em; text-transform: uppercase;">@job.Status</span>
            </div>
        </div>
    }
}
else
{
    <div class="text-muted-foreground small">Chưa Có Tiến Trình</div>
}
