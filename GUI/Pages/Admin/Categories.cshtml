                                <h5 class="fw-bold mb-2" style="font-size: 1.15rem;">Xác nhận xóa?</h5>
                                <p class="text-muted small mb-4">Bạn có chắc chắn muốn xóa nguồn tài liệu <strong id="deleteDocumentSourceNameDisplay"></strong> không?</p>
                                <div class="d-flex gap-2 justify-content-center">
                                    <button type="button" class="btn btn-outline-dark pill-button px-3.5 py-1.5" data-bs-dismiss="modal" style="font-size: 0.85rem; border-radius: 100px;">Hủy</button>
                                    <button type="submit" class="btn btn-danger pill-button px-3.5 py-1.5" style="font-size: 0.85rem; background-color: #dc3545; border: none; border-radius: 100px;">Xóa</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. ACADEMIC TERMS PANE -->
        <div class="metadata-tab-pane" id="academicterms-pane" style="display:none;">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="metadata-panel p-4 p-md-5">
                        <h2 class="h4 fw-bold text-foreground mb-4" style="font-family: inherit;">Danh Sách Học Kỳ</h2>
                        @if (!Model.AcademicTerms.Any())
                        {
                            <div class="text-center py-5">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" class="text-muted mb-3"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                <h3 class="text-muted-foreground" style="font-size: 15px; font-weight: 500; font-family: inherit;">Chưa có học kỳ nào trong hệ thống.</h3>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0 table-container" style="font-family: inherit;">
                                    <thead>
                                        <tr class="text-muted-foreground" style="border: none; font-size: 13px; font-weight: 600; letter-spacing: 0.02em;">
                                            <th scope="col" class="pb-2 border-0 ps-3">Thứ Tự</th>
                                            <th scope="col" class="pb-2 border-0">Tên Học Kỳ</th>
                                            <th scope="col" class="pb-2 border-0 text-end pe-3">Ngày Tạo</th>
                                            <th scope="col" class="pb-2 border-0 text-end pe-3">Thao Tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.AcademicTerms)
                                        {
                                            <tr class="glass-table-row">
                                                <td class="ps-3 py-3 border-0 fw-bold text-foreground" style="border-radius: 12px 0 0 12px; color: #4a1f16 !important; width: 100px; font-size: 14px;">@item.Order</td>
                                                <td class="py-3 border-0 fw-medium text-muted-foreground" style="font-size: 14px;">@item.Name</td>
                                                <td class="py-3 border-0 text-end text-muted pe-3" style="font-size: 12px;">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                                <td class="py-3 border-0 text-end pe-3" style="border-radius: 0 12px 12px 0; width: 100px;">
                                                    <div class="d-flex gap-2 justify-content-end">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center" onclick="openEditAcademicTermModal('@item.Id', '@item.Name', @item.Order)" style="border-radius: 50%; border-color: rgba(0,0,0,0.1); width: 30px; height: 30px; padding: 0;">
                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-outline-danger d-flex align-items-center justify-content-center" onclick="openDeleteAcademicTermModal('@item.Id', '@item.Name')" style="border-radius: 50%; width: 30px; height: 30px; padding: 0;">
                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="metadata-panel p-4">
                        <h2 class="h5 fw-bold text-foreground mb-4 d-flex align-items-center gap-2" style="font-family: inherit;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>
                            Thêm Học Kỳ Mới
                        </h2>
                        <form asp-page-handler="CreateAcademicTerm" method="post" style="font-family: inherit;">
                            <div class="mb-3">
                                <label for="termName" class="form-label text-muted-foreground" style="font-size: 13px; font-weight: 600;">Tên Học Kỳ</label>
                                <input type="text" class="form-control pill-input" id="termName" name="name" placeholder="Ví dụ: Spring 2026" required style="background: rgba(255,255,255,0.5); border: 1px solid rgba(82, 39, 27, 0.08); border-radius: 12px; padding: 12px 16px; font-size: 14px;" />
                            </div>
                            <div class="mb-4">
                                <label for="termOrder" class="form-label text-muted-foreground" style="font-size: 13px; font-weight: 600;">Thứ Tự Sắp Xếp (Số)</label>
                                <input type="number" class="form-control pill-input" id="termOrder" name="order" value="0" min="0" required style="background: rgba(255,255,255,0.5); border: 1px solid rgba(82, 39, 27, 0.08); border-radius: 12px; padding: 12px 16px; font-size: 14px;" />
                            </div>
                            <button type="submit" class="btn btn-dark w-100 pill-button py-2.5 text-white" style="background: #4a1f16; border: none; border-radius: 100px; font-size: 14px; font-weight: 600; box-shadow: 0 4px 12px rgba(74, 31, 22, 0.2);">Tạo Học Kỳ</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Academic Term Modals -->
            <div class="modal fade" id="editAcademicTermModal" tabindex="-1" aria-hidden="true" style="backdrop-filter: blur(8px); background: rgba(74, 31, 22, 0.03);">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg" style="border-radius: 24px; overflow: visible; font-family: inherit;">
                        <div class="modal-header border-0 p-4 pb-0 d-flex justify-content-between align-items-center">
                            <h5 class="modal-title fw-bold" style="font-size: 1.2rem; color: #4a1f16;">Chỉnh Sửa Học Kỳ</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="background-color: rgba(0, 0, 0, 0.05); padding: 0.75rem; border-radius: 50%;"></button>
                        </div>
                        <form asp-page-handler="UpdateAcademicTerm" method="post">
                            <div class="modal-body p-4">
                                <input type="hidden" id="editAcademicTermId" name="id" />
                                <div class="mb-3">
                                    <label class="form-label text-muted-foreground" style="font-size: 13px; font-weight: 600;">Tên Học Kỳ</label>
                                    <input type="text" class="form-control pill-input" id="editAcademicTermName" name="name" required style="border-radius: 12px; padding: 10px 16px; font-size: 14px;" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label text-muted-foreground" style="font-size: 13px; font-weight: 600;">Thứ Tự</label>
                                    <input type="number" class="form-control pill-input" id="editAcademicTermOrder" name="order" required min="0" style="border-radius: 12px; padding: 10px 16px; font-size: 14px;" />
                                </div>
                            </div>
                            <div class="modal-footer border-0 p-4 pt-0 d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-outline-dark pill-button px-4 py-2" data-bs-dismiss="modal" style="font-size: 0.85rem; border-color: rgba(0,0,0,0.15); border-radius: 100px;">Hủy</button>
                                <button type="submit" class="btn btn-dark pill-button px-4 py-2 text-white" style="font-size: 0.85rem; background: #4a1f16; border: none; border-radius: 100px;">Lưu Thay Đổi</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="deleteAcademicTermModal" tabindex="-1" aria-hidden="true" style="backdrop-filter: blur(8px); background: rgba(220, 53, 69, 0.03);">
                <div class="modal-dialog modal-dialog-centered modal-sm">
                    <div class="modal-content border-0 shadow-lg" style="border-radius: 24px; overflow: visible; font-family: inherit;">
                        <form asp-page-handler="DeleteAcademicTerm" method="post">
                            <div class="modal-body text-center p-4">
                                <input type="hidden" id="deleteAcademicTermId" name="id" />
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#dc3545" stroke-width="2.2" class="mb-3"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                <h5 class="fw-bold mb-2" style="font-size: 1.15rem;">Xác nhận xóa?</h5>
                                <p class="text-muted small mb-4">Bạn có chắc chắn muốn xóa học kỳ <strong id="deleteAcademicTermNameDisplay"></strong> không?</p>
                                <div class="d-flex gap-2 justify-content-center">
                                    <button type="button" class="btn btn-outline-dark pill-button px-3.5 py-1.5" data-bs-dismiss="modal" style="font-size: 0.85rem; border-radius: 100px;">Hủy</button>
                                    <button type="submit" class="btn btn-danger pill-button px-3.5 py-1.5" style="font-size: 0.85rem; background-color: #dc3545; border: none; border-radius: 100px;">Xóa</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <script>
            // MODAL OPENING FUNCTIONS
            // Subjects
            function openEditSubjectModal(id, code, name, termId) {
                document.getElementById('editSubjectId').value = id;
                document.getElementById('editSubjectCode').value = code;
                document.getElementById('editSubjectName').value = name;
                document.getElementById('editSubjectTermId').value = termId || '';
                const modal = new bootstrap.Modal(document.getElementById('editSubjectModal'));
                modal.show();
            }
            function openDeleteSubjectModal(id, code) {
                document.getElementById('deleteSubjectId').value = id;
                document.getElementById('deleteSubjectCodeDisplay').textContent = code;
                const modal = new bootstrap.Modal(document.getElementById('deleteSubjectModal'));
                modal.show();
            }

            // Document Types
            function openEditDocumentTypeModal(id, name, desc) {
                document.getElementById('editDocumentTypeId').value = id;
                document.getElementById('editDocumentTypeName').value = name;
                document.getElementById('editDocumentTypeDesc').value = desc || '';
                const modal = new bootstrap.Modal(document.getElementById('editDocumentTypeModal'));
                modal.show();
            }
            function openDeleteDocumentTypeModal(id, name) {
                document.getElementById('deleteDocumentTypeId').value = id;
                document.getElementById('deleteDocumentTypeNameDisplay').textContent = name;
                const modal = new bootstrap.Modal(document.getElementById('deleteDocumentTypeModal'));
                modal.show();
            }

            // Languages
            function openEditLanguageModal(id, code, name) {
                document.getElementById('editLanguageId').value = id;
                document.getElementById('editLanguageCode').value = code;
                document.getElementById('editLanguageName').value = name;
                const modal = new bootstrap.Modal(document.getElementById('editLanguageModal'));
                modal.show();
            }
            function openDeleteLanguageModal(id, name) {
                document.getElementById('deleteLanguageId').value = id;
                document.getElementById('deleteLanguageNameDisplay').textContent = name;
                const modal = new bootstrap.Modal(document.getElementById('deleteLanguageModal'));
                modal.show();
            }

            // Document Sources
            function openEditDocumentSourceModal(id, name) {
                document.getElementById('editDocumentSourceId').value = id;
                document.getElementById('editDocumentSourceName').value = name;
                const modal = new bootstrap.Modal(document.getElementById('editDocumentSourceModal'));
                modal.show();
            }
            function openDeleteDocumentSourceModal(id, name) {
                document.getElementById('deleteDocumentSourceId').value = id;
                document.getElementById('deleteDocumentSourceNameDisplay').textContent = name;
                const modal = new bootstrap.Modal(document.getElementById('deleteDocumentSourceModal'));
                modal.show();
            }

            // Academic Terms
            function openEditAcademicTermModal(id, name, order) {
                document.getElementById('editAcademicTermId').value = id;
                document.getElementById('editAcademicTermName').value = name;
                document.getElementById('editAcademicTermOrder').value = order;
                const modal = new bootstrap.Modal(document.getElementById('editAcademicTermModal'));
                modal.show();
            }
            function openDeleteAcademicTermModal(id, name) {
                document.getElementById('deleteAcademicTermId').value = id;
                document.getElementById('deleteAcademicTermNameDisplay').textContent = name;
                const modal = new bootstrap.Modal(document.getElementById('deleteAcademicTermModal'));
                modal.show();
            }

            // CLIENT-SIDE TABS LOGIC
            (function() {
                document.querySelectorAll('.metadata-local-tab-btn').forEach(btn => {
                    btn.addEventListener('click', function(e) {
                        e.preventDefault();
                        const targetId = this.getAttribute('data-target');
                        
                        // Deactivate all tab buttons & content panes
                        document.querySelectorAll('.metadata-local-tab-btn').forEach(b => b.classList.remove('active'));
                        document.querySelectorAll('.metadata-tab-pane').forEach(p => {
                            p.classList.remove('show', 'active');
                            p.style.display = 'none';
                        });
                        
                        // Activate selected tab & pane
                        this.classList.add('active');
                        const pane = document.querySelector(targetId);
                        if (pane) {
                            pane.classList.add('show', 'active');
                            pane.style.display = 'block';
                        }
                        
                        // Save tab state to sessionStorage
                        sessionStorage.setItem('active_category_tab', this.id);
                    });
                });

                // Restore active tab from URL param, sessionStorage, or default to subjects
                const urlParams = new URLSearchParams(window.location.search);
                const tabParam = urlParams.get('tab');
                let savedTabId = tabParam ? (tabParam + '-tab') : sessionStorage.getItem('active_category_tab');
                if (!savedTabId) savedTabId = 'subjects-tab';
                
                const initialTabLink = document.getElementById(savedTabId);
                if (initialTabLink) {
                    initialTabLink.click();
                } else {
                    const firstTab = document.querySelector('.metadata-local-tab-btn');
                    if (firstTab) firstTab.click();
                }

                if (tabParam) {
                    window.history.replaceState(null, '', window.location.pathname);
                }

                // Hiển thị Toast Message sau khi reload trang
                const successDiv = document.querySelector('.toast-metadata-success');
                const errorDiv = document.querySelector('.toast-metadata-error');
                if (successDiv && typeof showPremiumToast === 'function') {
                    showPremiumToast(successDiv.dataset.message, 'success');
                }
                if (errorDiv && typeof showPremiumToast === 'function') {
                    showPremiumToast(errorDiv.dataset.message, 'danger');
                }
            })();
        </script>
    </main>
</div>
