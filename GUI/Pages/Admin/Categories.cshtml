@page "/admin/categories"
@model GUI.Pages.Admin.CategoriesModel
@{
    ViewData["Title"] = "Quản Lý Danh Mục";
}

<style>
    .metadata-panel {
        background: rgba(255, 255, 255, 0.65) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px) !important;
        border: 1px solid rgba(255, 255, 255, 0.8) !important;
        box-shadow: 0 20px 40px rgba(74, 31, 22, 0.04) !important;
        border-radius: 24px !important;
        transition: all 0.3s ease;
    }
    .glass-table-row {
        background: rgba(255, 255, 255, 0.4) !important;
        border-radius: 16px !important;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
        border: 1px solid transparent;
    }
    .glass-table-row td { background: transparent !important; border: none !important; }
    .glass-table-row td:first-child { border-radius: 16px 0 0 16px; }
    .glass-table-row td:last-child { border-radius: 0 16px 16px 0; }
    .glass-table-row:hover {
        background: rgba(255, 255, 255, 0.85) !important;
        transform: translateY(-2px);
        box-shadow: 0 15px 35px rgba(74, 31, 22, 0.05) !important;
    }
    .table-container { border-collapse: separate; border-spacing: 0 12px; }
    .pill-input:focus {
        background: rgb(255, 255, 255) !important;
        border-color: rgba(216, 106, 88, 0.25) !important;
        box-shadow: 0 6px 18px rgba(216, 106, 88, 0.15) !important;
        outline: none;
    }
    .btn-outline-danger { border-color: rgba(220, 53, 69, 0.35) !important; color: #dc3545 !important; background: transparent !important; }
    .btn-outline-danger:hover { background-color: #dc3545 !important; color: #fff !important; border-color: #dc3545 !important; }
    .btn-outline-secondary { border-color: rgba(0, 0, 0, 0.1) !important; color: #6c757d !important; background: transparent !important; }
    .btn-outline-secondary:hover { background-color: #6c757d !important; color: #fff !important; }
    .btn-outline-dark { border-color: rgba(74, 31, 22, 0.2) !important; color: #4a1f16 !important; background: transparent !important; }
    .btn-outline-dark:hover { background-color: #4a1f16 !important; color: #fff !important; border-color: #4a1f16 !important; }

    /* Fix tab readability when active */
    .metadata-local-tab-btn {
        font-family: inherit;
        font-size: 14px;
        font-weight: 600;
        text-transform: none;
        letter-spacing: normal;
        background: rgba(255, 255, 255, 0.45) !important;
        color: var(--brown) !important;
        border: 1px solid rgba(82, 39, 27, 0.08) !important;
        backdrop-filter: blur(8px);
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
        border-radius: 100px !important; /* Bo góc tròn (pill) như cũ */
        text-decoration: none;
        display: inline-block;
        padding: 8px 18px;
    }
    .metadata-local-tab-btn:hover {
        background: rgba(255, 255, 255, 0.75) !important;
        border-color: rgba(216, 106, 88, 0.25) !important;
        color: var(--brown) !important;
    }
    
    /* Ghi đè màu nền active của tab từ site.css để chữ dễ đọc hơn, đúng màu chủ đề */
    /* Môn Học - Nâu */
    #subjects-tab.active {
        color: #ffffff !important;
        font-weight: 600 !important;
        background: #4a1f16 !important;
        border-color: #4a1f16 !important;
        box-shadow: 0 4px 15px rgba(74, 31, 22, 0.2) !important;
    }
    /* Loại Học Liệu - Xanh Lá Đậm */
    #documenttypes-tab.active {
        color: #ffffff !important;
        font-weight: 600 !important;
        background: #2b5c43 !important;
        border-color: #2b5c43 !important;
        box-shadow: 0 4px 15px rgba(43, 92, 67, 0.2) !important;
    }
    /* Ngôn Ngữ - Xanh Navy */
    #languages-tab.active {
        color: #ffffff !important;
        font-weight: 600 !important;
        background: #1e3e62 !important;
        border-color: #1e3e62 !important;
        box-shadow: 0 4px 15px rgba(30, 62, 98, 0.2) !important;
    }
    /* Nguồn Tài Liệu - Xám Tro */
    #documentsources-tab.active {
        color: #ffffff !important;
        font-weight: 600 !important;
        background: #4b5563 !important;
        border-color: #4b5563 !important;
        box-shadow: 0 4px 15px rgba(75, 85, 99, 0.2) !important;
    }
    /* Học Kỳ - Cam Đất */
    #academicterms-tab.active {
        color: #ffffff !important;
        font-weight: 600 !important;
        background: #d97706 !important;
        border-color: #d97706 !important;
        box-shadow: 0 4px 15px rgba(217, 119, 6, 0.2) !important;
    }
    /* Mặc định cho class nếu mất id */
    .metadata-local-tab-btn.active {
        font-weight: 600 !important;
        color: #ffffff !important;
    }
</style>

<div class="page-shell grain">
    <main class="container-fluid px-4 px-md-5 py-5" style="max-width: 1300px;" id="metadataMainContainer">
        @if (TempData["SuccessMessage"] is string successMsg)
        {
            <div class="toast-metadata-success" data-message="@successMsg" style="display:none;"></div>
        }
        @if (TempData["ErrorMessage"] is string errorMsg)
        {
            <div class="toast-metadata-error" data-message="@errorMsg" style="display:none;"></div>
        }
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-4">
            <div>
                <span class="font-mono-xs text-coral-deep" style="font-weight: 700; letter-spacing: 0.15em;">QUẢN TRỊ VIÊN</span>
                <h1 class="hero-title mt-2 mb-3" style="font-size: clamp(2.5rem, 5vw, 3.5rem); color: var(--brown); line-height: 1.1;">Quản Lý Danh Mục</h1>
                <p class="text-muted-foreground mb-3" style="font-size: 15px; font-weight: 400;">Cấu hình các danh mục Môn học, Loại tài liệu, Ngôn ngữ, Nguồn và Học kỳ trong hệ thống.</p>
            </div>
        </div>

        <!-- Tabs Area -->
        <ul class="nav nav-tabs border-0 mb-5 d-flex gap-2" id="metadataTabs" role="tablist" style="font-family: inherit;">
            <li class="nav-item">
                <a class="nav-link pill-button px-4 py-2 text-decoration-none border-0 metadata-local-tab-btn" id="subjects-tab" href="#" data-target="#subjects-pane">
                    Môn Học (@Model.Subjects.Count)
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link pill-button px-4 py-2 text-decoration-none border-0 metadata-local-tab-btn" id="documenttypes-tab" href="#" data-target="#documenttypes-pane">
                    Loại Học Liệu (@Model.DocumentTypes.Count)
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link pill-button px-4 py-2 text-decoration-none border-0 metadata-local-tab-btn" id="languages-tab" href="#" data-target="#languages-pane">
                    Ngôn Ngữ (@Model.Languages.Count)
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link pill-button px-4 py-2 text-decoration-none border-0 metadata-local-tab-btn" id="documentsources-tab" href="#" data-target="#documentsources-pane">
                    Nguồn Tài Liệu (@Model.DocumentSources.Count)
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link pill-button px-4 py-2 text-decoration-none border-0 metadata-local-tab-btn" id="academicterms-tab" href="#" data-target="#academicterms-pane">
                    Học Kỳ (@Model.AcademicTerms.Count)
                </a>
            </li>
        </ul>

        <!-- TABS PANES -->

        <!-- 1. SUBJECTS PANE -->
        <div class="metadata-tab-pane" id="subjects-pane" style="display:none;">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="metadata-panel p-4 p-md-5">
                        <h2 class="h4 fw-bold text-foreground mb-4" style="font-family: inherit;">Danh Sách Môn Học</h2>
                        @if (!Model.Subjects.Any())
                        {
                            <div class="text-center py-5">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" class="text-muted mb-3"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                                <h3 class="text-muted-foreground" style="font-size: 15px; font-weight: 500; font-family: inherit;">Chưa có môn học nào trong hệ thống.</h3>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0 table-container" style="font-family: inherit;">
                                    <thead>
                                        <tr class="text-muted-foreground" style="border: none; font-size: 13px; font-weight: 600; letter-spacing: 0.02em;">
                                            <th scope="col" class="pb-2 border-0 ps-3">Mã Môn</th>
                                            <th scope="col" class="pb-2 border-0">Tên Môn Học</th>
                                            <th scope="col" class="pb-2 border-0">Học Kỳ</th>
                                            <th scope="col" class="pb-2 border-0 text-end pe-3">Thao Tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Subjects)
                                        {
                                            <tr class="glass-table-row">
                                                <td class="ps-3 py-3 border-0 fw-bold text-foreground" style="border-radius: 12px 0 0 12px; color: #4a1f16 !important; font-size: 14px;">@item.Code</td>
                                                <td class="py-3 border-0 fw-medium text-foreground" style="font-size: 14px;">@item.Name</td>
                                                <td class="py-3 border-0 fw-medium text-muted-foreground" style="font-size: 14px;">@(Model.AcademicTerms.FirstOrDefault(t => t.Id == item.AcademicTermId)?.Name ?? "Chưa phân bổ")</td>
                                                <td class="py-3 border-0 text-end pe-3" style="border-radius: 0 12px 12px 0; width: 100px;">
                                                    <div class="d-flex gap-2 justify-content-end">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center" onclick="openEditSubjectModal('@item.Id', '@item.Code', '@item.Name', '@item.AcademicTermId')" style="border-radius: 50%; border-color: rgba(0,0,0,0.1); width: 30px; height: 30px; padding: 0;">
                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-outline-danger d-flex align-items-center justify-content-center" onclick="openDeleteSubjectModal('@item.Id', '@item.Code')" style="border-radius: 50%; width: 30px; height: 30px; padding: 0;">
                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="metadata-panel p-4">
                        <h2 class="h5 fw-bold text-foreground mb-4 d-flex align-items-center gap-2" style="font-family: inherit;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>
                            Thêm Môn Học Mới
                        </h2>
                        <form asp-page-handler="CreateSubject" method="post" style="font-family: inherit;">
                            <div class="mb-3">
                                <label for="subCode" class="form-label text-muted-foreground" style="font-size: 13px; font-weight: 600;">Mã Môn Học</label>
                                <input type="text" class="form-control pill-input" id="subCode" name="code" placeholder="Ví dụ: PRN222" required style="background: rgba(255,255,255,0.5); border: 1px solid rgba(82, 39, 27, 0.08); border-radius: 12px; padding: 12px 16px; font-size: 14px;" oninput="this.value = this.value.toUpperCase()" />
                            </div>
                            <div class="mb-3">
                                <label for="subName" class="form-label text-muted-foreground" style="font-size: 13px; font-weight: 600;">Tên môn học</label>
                                <input type="text" class="form-control pill-input" id="subName" name="name" placeholder="Ví dụ: C# and .NET Programming" required style="background: rgba(255,255,255,0.5); border: 1px solid rgba(82, 39, 27, 0.08); border-radius: 12px; padding: 12px 16px; font-size: 14px;" />
                            </div>
                            <div class="mb-4">
                                <label for="subTermId" class="form-label text-muted-foreground" style="font-size: 13px; font-weight: 600;">Học Kỳ</label>
                                <select class="form-select pill-input" id="subTermId" name="academicTermId" required style="background: rgba(255,255,255,0.5); border: 1px solid rgba(82, 39, 27, 0.08); border-radius: 12px; padding: 12px 16px; font-size: 14px;">
                                    <option value="">Chọn Học Kỳ</option>
                                    @foreach (var term in Model.AcademicTerms)
                                    {
                                        <option value="@term.Id">@term.Name</option>
                                    }
                                </select>
                            </div>
                            <button type="submit" class="btn btn-dark w-100 pill-button py-2.5 text-white" style="background: #4a1f16; border: none; border-radius: 100px; font-size: 14px; font-weight: 600; box-shadow: 0 4px 12px rgba(74, 31, 22, 0.2);">Tạo Môn Học</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Subject Modals -->
            <div class="modal fade" id="editSubjectModal" tabindex="-1" aria-hidden="true" style="backdrop-filter: blur(8px); background: rgba(74, 31, 22, 0.03);">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg" style="border-radius: 24px; overflow: visible; font-family: inherit;">
                        <div class="modal-header border-0 p-4 pb-0 d-flex justify-content-between align-items-center">
                            <h5 class="modal-title fw-bold" style="font-size: 1.2rem; color: #4a1f16;">Chỉnh Sửa Môn Học</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="background-color: rgba(0, 0, 0, 0.05); padding: 0.75rem; border-radius: 50%;"></button>
                        </div>
                        <form asp-page-handler="UpdateSubject" method="post">
                            <div class="modal-body p-4">
                                <input type="hidden" id="editSubjectId" name="id" />
                                <div class="mb-3">
                                    <label class="form-label text-muted-foreground" style="font-size: 13px; font-weight: 600;">Mã Môn Học</label>
                                    <input type="text" class="form-control pill-input" id="editSubjectCode" name="code" required style="border-radius: 12px; padding: 10px 16px; font-size: 14px;" oninput="this.value = this.value.toUpperCase()" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label text-muted-foreground" style="font-size: 13px; font-weight: 600;">Tên môn học</label>
                                    <input type="text" class="form-control pill-input" id="editSubjectName" name="name" required style="border-radius: 12px; padding: 10px 16px; font-size: 14px;" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label text-muted-foreground" style="font-size: 13px; font-weight: 600;">Học Kỳ</label>
                                    <select class="form-select pill-input" id="editSubjectTermId" name="academicTermId" required style="border-radius: 12px; padding: 10px 16px; font-size: 14px;">
                                        <option value="">Chọn Học Kỳ</option>
                                        @foreach (var term in Model.AcademicTerms)
                                        {
                                            <option value="@term.Id">@term.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="modal-footer border-0 p-4 pt-0 d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-outline-dark pill-button px-4 py-2" data-bs-dismiss="modal" style="font-size: 0.85rem; border-color: rgba(0,0,0,0.15); border-radius: 100px;">Hủy</button>
                                <button type="submit" class="btn btn-dark pill-button px-4 py-2 text-white" style="font-size: 0.85rem; background: #4a1f16; border: none; border-radius: 100px;">Lưu Thay Đổi</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="deleteSubjectModal" tabindex="-1" aria-hidden="true" style="backdrop-filter: blur(8px); background: rgba(220, 53, 69, 0.03);">
                <div class="modal-dialog modal-dialog-centered modal-sm">
                    <div class="modal-content border-0 shadow-lg" style="border-radius: 24px; overflow: visible; font-family: inherit;">
                        <form asp-page-handler="DeleteSubject" method="post">
                            <div class="modal-body text-center p-4">
                                <input type="hidden" id="deleteSubjectId" name="id" />
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#dc3545" stroke-width="2.2" class="mb-3"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                <h5 class="fw-bold mb-2" style="font-size: 1.15rem;">Xác nhận xóa?</h5>
                                <p class="text-muted small mb-4">Bạn có chắc chắn muốn xóa môn học <strong id="deleteSubjectCodeDisplay"></strong> không?</p>
                                <div class="d-flex gap-2 justify-content-center">
                                    <button type="button" class="btn btn-outline-dark pill-button px-3.5 py-1.5" data-bs-dismiss="modal" style="font-size: 0.85rem; border-radius: 100px;">Hủy</button>
                                    <button type="submit" class="btn btn-danger pill-button px-3.5 py-1.5" style="font-size: 0.85rem; background-color: #dc3545; border: none; border-radius: 100px;">Xóa</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. DOCUMENT TYPES PANE -->
        <div class="metadata-tab-pane" id="documenttypes-pane" style="display:none;">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="metadata-panel p-4 p-md-5">
                        <h2 class="h4 fw-bold text-foreground mb-4" style="font-family: inherit;">Danh Sách Loại Học Liệu</h2>
                        @if (!Model.DocumentTypes.Any())
                        {
                            <div class="text-center py-5">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" class="text-muted mb-3"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                <h3 class="text-muted-foreground" style="font-size: 15px; font-weight: 500; font-family: inherit;">Chưa có loại học liệu nào trong hệ thống.</h3>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0 table-container" style="font-family: inherit;">
                                    <thead>
                                        <tr class="text-muted-foreground" style="border: none; font-size: 13px; font-weight: 600; letter-spacing: 0.02em;">
                                            <th scope="col" class="pb-2 border-0 ps-3">Tên Loại</th>
                                            <th scope="col" class="pb-2 border-0">Mô Tả</th>
                                            <th scope="col" class="pb-2 border-0 text-end pe-3">Ngày Tạo</th>
                                            <th scope="col" class="pb-2 border-0 text-end pe-3">Thao Tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.DocumentTypes)
                                        {
                                            <tr class="glass-table-row">
                                                <td class="ps-3 py-3 border-0 fw-bold text-foreground" style="border-radius: 12px 0 0 12px; color: #2b5c43 !important; font-size: 14px;">@item.Name</td>
                                                <td class="py-3 border-0 fw-medium text-muted-foreground" style="font-size: 14px;">@(item.Description ?? "Không có mô tả")</td>
                                                <td class="py-3 border-0 text-end text-muted pe-3" style="font-size: 12px;">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                                <td class="py-3 border-0 text-end pe-3" style="border-radius: 0 12px 12px 0; width: 100px;">
                                                    <div class="d-flex gap-2 justify-content-end">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center" onclick="openEditDocumentTypeModal('@item.Id', '@item.Name', '@(item.Description ?? "")')" style="border-radius: 50%; border-color: rgba(0,0,0,0.1); width: 30px; height: 30px; padding: 0;">
                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-outline-danger d-flex align-items-center justify-content-center" onclick="openDeleteDocumentTypeModal('@item.Id', '@item.Name')" style="border-radius: 50%; width: 30px; height: 30px; padding: 0;">
                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="metadata-panel p-4">
                        <h2 class="h5 fw-bold text-foreground mb-4 d-flex align-items-center gap-2" style="font-family: inherit;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>
                            Thêm Loại Học Liệu Mới
                        </h2>
                        <form asp-page-handler="CreateDocumentType" method="post" style="font-family: inherit;">
                            <div class="mb-3">
