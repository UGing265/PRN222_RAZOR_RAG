@page "/Auth/Register"
@model GUI.Pages.Auth.RegisterModel

@{
    ViewData["Title"] = "Yêu cầu cấp tài khoản";
}

<div class="page-shell grain">
    <main class="container-fluid px-4 px-md-5 py-5" style="max-width: 620px;">
        <div class="soft-panel editorial-shadow p-4 p-md-5" style="background: rgba(255,255,255,.72);">
            <div class="text-center mb-4">
                <h1 class="hero-title mb-0" style="font-size: clamp(1.5rem, 4vw, 2.2rem); white-space: nowrap;">Yêu cầu cấp tài khoản</h1>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger py-2 mb-3">@Model.ErrorMessage</div>
            }

            <form method="post">
                <div class="mb-3">
                    <label asp-for="Input.FullName" class="form-label font-mono-xs text-muted-foreground">Họ và tên</label>
                    <input asp-for="Input.FullName" class="form-control pill-input" placeholder="Họ và tên" required />
                    <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label font-mono-xs text-muted-foreground">Email</label>
                    <input asp-for="Input.Email" class="form-control pill-input" placeholder="name@example.com" required />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>



                <div class="mb-4">
                    <label asp-for="Input.RoleId" class="form-label font-mono-xs text-muted-foreground">Bạn là</label>
                    <select asp-for="Input.RoleId" class="form-select pill-input">
                        <option value="3">Sinh Viên</option>
                        <option value="2">Giảng Viên</option>
                    </select>
                    <span asp-validation-for="Input.RoleId" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-dark pill-button w-100 py-3" style="background:#4a1f16;border-color:#4a1f16;">Gửi yêu cầu</button>
                
                <p class="mt-3 mb-0 text-center text-muted-foreground">
                    Đã có tài khoản? <a asp-page="/Auth/Login" class="text-foreground link-plain fw-medium">Đăng Nhập</a>
                </p>
            </form>
        </div>
    </main>
</div>

<!-- Modal Thành công -->
<div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 soft-panel editorial-shadow text-center p-4">
            <div class="mb-3">
                <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle" style="width: 64px; height: 64px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
            </div>
            <h4 class="mb-2 fw-bold text-foreground">Hoàn tất!</h4>
            <p class="text-muted-foreground mb-4 font-mono-xs" style="line-height: 1.6;">@Model.SuccessMessage</p>
            <a asp-page="/Auth/Login" class="btn btn-dark pill-button w-100" style="background:#4a1f16;border-color:#4a1f16;">Đến trang đăng nhập</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var successModal = new bootstrap.Modal(document.getElementById('successModal'));
                successModal.show();
            });
        </script>
    }
}
