@page "/Auth/ChangePassword"
@model GUI.Pages.Auth.ChangePasswordModel

@{
    ViewData["Title"] = "Bảo mật tài khoản";
    Layout = "_Layout";
}

<div class="page-shell grain">
    <main class="container-fluid px-4 px-md-5 py-5" style="max-width: 560px;">
        <div class="soft-panel editorial-shadow p-4 p-md-5" style="background: rgba(255,255,255,.72);">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h1 class="hero-title mb-0" style="font-size: clamp(2rem, 4vw, 3rem);">Đổi Mật Khẩu</h1>
            </div>
            <p class="text-muted-foreground mb-4">Hệ thống yêu cầu bạn cập nhật mật khẩu mới để đảm bảo an toàn trước khi tiếp tục.</p>

            @if (TempData["ErrorMessage"] != null)
            {
                <div style="background: rgba(254, 242, 242, 0.8); border: 1px solid #fee2e2; color: #991b1b; padding: 12px; border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.9rem;">
                    @TempData["ErrorMessage"]
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label font-mono-xs text-muted-foreground">Mật khẩu hiện tại</label>
                    <input type="password" name="CurrentPassword" class="form-control pill-input" placeholder="••••••••" required />
                </div>

                <div class="mb-3">
                    <label class="form-label font-mono-xs text-muted-foreground">Mật khẩu mới</label>
                    <input type="password" name="NewPassword" class="form-control pill-input" placeholder="••••••••" required minlength="6" />
                    <div class="text-muted-foreground mt-1 ms-3" style="font-size: 13px;">Tối thiểu 6 ký tự.</div>
                </div>

                <div class="mb-4">
                    <label class="form-label font-mono-xs text-muted-foreground">Xác nhận mật khẩu</label>
                    <input type="password" name="ConfirmPassword" class="form-control pill-input" placeholder="••••••••" required minlength="6" />
                </div>

                <button type="submit" class="btn btn-dark pill-button w-100 py-3 mb-3" style="background:#4a1f16;border-color:#4a1f16;">Cập nhật mật khẩu</button>
            </form>
            
            <div class="text-center mt-2">
                <p class="text-muted-foreground mb-0" style="font-size: 14px;">
                    Không muốn đổi mật khẩu lúc này? <a asp-page="/Auth/Logout" class="link-plain" style="color: #4a1f16; font-weight: 600;">Đăng xuất</a>
                </p>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
