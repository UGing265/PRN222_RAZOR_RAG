@page "/Auth/Login"
@model GUI.Pages.Auth.LoginModel

@{
    ViewData["Title"] = "Đăng Nhập";
}

<div class="page-shell grain">
    <main class="container-fluid px-4 px-md-5 py-5" style="max-width: 560px;">
        <div class="soft-panel editorial-shadow p-4 p-md-5" style="background: rgba(255,255,255,.72);">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h1 class="hero-title mb-0" style="font-size: clamp(2rem, 4vw, 3rem);">Đăng Nhập</h1>
                <a asp-page="/Index" class="link-plain text-muted-foreground font-mono-xs">Trang Chủ</a>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger py-2 mb-3">@Model.ErrorMessage</div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success py-2 mb-3">@TempData["SuccessMessage"]</div>
            }

            <form method="post">
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label font-mono-xs text-muted-foreground">Email</label>
                    <input asp-for="Input.Email" class="form-control pill-input" placeholder="name@example.com" required />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label font-mono-xs text-muted-foreground">Mật khẩu</label>
                    <input asp-for="Input.Password" type="password" class="form-control pill-input" placeholder="Mật khẩu" required />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-dark pill-button w-100 py-3 mb-3" style="background:#4a1f16;border-color:#4a1f16;">Đăng Nhập</button>

                <p class="mt-3 mb-0 text-center text-muted-foreground">
                    Chưa có tài khoản? <a asp-page="/Auth/Register" class="text-foreground link-plain fw-medium">Đăng Ký</a>
                </p>
            </form>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
