<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudyMate AI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+4:ital,wght@0,400;0,600;1,400;1,600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-background text-foreground">
    <div class="premium-toast-container" id="premiumToastContainer"></div>

    <div class="shell grain">
        <partial name="_Sidebar" />
        <main class="main-stage animate-tab-content" id="mainStage">
            <script>
                if (document.referrer.toLowerCase().includes('/admin/metadata') && window.location.pathname.toLowerCase().includes('/admin/metadata')) {
                    document.getElementById('mainStage').classList.remove('animate-tab-content');
                }
            </script>
            <!-- Mobile Header (Hidden on Desktop) -->
            <div class="d-lg-none d-flex align-items-center justify-content-between mb-4">
                <a asp-page="/Index" class="d-flex align-items-center gap-2 text-decoration-none">
                    <span class="brand-mark" style="width: 32px; height: 32px; min-width: 32px; font-size: 0.9rem;">S</span>
                    <div class="fw-bold" style="font-size: 1.1rem; color: var(--brown); letter-spacing: -0.02em;">StudyMate AI</div>
                </a>
                <button id="mobileMenuBtn" class="btn border-0 p-2 d-flex align-items-center justify-content-center" type="button" style="background: rgba(82, 39, 27, 0.05); color: var(--brown); border-radius: 12px; position: relative; z-index: 1050; cursor: pointer;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                </button>
            </div>

            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const mobileBtn = document.getElementById('mobileMenuBtn');
            const sidebarMenu = document.getElementById('sidebarMenu');
            if (mobileBtn && sidebarMenu) {
                mobileBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    let bsOffcanvas = bootstrap.Offcanvas.getInstance(sidebarMenu);
                    if (!bsOffcanvas) {
                        bsOffcanvas = new bootstrap.Offcanvas(sidebarMenu);
                    }
                    bsOffcanvas.toggle();
                });
            }
        });
    </script>
    <script src="~/js/glass-dropdown.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            @if (TempData["SuccessMessage"] is string successMsg)
            {
                <text>
                showPremiumToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMsg)), 'success');
                </text>
            }
            @if (TempData["ErrorMessage"] is string errorMsg)
            {
                <text>
                showPremiumToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMsg)), 'danger');
                </text>
            }

            @if (User.Identity?.IsAuthenticated == true)
            {
                var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                <text>
                const currentUserId = "@userId";
                if (currentUserId) {
                    const connection = new signalR.HubConnectionBuilder()
                        .withUrl("/systemHub")
                        .withAutomaticReconnect()
                        .build();

                    window.signalrConnection = connection;

                    connection.on("ReceiveForceLogout", function () {
                        showPremiumToast("Tài khoản của bạn đã bị khóa hoặc thay đổi trạng thái bởi Admin. Đang đăng xuất...", "danger");
                        setTimeout(function () {
                            window.location.href = "/Auth/Logout";
                        }, 2500);
                    });

                    connection.on("ReceiveRoleChanged", function (newRole) {
                        showPremiumToast("Quyền hạn tài khoản của bạn đã được Admin thay đổi. Vui lòng đăng nhập lại để cập nhật hệ thống.", "warning");
                        setTimeout(function () {
                            window.location.href = "/Auth/Logout";
                        }, 3000);
                    });

                    connection.on("ReceiveReportsUpdated", function () {
                        if (!window.location.pathname.toLowerCase().includes('/admin/documents')) {
                            showPremiumToast("Có thay đổi mới về Báo cáo vi phạm. Vui lòng kiểm tra trang Quản lý tài liệu!", "info");
                        }
                    });

                    connection.on("ReceiveProfileUpdated", function (data) {
                        const newFullName = data?.newFullName;
                        if (newFullName) {
                            const nameDisplays = document.querySelectorAll('.user-fullname-display');
                            nameDisplays.forEach(el => {
                                el.textContent = newFullName;
                            });
                            
                            // Try to update input if it exists
                            const inputFullName = document.getElementById('inputFullName');
                            if (inputFullName && inputFullName.value !== newFullName) {
                                inputFullName.value = newFullName;
                            }
                            
                            // Update initials
                            const words = newFullName.trim().split(' ');
                            const initial = words.length > 0 ? words[words.length - 1].charAt(0).toUpperCase() : '?';
                            const avatarCircles = document.querySelectorAll('#sidebarAvatar, #modalAvatarCircle');
                            avatarCircles.forEach(el => {
                                // Find text nodes and replace, keeping structure
                                el.textContent = initial;
                            });
                        }
                    });

                    connection.on("ReceiveLibraryRefresh", function () {
                        if (window.location.pathname.toLowerCase().includes('/admin/')) {
                            return;
                        }
                        setTimeout(function () {
                            if (typeof submitAjaxForm === "function") {
                                submitAjaxForm();
                            } else {
                                window.location.reload();
                            }
                        }, 2500);
                    });

                    connection.on("ReceiveMetadataUpdated", function (message) {
                        console.log("ReceiveMetadataUpdated: metadata updated. Refreshing views...", message);
                        
                        const isDelete = message && message.actionType === "Delete";
                        const deletedId = message && message.data ? message.data.entityId : null;
                        
                        if (isDelete && deletedId) {
                            const urlParams = new URLSearchParams(window.location.search);
                            if (window.location.pathname.toLowerCase().includes('/documents/all')) {
                                const currentSubject = urlParams.get('subjectId');
                                const currentTerm = urlParams.get('termId');
                                if ((currentSubject && currentSubject.toLowerCase() === deletedId.toLowerCase()) || 
                                    (currentTerm && currentTerm.toLowerCase() === deletedId.toLowerCase())) {
                                    window.location.href = '/Documents/All';
                                    return;
                                }
                            }
                        }

                        if (window.location.pathname.toLowerCase().includes('/admin/categories') || window.location.pathname.toLowerCase().includes('/admin/metadata')) {
                            if (typeof window.loadMetadataPage === "function") {
                                window.loadMetadataPage(window.location.href, true);
                            }
                            return;
                        }
                        
                        if (window.location.pathname.toLowerCase().includes('/upload')) {
                            return;
                        }

                        setTimeout(function () {
                            if (typeof submitAjaxForm === "function") {
                                submitAjaxForm();
                            } else if (!window.location.pathname.toLowerCase().includes('/admin/')) {
                                window.location.reload();
                            }
                        }, 1000);
                    });

                    connection.start()
                        .then(() => console.log("SignalR Connection established successfully."))
                        .catch(err => console.error("SignalR Connection Error: ", err));
                }
                </text>
            }

            // Move all modals to body to prevent stacking context issues with animations
            document.querySelectorAll('.modal').forEach(function(modal) {
                document.body.appendChild(modal);
            });

            // Initialize AJAX tab navigation & CRUD for metadata pages
            if (window.location.pathname.toLowerCase().includes('/admin/categories') || window.location.pathname.toLowerCase().includes('/admin/metadata')) {
                initMetadataAjax();
            }

            function initMetadataAjax() {
                const containerSelector = '#metadataMainContainer';
                
                // Intercept tab link clicks
                document.body.addEventListener('click', function(e) {
                    const tabLink = e.target.closest('.metadata-tab-btn');
                    if (tabLink) {
                        e.preventDefault();
                        const targetUrl = tabLink.href;
                        loadMetadataPage(targetUrl);
                    }
                });

                // Intercept form submissions
                document.body.addEventListener('submit', function(e) {
                    const form = e.target.closest('#metadataMainContainer form, .modal form');
                    if (form && form.method.toLowerCase() === 'post') {
                        e.preventDefault();
                        submitMetadataForm(form);
                    }
                });

                function loadMetadataPage(url, isRealtimeSync = false) {
                    const container = document.querySelector(containerSelector);
                    if (!container) return;
                    
                    container.style.opacity = '0.4';
                    
                    fetch(url)
                    .then(res => {
                        if (!res.ok) throw new Error("Load failed");
                        return res.text();
                    })
                    .then(html => {
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, 'text/html');
                        const newContainer = doc.querySelector(containerSelector);
                        
                        if (newContainer) {
                            if (!isRealtimeSync) {
                                closeAllModals();
                            }

                            // Clean up existing modals in body to avoid duplicates/stale modals
                            document.querySelectorAll('body > .modal').forEach(el => el.remove());

                            container.innerHTML = newContainer.innerHTML;
                            
                            document.querySelectorAll('.modal').forEach(function(modal) {
                                document.body.appendChild(modal);
                            });

                            executeScripts(container);
                            checkToasts(container);

                            if (!isRealtimeSync) {
                                window.history.pushState(null, '', url);
                            }
                        } else {
                            window.location.href = url;
                        }
                        container.style.opacity = '1';
                    })
                    .catch(err => {
                        console.error(err);
                        container.style.opacity = '1';
                        if (!isRealtimeSync) {
                            window.location.href = url;
                        }
                    });
                }

                function submitMetadataForm(form) {
                    const action = form.action || window.location.href;
                    const formData = new FormData(form);
                    const container = document.querySelector(containerSelector);
                    if (!container) return;
                    
                    container.style.opacity = '0.4';
                    
                    fetch(action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        }
                    })
                    .then(res => res.text())
                    .then(html => {
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, 'text/html');
                        const newContainer = doc.querySelector(containerSelector);
                        
                        if (newContainer) {
                            closeAllModals();
                            
                            // Clean up existing modals in body to avoid duplicates/stale modals
                            document.querySelectorAll('body > .modal').forEach(el => el.remove());

                            container.innerHTML = newContainer.innerHTML;
                            
                            document.querySelectorAll('.modal').forEach(function(modal) {
                                document.body.appendChild(modal);
                            });

                            executeScripts(container);
                            checkToasts(container);
                        } else {
                            window.location.reload();
                        }
                        container.style.opacity = '1';
                    })
                    .catch(err => {
                        console.error(err);
                        container.style.opacity = '1';
                        window.location.reload();
                    });
                }

                function closeAllModals() {
                    const openModalEl = document.querySelector('.modal.show');
                    if (openModalEl) {
                        const modal = bootstrap.Modal.getInstance(openModalEl);
                        if (modal) modal.hide();
                    }
                    document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
                    document.body.classList.remove('modal-open');
                    document.body.style.overflow = '';
                    document.body.style.paddingRight = '';
                }

                function executeScripts(parent) {
                    parent.querySelectorAll('script').forEach(oldScript => {
                        const newScript = document.createElement('script');
                        Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
                        newScript.appendChild(document.createTextNode(oldScript.innerHTML));
                        oldScript.parentNode.replaceChild(newScript, oldScript);
                    });
                }

                function checkToasts(parent) {
                    const successDiv = parent.querySelector('.toast-metadata-success');
                    const errorDiv = parent.querySelector('.toast-metadata-error');
                    if (successDiv && typeof showPremiumToast === 'function') {
                        showPremiumToast(successDiv.dataset.message, 'success');
                    }
                    if (errorDiv && typeof showPremiumToast === 'function') {
                        showPremiumToast(errorDiv.dataset.message, 'danger');
                    }
                }
                
                window.loadMetadataPage = loadMetadataPage;

                window.addEventListener('popstate', function() {
                    loadMetadataPage(window.location.href);
                });
            }
        });
    </script>

    @await RenderSectionAsync("Modals", required: false)
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
