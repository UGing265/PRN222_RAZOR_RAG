@using BLL.DTOs.Documents
@{
    var jobs = ViewBag.ActiveUploadJobs as List<UploadJobSummaryDto> ?? new List<UploadJobSummaryDto>();
}

<div id="upload-jobs-wrapper-content">
@if (jobs.Any())
{
    <div class="soft-panel editorial-shadow p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <div class="font-mono-xs text-muted-foreground">Đang xử lý nền</div>
                <h2 class="h6 mb-0 mt-2">Tài liệu đang tải lên</h2>
            </div>
            <span class="badge rounded-pill text-bg-dark">@jobs.Count tác vụ</span>
        </div>

        <div class="row g-3">
            @foreach (var job in jobs)
            {
                var width = Math.Clamp(job.ProgressPercent, 0, 100);
                <div class="col-12">
                    <div class="file-card" data-upload-job>
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                            <div>
                                <div class="fw-semibold">@job.FileName</div>
                                <div class="file-subtle">@job.Status — @job.Message</div>
                            </div>
                            <div class="font-mono-xs text-muted-foreground">@width%</div>
                        </div>
                        <div class="progress" style="height: 10px; border-radius: 9999px; background: rgba(82,39,27,.08);">
                            <div class="progress-bar" role="progressbar" style="width:@width%; background: linear-gradient(90deg, #d86a58, #4a1f16);"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
</div>

<script>
    if (!window.uploadJobsPollingStarted) {
        window.uploadJobsPollingStarted = true;
        setInterval(() => {
            fetch('/documents/mine', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(res => res.text())
                .then(html => {
                    var parser = new DOMParser();
                    var doc = parser.parseFromString(html, 'text/html');
                    var newContent = doc.getElementById('upload-jobs-wrapper-content');
                    var currentWrapper = document.getElementById('upload-jobs-wrapper-content');
                    if (newContent && currentWrapper) {
                        currentWrapper.innerHTML = newContent.innerHTML;
                    }
                })
                .catch(err => console.error('Upload polling error:', err));
        }, 1000);
    }
</script>
