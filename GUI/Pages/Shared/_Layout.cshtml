<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — StudyMate AI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+4:ital,wght@0,400;0,600;1,400;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-background text-foreground">
    <div class="premium-toast-container" id="premiumToastContainer"></div>

    <main>
        @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/glass-dropdown.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            @if (TempData["SuccessMessage"] is string successMsg)
            {
                <text>
                showPremiumToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMsg)), 'success');
                </text>
            }
            @if (TempData["ErrorMessage"] is string errorMsg)
            {
                <text>
                showPremiumToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMsg)), 'danger');
                </text>
            }

            @if (User.Identity?.IsAuthenticated == true)
            {
                var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                <text>
                const currentUserId = "@userId";
                if (currentUserId) {
                    const connection = new signalR.HubConnectionBuilder()
                        .withUrl("/systemHub")
                        .withAutomaticReconnect()
                        .build();

                    connection.on("ReceiveForceLogout", function () {
                        showPremiumToast("Tài khoản của bạn đã bị khóa hoặc thay đổi trạng thái bởi Admin. Đang đăng xuất...", "danger");
                        setTimeout(function () {
                            window.location.href = "/Auth/Logout";
                        }, 2500);
                    });

                    connection.start().catch(err => console.error("SignalR Connection Error: ", err));
                }
                </text>
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>