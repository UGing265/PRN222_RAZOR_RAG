@model GUI.Models.Auth.RegisterViewModel

@{
    ViewData["Title"] = "Yêu cầu cấp tài khoản";
}

<div class="page-shell grain">
    <main class="container-fluid px-4 px-md-5 py-5" style="max-width: 620px;">
        <div class="soft-panel editorial-shadow p-4 p-md-5" style="background: rgba(255,255,255,.72);">
            <div class="text-center mb-4">
                <h1 class="hero-title mb-0" style="font-size: clamp(1.5rem, 4vw, 2.2rem); white-space: nowrap;">Yêu cầu cấp tài khoản</h1>
            </div>

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label font-mono-xs text-muted-foreground"></label>
                    <input asp-for="FullName" class="form-control pill-input" placeholder="Họ và tên" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label font-mono-xs text-muted-foreground"></label>
                    <input asp-for="Email" class="form-control pill-input" placeholder="name@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="RoleId" class="form-label font-mono-xs text-muted-foreground"></label>
                    <select asp-for="RoleId" class="form-select pill-input">
                        <option value="3">Sinh Viên</option>
                        <option value="2">Giảng Viên</option>
                    </select>
                    <span asp-validation-for="RoleId" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-dark pill-button w-100 py-3 mb-3" style="background:#4a1f16;border-color:#4a1f16;">Gửi Yêu Cầu</button>

                <p class="mt-3 mb-0 text-center text-muted-foreground" style="font-size: 14px;">
                    Đã có tài khoản? <a asp-action="Login" class="text-foreground link-plain fw-medium">Đăng Nhập</a>
                </p>
            </form>
        </div>
    </main>
</div>

<!-- MODAL THÔNG BÁO GỬI YÊU CẦU THÀNH CÔNG -->
<div class="modal fade" id="successRequestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content text-center" style="border-radius: 1.5rem; border: 1px solid var(--border); background: var(--card); padding: 2rem 1rem;">
            <div class="mb-3 d-flex justify-content-center">
                <div class="brand-mark bg-background text-coral-deep border border-border" style="width: 60px; height: 60px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                </div>
            </div>
            <h5 class="mb-2" style="color: var(--foreground); font-weight: 700;">Đã gửi yêu cầu!</h5>
            <p class="text-muted-foreground mb-4" style="font-size: 14px;">Thông tin của bạn đã được gửi. Vui lòng chờ Admin phê duyệt, sau đó bạn sẽ nhận được email hướng dẫn đặt mật khẩu.</p>
            <a asp-action="Login" class="btn btn-premium-primary w-100">Quay lại Đăng nhập</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
