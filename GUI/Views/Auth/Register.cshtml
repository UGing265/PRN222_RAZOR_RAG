@model GUI.Models.Auth.RegisterViewModel

@{
    ViewData["Title"] = "Đăng Ký";
}

<div class="page-shell grain">
    <main class="container-fluid px-4 px-md-5 py-5" style="max-width: 620px;">
        <div class="soft-panel editorial-shadow p-4 p-md-5" style="background: rgba(255,255,255,.72);">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h1 class="hero-title mb-0" style="font-size: clamp(2rem, 4vw, 3rem);">Đăng Ký</h1>
                <a asp-controller="Home" asp-action="Index" class="link-plain text-muted-foreground font-mono-xs">Trang Chủ</a>
            </div>

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label font-mono-xs text-muted-foreground"></label>
                    <input asp-for="FullName" class="form-control pill-input" placeholder="Họ và tên" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label font-mono-xs text-muted-foreground"></label>
                    <input asp-for="Email" class="form-control pill-input" placeholder="name@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label font-mono-xs text-muted-foreground"></label>
                        <input asp-for="Password" type="password" class="form-control pill-input" placeholder="Mật khẩu" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label font-mono-xs text-muted-foreground"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control pill-input" placeholder="Nhập lại" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="RoleId" class="form-label font-mono-xs text-muted-foreground"></label>
                    <select asp-for="RoleId" class="form-select pill-input">
                        <option value="2">Giảng Viên</option>
                        <option value="3">Sinh Viên</option>
                    </select>
                    <span asp-validation-for="RoleId" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-dark pill-button w-100 py-3" style="background:#4a1f16;border-color:#4a1f16;">Đăng Ký</button>
            </form>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
