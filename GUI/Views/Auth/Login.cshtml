@model GUI.Models.Auth.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="page-shell grain">
    <header class="mx-auto flex-max container-fluid px-4 px-md-5 pt-4 pt-md-5 d-flex align-items-center justify-content-between">
        <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center gap-3 text-decoration-none text-foreground">
            <span class="brand-mark">R</span>
            <div class="lh-sm">
                <div class="fw-semibold">RAG Assistant</div>
                <div class="font-mono-xs text-muted-foreground">Issue №04 · 2026</div>
            </div>
        </a>
        <a asp-controller="Auth" asp-action="Register" class="font-mono-xs text-muted-foreground link-plain">Tạo tài khoản →</a>
    </header>

    <main class="container-fluid px-4 px-md-5 py-4 py-md-5">
        <div class="row g-5 align-items-stretch">
            <section class="col-lg-7 pe-lg-5 border-lg-end border-border">
                <div class="kicker">— Cover Story</div>
                <h1 class="hero-title mt-3 mb-4">
                    Quay lại<br />
                    <span class="font-serif-italic text-coral-deep">không gian</span><br />
                    của bạn.
                </h1>
                <p class="lead text-muted-foreground col-xl-9">
                    Đăng nhập để mở thư viện tri thức cá nhân — nơi mỗi câu trả lời đều có nguồn, mỗi tài liệu đều biết tự kể chuyện.
                </p>

                <figure class="mt-5 mt-md-6 border-start border-3 border-coral-deep ps-4">
                    <blockquote class="display-6 font-serif-italic lh-sm mb-2">“Đọc một lần, hiểu cả thư viện.”</blockquote>
                    <figcaption class="font-mono-xs text-muted-foreground">Manifesto · trang 01</figcaption>
                </figure>

                <dl class="row mt-5 pt-4 border-top border-border g-4 g-xl-5">
                    <div class="col-4">
                        <dt class="display-6 fw-semibold">0.912</dt>
                        <dd class="font-mono-xs text-muted-foreground mb-0">Precision</dd>
                    </div>
                    <div class="col-4">
                        <dt class="display-6 fw-semibold">0.847</dt>
                        <dd class="font-mono-xs text-muted-foreground mb-0">Recall</dd>
                    </div>
                    <div class="col-4">
                        <dt class="display-6 fw-semibold">&lt;420ms</dt>
                        <dd class="font-mono-xs text-muted-foreground mb-0">Latency</dd>
                    </div>
                </dl>
            </section>

            <aside class="col-lg-5">
                <div class="soft-panel editorial-shadow p-4 p-md-5 h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="font-mono-xs text-muted-foreground">Section A · Sign in</div>
                        <div class="text-coral-deep">●</div>
                    </div>

                    <h2 class="display-6 fw-semibold mt-4 mb-4">Đăng nhập</h2>

                    <form asp-action="Login" method="post" class="mt-4">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label font-mono-xs text-muted-foreground"></label>
                            <div class="input-icon-wrap">
                                <span class="input-icon">@Html.Raw("<svg viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2'><path d='M4 4h16v16H4z'/><path d='m4 6 8 7 8-7'/></svg>")</span>
                                <input asp-for="Email" class="form-control pill-input" placeholder="ten@fpt.edu.vn" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <label asp-for="Password" class="form-label font-mono-xs text-muted-foreground"></label>
                                <button type="button" class="btn btn-link p-0 font-mono-xs text-muted-foreground link-plain">Quên?</button>
                            </div>
                            <div class="input-icon-wrap">
                                <span class="input-icon">@Html.Raw("<svg viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2'><rect x='3' y='11' width='18' height='10' rx='2'/><path d='M7 11V7a5 5 0 0 1 10 0v4'/></svg>")</span>
                                <input asp-for="Password" type="password" class="form-control pill-input" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-dark pill-button w-100 d-flex align-items-center justify-content-between px-4 py-3">
                            <span>@(ViewData.ModelState.IsValid ? "Đăng nhập" : "Đăng nhập")</span>
                            <span class="button-arrow">→</span>
                        </button>
                    </form>

                    <div class="my-4 d-flex align-items-center gap-3">
                        <span class="muted-line flex-grow-1"></span>
                        <span class="font-mono-xs text-muted-foreground">hoặc</span>
                        <span class="muted-line flex-grow-1"></span>
                    </div>

                    <button class="btn btn-outline-dark pill-button w-100 d-flex align-items-center justify-content-center gap-2 py-3" type="button">
                        <svg viewBox="0 0 24 24" width="16" height="16">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                            <path fill="#FBBC05" d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.83z" />
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.83C6.71 7.31 9.14 5.38 12 5.38z" />
                        </svg>
                        Google Workspace
                    </button>

                    <p class="mt-4 text-center text-muted-foreground">
                        Chưa có tài khoản?
                        <a asp-action="Register" class="fw-medium text-foreground link-plain">Đăng ký</a>
                    </p>
                </div>
            </aside>
        </div>
    </main>

    <footer class="container-fluid px-4 px-md-5 py-4 d-flex align-items-center justify-content-between font-mono-xs text-muted-foreground border-top border-border">
        <span>© 2026 · SWD392 / FPT University</span>
        <span>GMT+7 · Hồ Chí Minh</span>
    </footer>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
