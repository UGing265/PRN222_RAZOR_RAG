@model GUI.Models.Auth.LoginViewModel

@{
    ViewData["Title"] = "Đăng Nhập";
}

<div class="page-shell grain">
    <main class="container-fluid px-4 px-md-5 py-5" style="max-width: 560px;">
        <div class="soft-panel editorial-shadow p-4 p-md-5" style="background: rgba(255,255,255,.72);">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h1 class="hero-title mb-0" style="font-size: clamp(2rem, 4vw, 3rem);">Đăng Nhập</h1>
                <a asp-controller="Home" asp-action="Index" class="link-plain text-muted-foreground font-mono-xs">Trang Chủ</a>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger py-2 mb-3">@TempData["ErrorMessage"]</div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success py-2 mb-3">@TempData["SuccessMessage"]</div>
            }

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label font-mono-xs text-muted-foreground"></label>
                    <input asp-for="Email" class="form-control pill-input" placeholder="ten@fpt.edu.vn" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label font-mono-xs text-muted-foreground"></label>
                    <input asp-for="Password" type="password" class="form-control pill-input" placeholder="Mật khẩu" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-dark pill-button w-100 py-3 mb-3" style="background:#4a1f16;border-color:#4a1f16;">Đăng Nhập</button>

                <div class="text-center my-3 text-muted-foreground font-mono-xs" style="font-size: 0.8rem; letter-spacing: 0.1em;">— HOẶC —</div>

                <a asp-action="GoogleLogin" class="btn btn-outline-dark pill-button w-100 py-3 d-flex align-items-center justify-content-center gap-2 mb-3" style="border-color:#4a1f16;color:#4a1f16;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48">
                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                        <path fill="#4285F4" d="M46.5 24c0-1.61-.15-3.16-.42-4.67H24v8.83h12.63c-.55 2.92-2.19 5.4-4.67 7.07l7.25 5.62C43.5 35.81 46.5 30.33 46.5 24z"/>
                        <path fill="#FBBC05" d="M10.54 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.98-6.19z"/>
                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.25-5.62c-2.03 1.36-4.63 2.18-8.64 2.18-6.26 0-11.57-4.22-13.46-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                    </svg>
                    Đăng nhập bằng Google FPT
                </a>

                <p class="mt-3 mb-0 text-center text-muted-foreground">
                    Chưa có tài khoản? <a asp-action="Register" class="text-foreground link-plain fw-medium">Đăng Ký</a>
                </p>
            </form>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
