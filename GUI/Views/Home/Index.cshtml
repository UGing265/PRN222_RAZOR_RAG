@{
    ViewData["Title"] = "Trang Chủ";
}

<!-- Decorative Pulsing Glows -->
<div class="pulsing-glow" style="top: 10%; left: 5%;"></div>
<div class="pulsing-glow" style="top: 40%; right: 5%; animation-delay: -5s;"></div>

<div class="page-shell grain position-relative overflow-hidden py-4">
    <!-- Floating Glass Navbar -->
    <header class="container mb-5">
        <nav class="navbar navbar-expand-lg glass-nav px-4 py-3 shadow-sm">
            <div class="container-fluid d-flex align-items-center justify-content-between">
                <!-- Brand Logo -->
                <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark shadow-sm" style="background: var(--brown);">S</span>
                    <span class="fw-bold tracking-tight text-gradient" style="font-size: 1.25rem;">StudyMate AI</span>
                </a>

                <!-- Navigation Action / Buttons -->
                <div class="d-flex align-items-center gap-2">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <span class="d-none d-md-inline-block font-mono-xs text-muted-foreground me-2">Chào, @User.Identity.Name</span>
                        <a class="btn btn-premium-secondary btn-sm px-4 pill-button" asp-controller="Documents" asp-action="MyDocuments">Thư Viện</a>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm px-3 pill-button" style="border-radius: 9999px;">Đăng Xuất</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-premium-secondary btn-sm px-4 pill-button d-none d-sm-inline-block" asp-controller="Auth" asp-action="Login">Đăng Nhập</a>
                        <a class="btn btn-premium-primary btn-sm px-4 pill-button" style="background: var(--brown);" asp-controller="Auth" asp-action="Register">Đăng Ký</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Hero & Intro Section -->
    <main class="container mb-5">
        <div class="row align-items-center g-5 py-3">
            <!-- Left Column: Copywriting & CTA -->
            <div class="col-lg-6 position-relative" style="z-index: 2;">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill bg-white border-border shadow-sm mb-3" style="border: 1px solid rgba(82, 39, 27, 0.08);">
                    <span class="badge bg-danger rounded-pill px-2 py-1" style="background-color: var(--coral) !important; font-size: 0.65rem; font-weight: 700; letter-spacing: 0.05em;">AI NEW</span>
                    <span class="font-mono-xs text-muted-foreground" style="font-size: 9px; font-weight: 700;">HỆ THỐNG TRUY VẤN TRI THỨC</span>
                </div>

                <h1 class="hero-title tracking-tight mt-1 mb-4" style="font-size: clamp(2.4rem, 5.5vw, 4.4rem); line-height: 1.05; color: var(--foreground);">
                    Tài Liệu Của Bạn. <br />
                    <span class="text-gradient">Trí Tuệ Nhân Tạo.</span>
                </h1>
                
                <p class="text-muted-foreground mb-4 fs-5" style="max-width: 580px; line-height: 1.6;">
                    Học tập thông minh hơn cùng công nghệ RAG (Retrieval-Augmented Generation). Tải tài liệu, giáo trình, và nhận ngay câu trả lời chính xác, kèm trích dẫn chi tiết từ AI.
                </p>

                <div class="d-flex gap-3 flex-wrap">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <a class="btn btn-premium-primary px-4 py-3" asp-controller="Documents" asp-action="Create">
                            <span class="d-flex align-items-center gap-2">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                Tải Tài Liệu Lên
                            </span>
                        </a>
                        <a class="btn btn-premium-secondary px-4 py-3" asp-controller="Documents" asp-action="MyDocuments">
                            Khám Phá Thư Viện
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-premium-primary px-4 py-3" asp-controller="Auth" asp-action="Register">
                            Bắt Đầu Học Tập
                        </a>
                        <a class="btn btn-premium-secondary px-4 py-3" href="#pipeline-section">
                            Tìm Hiểu Quy Trình
                        </a>
                    }
                </div>
            </div>

            <!-- Right Column: Visual Mockup (AI Assistant Chat interface) -->
            <div class="col-lg-6 position-relative">
                <div class="hero-visual-card p-4 soft-panel bg-white shadow-lg border-border" style="background: rgba(255, 255, 255, 0.78) !important;">
                    <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="brand-mark shadow-sm bg-dark text-white" style="width: 32px; height: 32px; font-size: 0.9rem; font-weight: 700; background: var(--brown) !important;">A</div>
                            <div>
                                <div class="fw-bold text-gradient" style="font-size: 0.9rem;">Trợ Lý Học Tập RAG</div>
                                <div class="font-mono-xs text-muted-foreground" style="font-size: 8px;">Active Now — powered by Gemini</div>
                            </div>
                        </div>
                        <div class="d-flex gap-1">
                            <span class="badge rounded-pill bg-success-subtle text-success px-2 py-1" style="font-size: 10px; background: rgba(25, 135, 84, 0.1);">99.8% Precision</span>
                        </div>
                    </div>

                    <!-- Chat Bubbles Mockup -->
                    <div class="d-grid gap-3 mb-3">
                        <div class="chat-message p-3 rounded-4 bg-light border-border" style="border-top-left-radius: 4px; background: rgba(0, 0, 0, 0.03) !important;">
                            <div class="font-mono-xs text-muted-foreground mb-1" style="font-size: 9px;">BẠN HỎI</div>
                            <div class="fw-medium text-dark" style="font-size: 0.85rem;">Kiến thức về mô hình Transformer hoạt động thế nào trong NLP?</div>
                        </div>

                        <div class="chat-message p-3 rounded-4 bg-white border-border shadow-sm" style="border-top-right-radius: 4px; border: 1px solid rgba(82, 39, 27, 0.08);">
                            <div class="font-mono-xs text-gradient mb-1" style="font-size: 9px; font-weight: bold;">TRỢ LÝ AI</div>
                            <p class="text-dark mb-2" style="font-size: 0.85rem; line-height: 1.5;">
                                Mô hình Transformer dựa hoàn toàn trên cơ chế <strong>Self-Attention</strong> mà không cần sử dụng mạng hồi quy tuần hoàn (RNN). Cơ chế này cho phép xử lý song song toàn bộ chuỗi đầu vào cùng lúc...
                            </p>
                            <div class="d-flex gap-2">
                                <span class="badge rounded-3 text-muted border px-2 py-1" style="font-size: 9px; background: rgba(255,255,255,.9);">📄 slide-transformer.pdf [Trang 12]</span>
                                <span class="badge rounded-3 text-muted border px-2 py-1" style="font-size: 9px; background: rgba(255,255,255,.9);">📄 nlp-overview.docx [Mục 3.2]</span>
                            </div>
                        </div>
                    </div>

                    <!-- Input Bar Mockup -->
                    <div class="d-flex align-items-center gap-2 p-2 rounded-pill bg-white border shadow-sm">
                        <input type="text" class="form-control border-0 bg-transparent py-2 shadow-none font-sans" placeholder="Đặt câu hỏi từ tài liệu của bạn..." style="font-size: 0.85rem;" readonly />
                        <button class="btn btn-dark pill-button p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; background: var(--brown) !important; border: none;" disabled>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- RAG Pipeline Overview Section -->
    <section class="container py-5 mb-5" id="pipeline-section">
        <div class="text-center mb-5">
            <div class="kicker text-uppercase font-mono-xs text-muted-foreground">— HỆ THỐNG VẬN HÀNH</div>
            <h2 class="hero-title mt-2 mb-3" style="font-size: 2.2rem; color: var(--foreground);">Quy Trình Xử Lý RAG Tự Động</h2>
            <p class="text-muted-foreground mx-auto" style="max-width: 600px;">
                Tài liệu của bạn được biến đổi thành một cơ sở tri thức thông minh chỉ qua 4 bước khép kín và an toàn tuyệt đối.
            </p>
        </div>

        <div class="row g-4 justify-content-center">
            <!-- Step 1 -->
            <div class="col-md-6 col-lg-3">
                <div class="feature-card-premium h-100">
                    <span class="pipeline-step-badge">01</span>
                    <div class="glow-icon-container mb-4">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                    </div>
                    <h4 class="fw-bold mb-2" style="font-size: 1.15rem; color: var(--foreground);">1. Tải Lên</h4>
                    <p class="text-muted-foreground text-sm mb-0" style="font-size: 0.88rem; line-height: 1.6;">
                        Hỗ trợ định dạng PDF, DOCX, TXT. Hệ thống lưu trữ dữ liệu an toàn và mã hóa liên kết.
                    </p>
                </div>
            </div>

            <!-- Step 2 -->
            <div class="col-md-6 col-lg-3">
                <div class="feature-card-premium h-100">
                    <span class="pipeline-step-badge">02</span>
                    <div class="glow-icon-container mb-4">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="21" y1="12" x2="9" y2="12"/><line x1="12" y1="21" x2="12" y2="9"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
                    </div>
                    <h4 class="fw-bold mb-2" style="font-size: 1.15rem; color: var(--foreground);">2. Băm Nhỏ</h4>
                    <p class="text-muted-foreground text-sm mb-0" style="font-size: 0.88rem; line-height: 1.6;">
                        Nội dung tài liệu được phân tích cú pháp, dọn dẹp và phân đoạn (chunking) thông minh để giữ ngữ cảnh.
                    </p>
                </div>
            </div>

            <!-- Step 3 -->
            <div class="col-md-6 col-lg-3">
                <div class="feature-card-premium h-100">
                    <span class="pipeline-step-badge">03</span>
                    <div class="glow-icon-container mb-4">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                    </div>
                    <h4 class="fw-bold mb-2" style="font-size: 1.15rem; color: var(--foreground);">3. Vector hóa</h4>
                    <p class="text-muted-foreground text-sm mb-0" style="font-size: 0.88rem; line-height: 1.6;">
                        Mã hóa từng khối thông tin thành Vector nhúng (Embedding) và lưu trữ vào Vector Database để tìm kiếm ngữ nghĩa.
                    </p>
                </div>
            </div>

            <!-- Step 4 -->
            <div class="col-md-6 col-lg-3">
                <div class="feature-card-premium h-100">
                    <span class="pipeline-step-badge">04</span>
                    <div class="glow-icon-container mb-4">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    </div>
                    <h4 class="fw-bold mb-2" style="font-size: 1.15rem; color: var(--foreground);">4. Chat Trợ Lý AI</h4>
                    <p class="text-muted-foreground text-sm mb-0" style="font-size: 0.88rem; line-height: 1.6;">
                        AI tìm kiếm các đoạn văn bản tương đồng, tổng hợp tri thức và giải đáp thắc mắc với độ chuẩn xác tuyệt đối.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Role Benefits Section -->
    <section class="container py-5 mb-5" style="border-top: 1px solid rgba(82,39,27,0.05);">
        <div class="row align-items-stretch g-5 mt-2">
            <!-- Left Benefit Panel (Giảng viên) -->
            <div class="col-lg-6">
                <div class="h-100 p-4 p-md-5 rounded-4 border shadow-sm" style="background: rgba(74, 31, 22, 0.02); border-color: rgba(74, 31, 22, 0.05) !important;">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="p-3 bg-white border rounded-circle shadow-sm" style="color: var(--brown);">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                        </div>
                        <div>
                            <span class="font-mono-xs text-muted-foreground">TIỆN ÍCH DÀNH CHO</span>
                            <h3 class="fw-bold mb-0 text-gradient" style="font-size: 1.5rem;">Giảng Viên & Học Giả</h3>
                        </div>
                    </div>
                    <ul class="d-grid gap-3 list-unstyled text-muted-foreground p-0 m-0">
                        <li class="d-flex align-items-start gap-2">
                            <span style="color: var(--coral); font-weight: bold; margin-top: 2px;">✔</span>
                            <span>Quản lý kho giáo án, bài giảng số chất lượng cao trong hệ thống thư viện cá nhân.</span>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <span style="color: var(--coral); font-weight: bold; margin-top: 2px;">✔</span>
                            <span>Tạo nhanh đề trắc nghiệm, trích lọc câu hỏi trọng tâm từ các tài liệu tham khảo.</span>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <span style="color: var(--coral); font-weight: bold; margin-top: 2px;">✔</span>
                            <span>Hỗ trợ nghiên cứu học thuật, đối soát thông tin nhanh gọn, giảm thời gian tìm kiếm thủ công.</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Right Benefit Panel (Sinh viên) -->
            <div class="col-lg-6">
                <div class="h-100 p-4 p-md-5 rounded-4 border shadow-sm" style="background: rgba(216, 106, 88, 0.02); border-color: rgba(216, 106, 88, 0.05) !important;">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="p-3 bg-white border rounded-circle shadow-sm" style="color: var(--coral);">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5"/></svg>
                        </div>
                        <div>
                            <span class="font-mono-xs text-muted-foreground">TRẢI NGHIỆM DÀNH CHO</span>
                            <h3 class="fw-bold mb-0 text-gradient" style="font-size: 1.5rem;">Sinh Viên & Học Viên</h3>
                        </div>
                    </div>
                    <ul class="d-grid gap-3 list-unstyled text-muted-foreground p-0 m-0">
                        <li class="d-flex align-items-start gap-2">
                            <span style="color: var(--coral); font-weight: bold; margin-top: 2px;">✔</span>
                            <span>Đặt câu hỏi ôn tập và nhận lời giải đáp kèm trích dẫn tài liệu cụ thể của lớp học.</span>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <span style="color: var(--coral); font-weight: bold; margin-top: 2px;">✔</span>
                            <span>Tự động tóm tắt bài giảng slide dài hàng trăm trang chỉ trong vài giây cực kỳ trực quan.</span>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <span style="color: var(--coral); font-weight: bold; margin-top: 2px;">✔</span>
                            <span>Nâng cao kết quả học tập thông qua trợ lý ảo hỗ trợ không ngừng nghỉ 24/7.</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="premium-footer py-5 mt-5">
        <div class="container text-center">
            <div class="d-flex align-items-center justify-content-center gap-2 mb-3">
                <span class="brand-mark shadow-sm bg-dark text-white" style="width: 28px; height: 28px; font-size: 0.8rem; font-weight: 700; background: var(--brown) !important;">S</span>
                <span class="fw-bold text-gradient font-sans" style="font-size: 1rem;">StudyMate AI</span>
            </div>
            <p class="text-muted-foreground mb-0 font-mono-xs" style="font-size: 10px;">
                &copy; @DateTime.Now.Year — StudyMate AI System. Được thiết kế tinh tế và hiệu năng cao.
            </p>
        </div>
    </footer>
</div>
