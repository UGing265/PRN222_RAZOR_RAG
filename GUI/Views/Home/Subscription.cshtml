@{
    ViewData["Title"] = "Gói Dịch Vụ";
}

<div class="page-shell grain">
    <div class="container-fluid px-4 px-md-5 py-5">
        
        <!-- Header Section -->
        <div class="text-center mb-5 mt-3">
            <span class="kicker text-gradient fw-bold mb-2 d-inline-block" style="font-size: 0.9rem; letter-spacing: 0.15em;">STUDYMATE AI MEMBERSHIP</span>
            <h1 class="hero-title" style="font-size: clamp(2.5rem, 5vw, 4.5rem); line-height: 1.1;">Chọn Gói Dịch Vụ Phù Hợp</h1>
            <p class="text-muted-foreground mt-3 mx-auto" style="max-width: 600px; font-size: 1.1rem;">
                Mở khóa tối đa sức mạnh trí tuệ nhân tạo. Tăng tốc phân tích tài liệu, không giới hạn câu hỏi và nâng cao hiệu suất học tập của bạn.
            </p>
            <a asp-controller="Home" asp-action="Index" class="font-mono-xs text-muted-foreground link-plain mt-2 d-inline-block">
                ← Quay Lại Trang Chủ
            </a>
        </div>

        <!-- Pricing Grid -->
        <div class="row g-4 justify-content-center align-items-stretch" style="max-width: 1200px; margin: 0 auto;">
            
            <!-- Plan 1: Basic -->
            <div class="col-lg-4 col-md-6">
                <div class="soft-panel p-4 p-md-5 d-flex flex-column justify-content-between h-100 position-relative overflow-hidden" 
                     style="background: rgba(255, 255, 255, 0.45); border: 1px solid rgba(82, 39, 27, 0.08); border-radius: 28px; transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);"
                     onmouseover="this.style.transform='translateY(-6px)'; this.style.boxShadow='0 20px 40px rgba(82,39,27,0.06)'; this.style.borderColor='rgba(82,39,27,0.15)';"
                     onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none'; this.style.borderColor='rgba(82, 39, 27, 0.08)';">
                    <div>
                        <div class="font-mono-xs text-muted-foreground mb-2">TIÊU CHUẨN</div>
                        <h3 class="h3 fw-bold mb-3">Gói Basic</h3>
                        <p class="text-muted-foreground" style="font-size: 0.9rem; min-height: 48px;">Trải nghiệm hỏi đáp tài liệu miễn phí cơ bản mỗi ngày.</p>
                        
                        <div class="my-4">
                            <span class="display-5 fw-extrabold font-sans">0đ</span>
                            <span class="text-muted-foreground font-mono-xs"> / vĩnh viễn</span>
                        </div>
                        
                        <hr class="my-4" style="border-top: 1px solid rgba(82,39,27,0.08);" />
                        
                        <ul class="list-unstyled d-flex flex-column gap-3" style="font-size: 0.9rem;">
                            <li class="d-flex align-items-center gap-3">
                                <span class="rounded-circle d-flex align-items-center justify-content-center bg-dark text-white" style="width: 20px; height: 20px; background: var(--brown) !important;">✓</span>
                                <span><strong>10 câu hỏi</strong> / ngày</span>
                            </li>
                            <li class="d-flex align-items-center gap-3">
                                <span class="rounded-circle d-flex align-items-center justify-content-center bg-dark text-white" style="width: 20px; height: 20px; background: var(--brown) !important;">✓</span>
                                <span>Hỏi đáp tài liệu PDF cơ bản</span>
                            </li>
                            <li class="d-flex align-items-center gap-3">
                                <span class="rounded-circle d-flex align-items-center justify-content-center bg-dark text-white" style="width: 20px; height: 20px; background: var(--brown) !important;">✓</span>
                                <span>Tốc độ xử lý tiêu chuẩn</span>
                            </li>
                        </ul>
                    </div>
                    
                    <div class="mt-5">
                        <button class="btn btn-outline-dark pill-button w-100 py-3 fw-semibold" style="border-color: rgba(82,39,27,0.2);" disabled>
                            Đang Sử Dụng (Mặc Định)
                        </button>
                    </div>
                </div>
            </div>

            <!-- Plan 2: Plus (Highlighted) -->
            <div class="col-lg-4 col-md-6">
                <div class="soft-panel p-4 p-md-5 d-flex flex-column justify-content-between h-100 position-relative overflow-hidden glow-accent-border" 
                     style="background: rgba(255, 255, 255, 0.7); border: 2px solid var(--coral); border-radius: 28px; transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);"
                     onmouseover="this.style.transform='translateY(-6px)'; this.style.boxShadow='0 25px 50px rgba(216,106,88,0.15)';"
                     onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                    
                    <!-- Popular Badge -->
                    <div class="position-absolute px-3 py-1 text-white text-uppercase font-mono-xs fw-bold" 
                         style="top: 24px; right: 24px; background: var(--coral); border-radius: 12px; font-size: 0.65rem; letter-spacing: 0.1em;">
                        PHỔ BIẾN NHẤT
                    </div>

                    <div>
                        <div class="font-mono-xs fw-semibold mb-2" style="color: var(--coral);">NĂNG ĐỘNG</div>
                        <h3 class="h3 fw-bold mb-3">Gói Plus</h3>
                        <p class="text-muted-foreground" style="font-size: 0.9rem; min-height: 48px;">Lựa chọn tốt nhất cho sinh viên cần ôn tập liên tục và làm bài tập lớn.</p>
                        
                        <div class="my-4">
                            <span class="display-5 fw-extrabold font-sans" style="color: var(--brown);">150.000đ</span>
                            <span class="text-muted-foreground font-mono-xs"> / tháng</span>
                        </div>
                        
                        <hr class="my-4" style="border-top: 1px solid rgba(82,39,27,0.08);" />
                        
                        <ul class="list-unstyled d-flex flex-column gap-3" style="font-size: 0.9rem;">
                            <li class="d-flex align-items-center gap-3">
                                <span class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 20px; height: 20px; background: var(--coral) !important;">✓</span>
                                <span><strong>100 câu hỏi</strong> / ngày</span>
                            </li>
                            <li class="d-flex align-items-center gap-3">
                                <span class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 20px; height: 20px; background: var(--coral) !important;">✓</span>
                                <span>Hỏi đáp và trích xuất nguồn từ tài liệu lớn</span>
                            </li>
                            <li class="d-flex align-items-center gap-3">
                                <span class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 20px; height: 20px; background: var(--coral) !important;">✓</span>
                                <span>Tốc độ phản hồi AI siêu tốc</span>
                            </li>
                            <li class="d-flex align-items-center gap-3">
                                <span class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 20px; height: 20px; background: var(--coral) !important;">✓</span>
                                <span>Hỗ trợ định dạng Docx, Excel, PPTX nâng cao</span>
                            </li>
                        </ul>
                    </div>
                    
                    <div class="mt-5">
                        <button class="btn text-white w-100 py-3 fw-semibold pill-button shadow-sm" 
                                style="background: linear-gradient(135deg, var(--brown) 0%, var(--coral) 100%); border: none; transition: all 0.3s ease;"
                                onmouseover="this.style.opacity='0.95'; this.style.transform='scale(1.01)';"
                                onmouseout="this.style.opacity='1'; this.style.transform='scale(1)';"
                                onclick="alert('Cổng đăng ký đang được cập nhật (UI mẫu)')">
                            Đăng Ký Gói Plus
                        </button>
                    </div>
                </div>
            </div>

            <!-- Plan 3: Premium -->
            <div class="col-lg-4 col-md-6">
                <div class="soft-panel p-4 p-md-5 d-flex flex-column justify-content-between h-100 position-relative overflow-hidden" 
                     style="background: rgba(30, 24, 22, 0.95); color: white !important; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 28px; transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);"
                     onmouseover="this.style.transform='translateY(-6px)'; this.style.boxShadow='0 25px 50px rgba(0,0,0,0.3)'; this.style.borderColor='rgba(255,255,255,0.25)';"
                     onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none'; this.style.borderColor='rgba(255, 255, 255, 0.1)';">
                    <div>
                        <div class="font-mono-xs text-white-50 mb-2">DOANH NGHIỆP / THÀNH VIÊN VIP</div>
                        <h3 class="h3 fw-bold mb-3 text-white">Gói Premium</h3>
                        <p class="text-white-50" style="font-size: 0.9rem; min-height: 48px;">Trải nghiệm tuyệt đỉnh không giới hạn cho mọi nhu cầu nghiên cứu học thuật phức tạp nhất.</p>
                        
                        <div class="my-4">
                            <span class="display-5 fw-extrabold font-sans text-white">300.000đ</span>
                            <span class="text-white-50 font-mono-xs"> / tháng</span>
                        </div>
                        
                        <hr class="my-4" style="border-top: 1px solid rgba(255,255,255,0.1);" />
                        
                        <ul class="list-unstyled d-flex flex-column gap-3 text-white-50" style="font-size: 0.9rem;">
                            <li class="d-flex align-items-center gap-3">
                                <span class="rounded-circle d-flex align-items-center justify-content-center bg-white text-dark" style="width: 20px; height: 20px; font-weight: bold; background: white !important; color: var(--brown) !important;">✓</span>
                                <span class="text-white"><strong>Không giới hạn</strong> lượt truy vấn</span>
                            </li>
                            <li class="d-flex align-items-center gap-3">
                                <span class="rounded-circle d-flex align-items-center justify-content-center bg-white text-dark" style="width: 20px; height: 20px; font-weight: bold; background: white !important; color: var(--brown) !important;">✓</span>
                                <span class="text-white">Dung lượng file tải lên tối đa 100MB</span>
                            </li>
                            <li class="d-flex align-items-center gap-3">
                                <span class="rounded-circle d-flex align-items-center justify-content-center bg-white text-dark" style="width: 20px; height: 20px; font-weight: bold; background: white !important; color: var(--brown) !important;">✓</span>
                                <span class="text-white">Tốc độ xử lý AI cao cấp và ưu tiên số 1</span>
                            </li>
                            <li class="d-flex align-items-center gap-3">
                                <span class="rounded-circle d-flex align-items-center justify-content-center bg-white text-dark" style="width: 20px; height: 20px; font-weight: bold; background: white !important; color: var(--brown) !important;">✓</span>
                                <span class="text-white">Truy cập sớm các mô hình AI thông minh mới</span>
                            </li>
                        </ul>
                    </div>
                    
                    <div class="mt-5">
                        <button class="btn btn-light pill-button w-100 py-3 fw-semibold text-dark shadow-sm" 
                                style="transition: all 0.3s ease;"
                                onmouseover="this.style.transform='scale(1.01)';"
                                onmouseout="this.style.transform='scale(1)';"
                                onclick="alert('Cổng đăng ký đang được cập nhật (UI mẫu)')">
                            Đăng Ký Gói Premium
                        </button>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>
