@{
    ViewData["Title"] = "Bảng điều khiển";
    var recentDocuments = ViewBag.RecentDocuments as IEnumerable<dynamic> ?? [];
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <div class="kicker">— Bảng điều khiển</div>
        <h1 class="hero-title" style="font-size: clamp(2.5rem, 5vw, 4.5rem);">Tổng quan</h1>
        <p class="text-muted-foreground mt-2 mb-0">Theo dõi tài liệu, trạng thái upload và truy cập nhanh các phần chính.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-route="upload" class="btn btn-dark pill-button px-4 py-3" style="background:#d86a58;border-color:#d86a58;">Tải lên</a>
        <a asp-route="chat" class="btn btn-outline-dark pill-button px-4 py-3">Trò chuyện</a>
    </div>
</div>

<partial name="_UploadJobs" />

<div class="row g-4 mb-4">
    <div class="col-md-3"><div class="soft-panel editorial-shadow p-4"><div class="font-mono-xs text-muted-foreground">Tài liệu</div><div class="display-6 fw-semibold mt-2">@ViewBag.TotalDocuments</div></div></div>
    <div class="col-md-3"><div class="soft-panel editorial-shadow p-4"><div class="font-mono-xs text-muted-foreground">Chunks</div><div class="display-6 fw-semibold mt-2">@ViewBag.TotalChunks</div></div></div>
    <div class="col-md-3"><div class="soft-panel editorial-shadow p-4"><div class="font-mono-xs text-muted-foreground">Tệp</div><div class="display-6 fw-semibold mt-2">@ViewBag.TotalFiles</div></div></div>
    <div class="col-md-3"><div class="soft-panel editorial-shadow p-4"><div class="font-mono-xs text-muted-foreground">Đã duyệt</div><div class="display-6 fw-semibold mt-2">@ViewBag.ApprovedDocuments</div></div></div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="soft-panel editorial-shadow p-4 p-md-5 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Thao tác nhanh</h2>
                <div class="font-mono-xs text-muted-foreground">Không gian làm việc</div>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-route="upload" class="btn btn-dark pill-button px-4 py-3" style="background:#4a1f16;border-color:#4a1f16;">Tải lên</a>
                <a asp-controller="Documents" asp-action="MyDocuments" class="btn btn-outline-dark pill-button px-4 py-3">Thư viện</a>
                <a asp-route="chat" class="btn btn-outline-dark pill-button px-4 py-3">Trò chuyện</a>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="soft-panel editorial-shadow p-4 p-md-5 h-100">
            <h2 class="h5 mb-3">Tình trạng tài liệu</h2>
            <div class="d-flex justify-content-between mb-2"><span>Đã duyệt</span><strong>@ViewBag.ApprovedDocuments</strong></div>
            <div class="d-flex justify-content-between mb-2"><span>Đang chờ</span><strong>@ViewBag.PendingDocuments</strong></div>
            <div class="d-flex justify-content-between"><span>Từ chối</span><strong>@ViewBag.RejectedDocuments</strong></div>
        </div>
    </div>
</div>

<div class="soft-panel editorial-shadow p-4 p-md-5 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0">Tài liệu gần đây</h2>
        <a asp-controller="Documents" asp-action="MyDocuments" class="link-plain text-muted-foreground">Xem tất cả</a>
    </div>

    @if (recentDocuments.Any())
    {
        <div class="row g-3">
            @foreach (var doc in recentDocuments)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="file-card h-100">
                        <div class="fw-semibold text-truncate">@doc.Title</div>
                        <div class="file-subtle mt-1">@doc.Status · @doc.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                        <div class="font-mono-xs text-muted-foreground mt-3">@doc.FileCount tệp · @doc.ChunkCount chunks</div>
                        <div class="mt-3">
                            <a asp-controller="Documents" asp-action="Details" asp-route-id="@doc.Id" class="link-plain text-foreground">Xem chi tiết →</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-muted-foreground">Chưa có tài liệu nào.</div>
    }
</div>
