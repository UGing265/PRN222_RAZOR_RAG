@{
    ViewData["Title"] = "Bảng Điều Khiển";
}

<div class="page-shell grain">
    <div class="container-fluid px-4 px-md-5 py-4 py-md-5">
        <section class="soft-panel editorial-shadow p-4 p-md-5" style="background: rgba(255,255,255,.72);">
            <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
                <div>
                    <div class="kicker">— Dashboard</div>
                    <h1 class="hero-title mt-3 mb-2" style="font-size: clamp(2.4rem, 5vw, 4rem); line-height: .98;">Bảng Điều Khiển</h1>
                    <p class="text-muted-foreground mb-0">Đăng Nhập Hoặc Đăng Ký.</p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a class="btn btn-dark pill-button px-4 py-3" asp-controller="Auth" asp-action="Login" style="background:#4a1f16;border-color:#4a1f16;">Đăng Nhập</a>
                    <a class="btn btn-outline-dark pill-button px-4 py-3" asp-controller="Auth" asp-action="Register">Đăng Ký</a>
                </div>
            </div>
        </section>
    </div>
</div>
