                        <div class="d-grid gap-2">
                            <a asp-controller="Home" asp-action="Subscription" class="btn btn-premium-primary pill-button py-2.5 text-center fw-semibold" style="font-size: 0.85rem;" onclick="bootstrap.Modal.getInstance(document.getElementById('settingsModal')).hide();">
                                Nâng Cấp Gói Premium
                            </a>
                            <button type="button" class="btn btn-outline-dark pill-button py-2.5" data-bs-dismiss="modal" style="border-color: rgba(82,39,27,0.15); font-size: 0.85rem;">Đóng</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* Custom Settings Modal Tabs Styling */
#settingsModal #settingsTabs .nav-link.active {
    background-color: var(--brown) !important;
    color: white !important;
}
#settingsModal #settingsTabs .nav-link {
    color: var(--muted) !important;
}
#settingsModal #settingsTabs .nav-link:hover:not(.active) {
    background-color: rgba(82, 39, 27, 0.06) !important;
    color: var(--brown) !important;
}

/* Premium Glassmorphic Popout Profile Menu (Floating Dropup style) */
.profile-popout {
    position: fixed;
    bottom: 92px; /* Floats perfectly above the profile card */
    left: 14px;
    width: 252px;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(25px) saturate(180%);
    -webkit-backdrop-filter: blur(25px) saturate(180%);
    border: 1px solid rgba(82, 39, 27, 0.12);
    border-radius: 20px;
    box-shadow: 0 15px 35px rgba(74, 31, 22, 0.14), 0 3px 10px rgba(82, 39, 27, 0.04);
    padding: 10px;
    z-index: 1060;
    
    /* Animation transition */
    opacity: 0;
    visibility: hidden;
    transform: translateY(15px) scale(0.95);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.profile-popout.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
}

/* Individual list item styles */
.popout-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    color: var(--foreground);
    border-radius: 12px;
    font-size: 0.82rem;
    transition: all 0.2s ease;
    cursor: pointer;
    font-weight: 500;
}

.popout-item:hover, .hover-bg-profile-item:hover {
    background: rgba(82, 39, 27, 0.05) !important;
    color: var(--brown) !important;
}

.popout-item.text-danger:hover {
    background: rgba(220, 53, 69, 0.08) !important;
    color: #dc3545 !important;
}

/* Active style for profile card when popout is shown */
.profile-card-toggle[aria-expanded="true"] {
    background: rgba(255, 255, 255, 0.7) !important;
    border-color: rgba(82, 39, 27, 0.2) !important;
    box-shadow: 0 8px 24px rgba(82, 39, 27, 0.06) !important;
}

/* Premium Navigation Styling Overrides */
.sidebar .nav-link {
    color: var(--muted) !important;
    font-weight: 500;
    font-size: 0.88rem;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    border-radius: 14px;
    margin-bottom: 2px;
    background: transparent !important;
    border: 1px solid transparent;
}

.sidebar .nav-link .nav-icon {
    opacity: 0.75;
    transition: all 0.25s ease;
}

/* Hover State */
.sidebar .nav-link:hover:not(.active) {
    background: rgba(255, 255, 255, 0.45) !important;
    color: var(--brown) !important;
    transform: translateX(4px);
    border-color: rgba(82, 39, 27, 0.04);
}

.sidebar .nav-link:hover:not(.active) .nav-icon {
    opacity: 1;
    transform: scale(1.05);
}

/* Active State */
.sidebar .nav-link.active {
    background: var(--brown) !important;
    color: #ffffff !important;
    font-weight: 600;
    box-shadow: 0 4px 12px rgba(74, 31, 22, 0.15);
    transform: translateX(0);
}

.sidebar .nav-link.active .nav-icon {
    color: #ffffff !important;
    opacity: 1;
}

/* Sidebar Width and Animation Transitions */
.shell {
    display: grid !important;
    grid-template-columns: 250px 1fr !important;
    transition: grid-template-columns 0.35s cubic-bezier(0.25, 1, 0.5, 1) !important;
}

.sidebar {
    width: 100% !important;
    padding: 18px 12px !important;
    transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1) !important;
    overflow-x: hidden !important;
}

/* Collapsed Sidebar (Slim Mini-Sidebar) States */
.shell.collapsed {
    grid-template-columns: 72px 1fr !important;
}

.shell.collapsed .sidebar {
    padding: 18px 8px !important;
}

.shell.collapsed .sidebar-text {
    opacity: 0 !important;
    width: 0 !important;
    height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    pointer-events: none !important;
    display: none !important;
}

.shell.collapsed .sidebar .nav-link span {
    display: none !important;
}

.shell.collapsed .sidebar .nav-link {
    width: 44px !important;
    height: 44px !important;
    padding: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin: 0 auto !important;
    border-radius: 12px !important;
    transform: none !important;
}

.shell.collapsed .sidebar .nav-link .nav-icon {
    margin: 0 !important;
    width: 20px !important;
    height: 20px !important;
}

.shell.collapsed .sidebar-header-row {
    justify-content: center !important;
    margin-bottom: 24px !important;
}

.shell.collapsed #collapseSidebarBtn {
    margin: 0 auto !important;
}

.shell.collapsed .profile-card-toggle {
    width: 44px !important;
    height: 44px !important;
    padding: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin: 0 auto !important;
    border-radius: 12px !important;
    background: transparent !important;
    border-color: transparent !important;
}

.shell.collapsed #sidebarAvatar {
    width: 36px !important;
    height: 36px !important;
    font-size: 0.95rem !important;
}

.shell.collapsed .profile-popout {
    left: 80px !important;
    bottom: 12px !important;
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
    // Sidebar Collapse / Expand Functionality
    const shell = document.querySelector('.shell');
    const collapseBtn = document.getElementById('collapseSidebarBtn');
    
    if (shell) {
        // Load preference
        const isCollapsed = localStorage.getItem('sidebar_collapsed') === 'true';
        if (isCollapsed) {
            shell.classList.add('collapsed');
        }
        
        if (collapseBtn) {
            collapseBtn.addEventListener('click', function() {
                const willCollapse = !shell.classList.contains('collapsed');
                if (willCollapse) {
                    shell.classList.add('collapsed');
                    localStorage.setItem('sidebar_collapsed', 'true');
                } else {
                    shell.classList.remove('collapsed');
                    localStorage.setItem('sidebar_collapsed', 'false');
                }
            });
        }
    }

    const settingsModal = document.getElementById('settingsModal');
    const profileCard = document.getElementById('profileCard');
    const profilePopout = document.getElementById('profilePopout');
    const chevronIcon = profileCard ? profileCard.querySelector('.chevron-icon') : null;

    if (profileCard && profilePopout) {
        profileCard.addEventListener('click', function(e) {
            e.stopPropagation();
            const isOpen = profilePopout.classList.contains('show');
            if (isOpen) {
                closePopout();
            } else {
                openPopout();
            }
        });

        function openPopout() {
            profilePopout.classList.add('show');
            profileCard.setAttribute('aria-expanded', 'true');
            if (chevronIcon) {
                chevronIcon.style.transform = 'rotate(-180deg)';
            }
        }

        function closePopout() {
            profilePopout.classList.remove('show');
            profileCard.setAttribute('aria-expanded', 'false');
            if (chevronIcon) {
                chevronIcon.style.transform = 'rotate(0deg)';
            }
        }

        // Close on clicking outside
        document.addEventListener('click', function(e) {
            if (!profilePopout.contains(e.target) && !profileCard.contains(e.target)) {
                closePopout();
            }
        });

        // Close on pressing Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closePopout();
            }
        });

        // Close when settings modal opens
        if (settingsModal) {
            settingsModal.addEventListener('show.bs.modal', function() {
                closePopout();
            });
        }
    }

    if (settingsModal) {
        settingsModal.addEventListener('show.bs.modal', function(event) {
            const button = event.relatedTarget;
            const targetTab = button ? button.getAttribute('data-bs-target-tab') : 'profile';
            
            if (targetTab === 'subscription') {
                const subscriptionTabTrigger = document.querySelector('#subscription-tab');
                if (subscriptionTabTrigger) {
                    bootstrap.Tab.getInstance(subscriptionTabTrigger)?.show() || new bootstrap.Tab(subscriptionTabTrigger).show();
                }
            } else {
                const profileTabTrigger = document.querySelector('#profile-tab');
                if (profileTabTrigger) {
                    bootstrap.Tab.getInstance(profileTabTrigger)?.show() || new bootstrap.Tab(profileTabTrigger).show();
                }
            }
        });
    }

    const profileForm = document.getElementById('editProfileForm');
    if (profileForm) {
        profileForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const newName = document.getElementById('inputFullName').value.trim();
            if (newName) {
                const sidebarFullName = document.getElementById('sidebarFullName');
                const sidebarAvatar = document.getElementById('sidebarAvatar');
                const modalAvatarCircle = document.getElementById('modalAvatarCircle');
                
                if (sidebarFullName) sidebarFullName.textContent = newName;
                if (sidebarAvatar) sidebarAvatar.textContent = newName.charAt(0).toUpperCase();
                if (modalAvatarCircle) modalAvatarCircle.textContent = newName.charAt(0).toUpperCase();
                
                const existingAlert = profileForm.querySelector('.alert');
                if (existingAlert) existingAlert.remove();

                const alertDiv = document.createElement('div');
                alertDiv.className = 'alert alert-success alert-dismissible fade show mt-3 mb-0 py-2.5 px-3 border-0 rounded-3 shadow-sm';
                alertDiv.role = 'alert';
                alertDiv.style.fontSize = '0.8rem';
                alertDiv.style.backgroundColor = '#ecfdf5';
                alertDiv.style.color = '#065f46';
                alertDiv.innerHTML = '<strong>Thành công!</strong> Đã cập nhật hồ sơ.<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="padding: 0.6rem 0.75rem;"></button>';
                
                profileForm.appendChild(alertDiv);
                
                setTimeout(() => {
                    bootstrap.Alert.getInstance(alertDiv)?.close() || alertDiv.remove();
                }, 3000);
            }
        });
    }
});
</script>
