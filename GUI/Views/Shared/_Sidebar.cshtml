@using System.Security.Claims
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string IsActive(string c, string? a = null) => controller == c && (a is null || action == a) ? "active" : string.Empty;
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
    var roleId = short.TryParse(User?.FindFirstValue("role_id"), out var parsedRoleId) ? parsedRoleId : (short)0;
    var fullName = User?.FindFirstValue(ClaimTypes.Name) ?? "Người dùng";
    var email = User?.FindFirstValue(ClaimTypes.Email) ?? string.Empty;
    var roleLabel = roleId switch
    {
        1 => "Admin",
        2 => "Giảng viên",
        3 => "Sinh viên",
        _ => "Khách"
    };
    var canSeeDocuments = isAuthenticated && (roleId == 1 || roleId == 2);
    var canCreateDocuments = isAuthenticated && (roleId == 1 || roleId == 2);
    var canSeeAllPages = isAuthenticated && roleId == 1;
}

<aside class="sidebar">
    <div>
        <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center gap-3 text-decoration-none text-foreground mb-4">
            <span class="brand-mark">S</span>
            <div class="lh-sm">
                <div class="fw-semibold">StudyMate AI</div>
                <div class="font-mono-xs text-muted-foreground">Không Gian Làm Việc</div>
            </div>
        </a>

        <div class="font-mono-xs text-muted-foreground mb-2">Điều Hướng</div>
        <nav class="nav flex-column gap-1">
            <a class="nav-link @IsActive("Home", "Index")" asp-controller="Home" asp-action="Index">Trang Chủ</a>
            @if (isAuthenticated)
            {
                if (canCreateDocuments)
                {
                    <a class="nav-link @IsActive("Documents", "Create")" asp-controller="Documents" asp-action="Create">Tải Lên</a>
                }
                if (canSeeDocuments)
                {
                    <a class="nav-link @IsActive("Documents", "MyDocuments")" asp-controller="Documents" asp-action="MyDocuments">Thư Viện Của Tôi</a>
                }
                if (roleId == 1 || roleId == 3)
                {
                    <a class="nav-link @IsActive("Chat", "Index")" asp-controller="Chat" asp-action="Index">Trò Chuyện AI</a>
                }
                <a class="nav-link @IsActive("Documents", "AllDocuments")" asp-controller="Documents" asp-action="AllDocuments">Tất Cả Tài Liệu</a>
                if (canSeeAllPages)
                {
                    <a class="nav-link @IsActive("Dashboard", "Index")" asp-controller="Dashboard" asp-action="Index">Bảng Điều Khiển</a>
                }
            }
            else
            {
                <a class="nav-link @IsActive("Auth", "Login")" asp-controller="Auth" asp-action="Login">Đăng Nhập</a>
                <a class="nav-link @IsActive("Auth", "Register")" asp-controller="Auth" asp-action="Register">Đăng Ký</a>
            }
        </nav>
    </div>

    <div>
        @if (isAuthenticated)
        {
            <!-- Upgrade Promo Card -->
            <a asp-controller="Home" asp-action="Subscription" class="text-decoration-none d-block mb-3">
                <div class="p-3 rounded-4 shadow-sm text-white d-flex align-items-center justify-content-between" 
                     style="background: linear-gradient(135deg, var(--brown) 0%, var(--coral) 100%); transition: all 0.3s ease; border: 1px solid rgba(255,255,255,0.1);"
                     onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 10px 20px rgba(216, 106, 88, 0.2)';"
                     onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                    <div style="max-width: 75%;">
                        <div class="fw-bold" style="font-size: 0.85rem;">Nâng cấp Premium</div>
                        <div style="font-size: 0.7rem; opacity: 0.85;">Mở khóa câu hỏi vô hạn & tài liệu lớn</div>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-white" style="width: 32px; height: 32px; color: var(--coral);">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    </div>
                </div>
            </a>

            <!-- Interactive & Collapsible Profile Card -->
            <div class="profile-card-toggle" id="profileCard" data-bs-toggle="collapse" data-bs-target="#profileCollapse" aria-expanded="false" aria-controls="profileCollapse" style="cursor: pointer;">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm flex-shrink-0" 
                             id="sidebarAvatar"
                             style="width: 42px; height: 42px; font-size: 1.1rem; background: var(--brown) !important;">
                            @fullName.Substring(0, 1).ToUpper()
                        </div>
                        <div class="lh-sm overflow-hidden" style="max-width: 140px;">
                            <div class="fw-bold text-truncate text-foreground" id="sidebarFullName" style="font-size: 0.9rem;">@fullName</div>
                            <div class="small text-muted-foreground text-truncate" id="sidebarRole" style="font-size: 0.75rem;">@roleLabel</div>
                        </div>
                    </div>
                    <!-- Animated Chevron Icon -->
                    <svg class="chevron-icon flex-shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </div>
                
                <!-- Collapsible body -->
                <div class="collapse" id="profileCollapse">
                    <div class="pt-3 mt-3 border-top" style="border-top-color: rgba(82, 39, 27, 0.08) !important;">
                        <!-- Query usage counter & progress bar -->
                        <div class="p-3 bg-white mb-3" style="border: 1px solid rgba(82, 39, 27, 0.04); font-size: 0.8rem; border-radius: 16px; cursor: default;" onclick="event.stopPropagation();">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted-foreground">Truy vấn hôm nay:</span>
                                <span class="fw-semibold">4 / 10 lượt</span>
                            </div>
                            <div class="progress" style="height: 5px; border-radius: 10px; background-color: rgba(82, 39, 27, 0.08);">
                                <div class="progress-bar" role="progressbar" style="width: 40%; background-color: var(--coral);" aria-valuenow="4" aria-valuemin="0" aria-valuemax="10"></div>
                            </div>
                            <div class="font-mono-xs text-muted-foreground mt-2" style="font-size: 8px;">GÓI ĐANG DÙNG: BASIC</div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-grid gap-1.5" style="font-size: 0.8rem;" onclick="event.stopPropagation();">
                            <button type="button" data-bs-toggle="modal" data-bs-target="#settingsModal" data-bs-target-tab="subscription" class="btn btn-sm btn-outline-dark pill-button py-1.5 w-100 d-flex align-items-center justify-content-center gap-1.5" style="border-color: rgba(82, 39, 27, 0.15);">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                                Gói Dịch Vụ
                            </button>
                            <button type="button" data-bs-toggle="modal" data-bs-target="#settingsModal" data-bs-target-tab="profile" class="btn btn-sm btn-outline-dark pill-button py-1.5 w-100 d-flex align-items-center justify-content-center gap-1.5" style="border-color: rgba(82, 39, 27, 0.15);">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                                Cài Đặt
                            </button>
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="w-100 mt-1">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm pill-button w-100 py-1.5">Đăng Xuất</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="sidebar-card" style="background: rgba(255,255,255,.32); border: 1px solid rgba(82,39,27,.08);">
                <div class="fw-semibold">Chưa Đăng Nhập</div>
                <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-dark btn-sm pill-button w-100 mt-3">Đăng Nhập</a>
            </div>
        }
    </div>
</aside>

<!-- Account Settings Modal -->
<div class="modal fade" id="settingsModal" tabindex="-1" aria-labelledby="settingsModalLabel" aria-hidden="true" style="backdrop-filter: blur(8px); background: rgba(74, 31, 22, 0.15);">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
        <div class="modal-content border-0 shadow-lg" style="background: var(--card); border-radius: 24px; color: var(--foreground); overflow: hidden;">
            
            <!-- Modal Header -->
            <div class="modal-header border-0 p-4 pb-0 d-flex justify-content-between align-items-center">
                <h5 class="modal-title fw-bold" id="settingsModalLabel" style="font-size: 1.2rem; color: var(--brown);">Cài Đặt Tài Khoản</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="background-color: rgba(82, 39, 27, 0.05); padding: 0.75rem; border-radius: 50%;"></button>
            </div>
            
            <!-- Modal Body -->
            <div class="modal-body p-4">
                <!-- Navigation Tabs -->
                <ul class="nav nav-pills mb-4 p-1.5 rounded-pill bg-light d-flex gap-1" id="settingsTabs" role="tablist" style="background: rgba(82,39,27,0.05) !important;">
                    <li class="nav-item flex-fill" role="presentation">
                        <button class="nav-link w-100 rounded-pill fw-semibold py-2 active" id="profile-tab" data-bs-toggle="pill" data-bs-target="#profile-panel" type="button" role="tab" aria-controls="profile-panel" aria-selected="true" style="font-size: 0.85rem;">
                            Hồ Sơ Của Tôi
                        </button>
                    </li>
                    <li class="nav-item flex-fill" role="presentation">
                        <button class="nav-link w-100 rounded-pill fw-semibold py-2" id="subscription-tab" data-bs-toggle="pill" data-bs-target="#subscription-panel" type="button" role="tab" aria-controls="subscription-panel" aria-selected="false" style="font-size: 0.85rem;">
                            Gói Dịch Vụ
                        </button>
                    </li>
                </ul>
                
                <div class="tab-content" id="settingsTabContent">
                    <!-- Tab 1: Edit Profile -->
                    <div class="tab-pane fade show active" id="profile-panel" role="tabpanel" aria-labelledby="profile-tab">
                        <form id="editProfileForm">
                            <div class="text-center mb-4">
                                <div class="position-relative d-inline-block">
                                    <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm mx-auto mb-2" 
                                         id="modalAvatarCircle"
                                         style="width: 72px; height: 72px; font-size: 1.8rem; background: var(--brown) !important;">
                                        @fullName.Substring(0, 1).ToUpper()
                                    </div>
                                </div>
                                <div class="small text-muted-foreground">@email</div>
                            </div>
                            
                            <div class="mb-3">
                                <label for="inputFullName" class="form-label small fw-semibold text-muted-foreground">Họ và Tên</label>
                                <input type="text" class="form-control pill-input px-3" id="inputFullName" value="@fullName" required style="border-color: rgba(82, 39, 27, 0.12);" />
                            </div>
                            
                            <div class="mb-3">
                                <label for="inputRole" class="form-label small fw-semibold text-muted-foreground">Vai Trò / Đối Tượng</label>
                                <select class="form-select pill-input px-3" id="inputRole" style="border-color: rgba(82, 39, 27, 0.12);" disabled>
                                    <option selected>@roleLabel</option>
                                </select>
                                <div class="form-text text-muted-foreground" style="font-size: 0.75rem;">Vai trò được cấp bởi hệ thống quản trị.</div>
                            </div>
                            
                            <div class="d-flex justify-content-end gap-2 mt-4">
                                <button type="button" class="btn btn-outline-dark pill-button px-4 py-2" data-bs-dismiss="modal" style="border-color: rgba(82,39,27,0.15); font-size: 0.85rem;">Hủy</button>
                                <button type="submit" class="btn btn-premium-primary pill-button px-4 py-2" style="font-size: 0.85rem;">Lưu Thay Đổi</button>
                            </div>
                        </form>
                    </div>
                    
                    <!-- Tab 2: Active Subscription details -->
                    <div class="tab-pane fade" id="subscription-panel" role="tabpanel" aria-labelledby="subscription-tab">
                        <div class="p-4 rounded-4 text-white mb-4 d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, var(--brown) 0%, var(--coral) 100%);">
                            <div>
                                <div class="font-mono-xs opacity-75 mb-1" style="font-size: 10px;">GÓI HIỆN TẠI</div>
                                <h3 class="fw-bold m-0" style="font-size: 1.4rem;">Basic Member</h3>
                                <div class="mt-2 small opacity-90">Truy vấn: <strong>4 / 10 lượt</strong> hôm nay</div>
                            </div>
                            <div class="rounded-circle d-flex align-items-center justify-content-center bg-white" style="width: 44px; height: 44px; color: var(--coral);">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                            </div>
                        </div>
                        
                        <div class="mb-4">
                            <h6 class="fw-bold mb-3" style="color: var(--brown); font-size: 0.95rem;">Tính năng khả dụng:</h6>
                            <ul class="list-unstyled d-flex flex-column gap-2.5 small" style="color: var(--foreground); padding-left: 0;">
                                <li class="d-flex align-items-center gap-2.5">
                                    <span class="rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0" style="width: 18px; height: 18px; background: var(--coral) !important; font-size: 0.65rem;">✓</span>
                                    <span>Hỏi đáp <strong>10 câu hỏi</strong> / ngày</span>
                                </li>
                                <li class="d-flex align-items-center gap-2.5">
                                    <span class="rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0" style="width: 18px; height: 18px; background: var(--coral) !important; font-size: 0.65rem;">✓</span>
                                    <span>Hỏi đáp tài liệu PDF cơ bản</span>
                                </li>
                                <li class="d-flex align-items-center gap-2.5">
                                    <span class="rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0" style="width: 18px; height: 18px; background: var(--coral) !important; font-size: 0.65rem;">✓</span>
                                    <span>Tốc độ phản hồi AI tiêu chuẩn</span>
                                </li>
                            </ul>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <a asp-controller="Home" asp-action="Subscription" class="btn btn-premium-primary pill-button py-2.5 text-center fw-semibold" style="font-size: 0.85rem;" onclick="bootstrap.Modal.getInstance(document.getElementById('settingsModal')).hide();">
                                Nâng Cấp Gói Premium
                            </a>
                            <button type="button" class="btn btn-outline-dark pill-button py-2.5" data-bs-dismiss="modal" style="border-color: rgba(82,39,27,0.15); font-size: 0.85rem;">Đóng</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* Custom Settings Modal Tabs Styling */
#settingsModal #settingsTabs .nav-link.active {
    background-color: var(--brown) !important;
    color: white !important;
}
#settingsModal #settingsTabs .nav-link {
    color: var(--muted) !important;
}
#settingsModal #settingsTabs .nav-link:hover:not(.active) {
    background-color: rgba(82, 39, 27, 0.06) !important;
    color: var(--brown) !important;
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const settingsModal = document.getElementById('settingsModal');
    if (settingsModal) {
        settingsModal.addEventListener('show.bs.modal', function(event) {
            const button = event.relatedTarget;
            const targetTab = button ? button.getAttribute('data-bs-target-tab') : 'profile';
            
            if (targetTab === 'subscription') {
                const subscriptionTabTrigger = document.querySelector('#subscription-tab');
                if (subscriptionTabTrigger) {
                    bootstrap.Tab.getInstance(subscriptionTabTrigger)?.show() || new bootstrap.Tab(subscriptionTabTrigger).show();
                }
            } else {
                const profileTabTrigger = document.querySelector('#profile-tab');
                if (profileTabTrigger) {
                    bootstrap.Tab.getInstance(profileTabTrigger)?.show() || new bootstrap.Tab(profileTabTrigger).show();
                }
            }
        });
    }

    const profileForm = document.getElementById('editProfileForm');
    if (profileForm) {
        profileForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const newName = document.getElementById('inputFullName').value.trim();
            if (newName) {
                const sidebarFullName = document.getElementById('sidebarFullName');
                const sidebarAvatar = document.getElementById('sidebarAvatar');
                const modalAvatarCircle = document.getElementById('modalAvatarCircle');
                
                if (sidebarFullName) sidebarFullName.textContent = newName;
                if (sidebarAvatar) sidebarAvatar.textContent = newName.charAt(0).toUpperCase();
                if (modalAvatarCircle) modalAvatarCircle.textContent = newName.charAt(0).toUpperCase();
                
                const existingAlert = profileForm.querySelector('.alert');
                if (existingAlert) existingAlert.remove();

                const alertDiv = document.createElement('div');
                alertDiv.className = 'alert alert-success alert-dismissible fade show mt-3 mb-0 py-2.5 px-3 border-0 rounded-3 shadow-sm';
                alertDiv.role = 'alert';
                alertDiv.style.fontSize = '0.8rem';
                alertDiv.style.backgroundColor = '#ecfdf5';
                alertDiv.style.color = '#065f46';
                alertDiv.innerHTML = '<strong>Thành công!</strong> Đã cập nhật hồ sơ.<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="padding: 0.6rem 0.75rem;"></button>';
                
                profileForm.appendChild(alertDiv);
                
                setTimeout(() => {
                    bootstrap.Alert.getInstance(alertDiv)?.close() || alertDiv.remove();
                }, 3000);
            }
        });
    }
});
</script>
