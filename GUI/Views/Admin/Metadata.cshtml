@section Scripts {
    <script>
        function openEditSubjectModal(id, code, name, termId) {
            document.getElementById('editSubjectId').value = id;
            document.getElementById('editSubjectCode').value = code;
            document.getElementById('editSubjectName').value = name;
            document.getElementById('editSubjectTermId').value = termId || '';
            new bootstrap.Modal(document.getElementById('editSubjectModal')).show();
        }

        function openDeleteSubjectModal(id, code) {
            document.getElementById('deleteSubjectId').value = id;
            document.getElementById('deleteSubjectCodeDisplay').textContent = code;
            new bootstrap.Modal(document.getElementById('deleteSubjectModal')).show();
        }

        function openEditTermModal(id, name, order) {
            document.getElementById('editTermId').value = id;
            document.getElementById('editTermName').value = name;
            document.getElementById('editTermOrder').value = order;
            new bootstrap.Modal(document.getElementById('editTermModal')).show();
        }

        function openDeleteTermModal(id, name) {
            document.getElementById('deleteTermId').value = id;
            document.getElementById('deleteTermNameDisplay').textContent = name;
            new bootstrap.Modal(document.getElementById('deleteTermModal')).show();
        }

        function openEditDocumentTypeModal(id, name, description) {
            document.getElementById('editDocumentTypeId').value = id;
            document.getElementById('editDocumentTypeName').value = name;
            document.getElementById('editDocumentTypeDescription').value = description;
            new bootstrap.Modal(document.getElementById('editDocumentTypeModal')).show();
        }

        function openDeleteDocumentTypeModal(id, name) {
            document.getElementById('deleteDocumentTypeId').value = id;
            document.getElementById('deleteDocumentTypeNameDisplay').textContent = name;
            new bootstrap.Modal(document.getElementById('deleteDocumentTypeModal')).show();
        }

        function openEditLanguageModal(id, code, name) {
            document.getElementById('editLanguageId').value = id;
            document.getElementById('editLanguageCode').value = code;
            document.getElementById('editLanguageName').value = name;
            new bootstrap.Modal(document.getElementById('editLanguageModal')).show();
        }

        function openDeleteLanguageModal(id, name) {
            document.getElementById('deleteLanguageId').value = id;
            document.getElementById('deleteLanguageNameDisplay').textContent = name;
            new bootstrap.Modal(document.getElementById('deleteLanguageModal')).show();
        }

        function openEditDocumentSourceModal(id, name) {
            document.getElementById('editDocumentSourceId').value = id;
            document.getElementById('editDocumentSourceName').value = name;
            new bootstrap.Modal(document.getElementById('editDocumentSourceModal')).show();
        }

        function openDeleteDocumentSourceModal(id, name) {
            document.getElementById('deleteDocumentSourceId').value = id;
            document.getElementById('deleteDocumentSourceNameDisplay').textContent = name;
            new bootstrap.Modal(document.getElementById('deleteDocumentSourceModal')).show();
        }
    </script>
}
