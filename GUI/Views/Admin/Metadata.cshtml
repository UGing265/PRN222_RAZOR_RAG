                <div class="modal-body text-center p-4">
                    <input type="hidden" id="deleteLanguageId" name="id" />
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#dc3545" stroke-width="2" class="mb-3"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    <h5 class="fw-bold mb-2">Xác nhận xóa?</h5>
                    <p class="text-muted small mb-4">Bạn có chắc chắn muốn xóa ngôn ngữ <strong id="deleteLanguageNameDisplay"></strong> không?</p>
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-light pill-button" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-danger pill-button">Xóa</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Document Source Modals -->
<div class="modal fade" id="editDocumentSourceModal" tabindex="-1" aria-hidden="true">
