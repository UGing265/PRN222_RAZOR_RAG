@model GUI.Models.Documents.AllDocumentsViewModel

@{
    ViewData["Title"] = "Khám phá tài liệu";
    var query = ViewBag.Query as string;
}

<style>
    /* Premium Khám Phá Portal Styling */
    .explore-card {
        background: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(82, 39, 27, 0.06);
        border-radius: 22px;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
    }

    .explore-card:hover {
        transform: translateY(-6px);
        background: rgba(255, 255, 255, 0.95);
        border-color: rgba(216, 106, 88, 0.2);
        box-shadow: 0 20px 40px rgba(74, 31, 22, 0.05);
    }

    .explore-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, var(--brown) 0%, var(--coral) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .explore-card:hover::before {
        opacity: 1;
    }

    .subject-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 99px;
        background: rgba(216, 106, 88, 0.08) !important;
        color: var(--coral) !important;
        font-size: 0.72rem;
        font-weight: 600;
        padding: 4px 12px;
        border: 1px solid rgba(216, 106, 88, 0.1);
    }

    .author-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8rem;
        color: var(--muted);
    }

    .author-avatar {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: var(--brown);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.65rem;
    }

    .search-glass-panel {
        background: rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(82, 39, 27, 0.06);
        border-radius: 24px;
        transition: all 0.3s ease;
        position: relative;
        z-index: 100;
    }

    .search-glass-panel:focus-within {
        background: rgba(255, 255, 255, 0.85);
        border-color: rgba(216, 106, 88, 0.3);
        box-shadow: 0 10px 25px rgba(82, 39, 27, 0.04);
    }

    .search-input-clean {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        font-size: 0.95rem;
        color: var(--foreground);
    }

    .search-input-clean::placeholder {
        color: var(--muted);
        opacity: 0.7;
    }

    /* Minimal Pill Filters */
    .filter-chip {
        display: inline-flex;
        align-items: center;
        padding: 6px 16px;
        border-radius: 99px;
        font-size: 0.82rem;
        font-weight: 500;
        color: var(--muted);
        background: rgba(255, 255, 255, 0.4);
        border: 1px solid rgba(82, 39, 27, 0.06);
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .filter-chip:hover {
        background: rgba(255, 255, 255, 0.8);
        color: var(--brown);
        border-color: rgba(82, 39, 27, 0.12);
        transform: translateY(-1px);
    }

    .filter-chip.active {
        background: var(--brown);
        color: #ffffff;
        border-color: var(--brown);
    }

    .card-footer-action {
        border-top: 1px solid rgba(82, 39, 27, 0.05);
        padding-top: 14px;
        margin-top: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .read-doc-btn {
        color: var(--brown);
        font-weight: 600;
        font-size: 0.85rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
    }

    .read-doc-btn:hover {
        color: var(--coral);
    }

    .read-doc-btn:hover svg {
        transform: translateX(4px);
    }

    .read-doc-btn svg {
        transition: transform 0.2s ease;
    }

    /* Premium Dropdown Styling */
    .premium-dropdown-menu {
        background: rgba(255, 255, 255, 0.94) !important;
        backdrop-filter: blur(16px) !important;
        -webkit-backdrop-filter: blur(16px) !important;
        border: 1px solid rgba(82, 39, 27, 0.08) !important;
        border-radius: 16px !important;
        padding: 8px !important;
        box-shadow: 0 10px 30px rgba(82, 39, 27, 0.08) !important;
        min-width: 200px !important;
        margin-top: 8px !important;
        z-index: 1050 !important;
    }

    .premium-dropdown-item {
        color: var(--brown) !important;
        font-size: 0.85rem !important;
        font-weight: 500 !important;
        padding: 8px 16px !important;
        border-radius: 10px !important;
        transition: all 0.2s ease !important;
        cursor: pointer !important;
    }

    .premium-dropdown-item:hover {
        background: rgba(216, 106, 88, 0.08) !important;
        color: var(--coral) !important;
    }

    .premium-dropdown-item.active {
        background: var(--brown) !important;
        color: #ffffff !important;
    }

    .dropdown-toggle-premium {
        color: var(--brown) !important;
        font-weight: 500 !important;
        font-size: 0.88rem !important;
        text-decoration: none !important;
        display: flex !important;
        align-items: center !important;
        gap: 6px !important;
        border: 0 !important;
        background: transparent !important;
        padding: 6px 12px !important;
    }

    .dropdown-toggle-premium::after {
        color: var(--muted) !important;
        transition: transform 0.2s ease !important;
    }

    .dropdown-toggle-premium:hover::after {
        transform: translateY(2px);
    }
</style>

<div class="page-shell grain">
    <div class="container-fluid px-4 px-md-5 py-4 py-md-5" style="max-width: 1200px;">
        
        <!-- Header Banner Section -->
        <div class="mb-5 text-center text-md-start">
            <span class="font-mono-xs text-coral-deep" style="font-weight: 700; letter-spacing: 0.15em;">PORTAL KHÁM PHÁ</span>
            <h1 class="hero-title mt-2 mb-3" style="font-size: clamp(2.2rem, 5vw, 3.2rem); color: var(--brown); line-height: 1.1;">Kho Tàng Kiến Thức</h1>
            <p class="text-muted-foreground fs-5 mb-0" style="max-width: 600px; font-weight: 400; line-height: 1.6;">
                Khám phá và tham khảo các tài liệu học tập, giáo trình công khai chất lượng từ cộng đồng và giảng viên.
            </p>
        </div>

        <!-- Sleek Unified Search & Reset bar -->
        <form method="get" asp-action="AllDocuments" class="search-glass-panel p-2 mb-4 d-flex align-items-center gap-3">
            <div class="d-flex align-items-center flex-grow-1 ps-2">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text" name="q" value="@query" class="form-control search-input-clean px-3 py-2 w-100" placeholder="Tìm tiêu đề tài liệu..." />
            </div>

            <!-- Subject Dropdown Filter -->
            <input type="hidden" name="subject" id="selectedSubjectInput" value="@ViewBag.SelectedSubject" />
            <div class="dropdown pe-2 border-start d-flex align-items-center" style="border-color: rgba(0,0,0,0.12) !important;">
                <button class="dropdown-toggle-premium" type="button" id="subjectDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    @(string.IsNullOrWhiteSpace(ViewBag.SelectedSubject) ? "Tất cả môn học" : ViewBag.SelectedSubject)
                </button>
                <ul class="dropdown-menu premium-dropdown-menu dropdown-menu-end shadow-lg" aria-labelledby="subjectDropdown">
                    <li>
                        <a class="dropdown-item premium-dropdown-item @(string.IsNullOrWhiteSpace(ViewBag.SelectedSubject) ? "active" : "")" onclick="selectSubject('')">
                            Tất cả môn học
                        </a>
                    </li>
                    @if (ViewBag.Subjects is List<string> subjects)
                    {
                        foreach (var sub in subjects)
                        {
                            <li>
                                <a class="dropdown-item premium-dropdown-item @(ViewBag.SelectedSubject == sub ? "active" : "")" onclick="selectSubject('@sub')">
                                    @sub
                                </a>
                            </li>
                        }
                    }
                </ul>
            </div>
            
            <div class="d-flex align-items-center gap-2 flex-shrink-0 pe-1">
                @if (!string.IsNullOrWhiteSpace(query) || !string.IsNullOrWhiteSpace(ViewBag.SelectedSubject))
                {
                    <a asp-action="AllDocuments" class="btn btn-link text-muted px-2 text-decoration-none small hover-text-dark" style="font-size: 0.88rem;">Xoá Lọc</a>
                }
                <button type="submit" class="btn btn-premium-primary pill-button py-2 px-4" style="font-size: 0.88rem; min-height: 40px;">Tìm Kiếm</button>
            </div>
        </form>

        <!-- Dynamic Filter Chips -->
        <div class="d-flex align-items-center gap-2 flex-wrap mb-5">
            <span class="text-muted small me-2" style="font-size: 0.8rem; font-weight: 500;">Gợi ý chủ đề:</span>
            @if (ViewBag.Subjects is List<string> suggSubjects && suggSubjects.Any())
            {
                @foreach (var sub in suggSubjects.Take(5))
                {
                    <a href="?subject=@sub" class="filter-chip @(ViewBag.SelectedSubject == sub ? "active" : "")">@sub</a>
                }
            }
            else
            {
                <span class="text-muted small" style="font-size: 0.8rem; font-style: italic;">Chưa có chủ đề nào</span>
            }
            
            <span class="ms-auto font-mono-xs text-muted-foreground" style="font-size: 11px;">
                Tìm thấy <strong>@Model.TotalDocuments</strong> kết quả
            </span>
        </div>

        <!-- Elegant Document Cards Grid -->
        @if (Model.Documents.Count == 0)
        {
            <div class="text-center py-5 rounded-4" style="background: rgba(255,255,255,0.3); border: 1px dashed rgba(82, 39, 27, 0.12);">
                <div class="mb-3 text-muted-foreground">
                    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/>
                    </svg>
                </div>
                <h5 class="fw-semibold text-dark">Không tìm thấy tài liệu phù hợp</h5>
                <p class="text-muted-foreground small">Vui lòng thử từ khóa khác hoặc xóa lọc để xem toàn bộ danh mục.</p>
                <a asp-action="AllDocuments" class="btn btn-outline-dark btn-sm pill-button px-4 py-2 mt-2">Xem Tất Cả</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model.Documents)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="explore-card h-100 p-4">
                            <div>
                                <!-- Top Badges & Subject info -->
                                <div class="d-flex align-items-center justify-content-between gap-2 mb-3 flex-wrap">
                                    <span class="subject-badge">
                                        @(string.IsNullOrWhiteSpace(item.Subject) ? "Tài liệu học tập" : item.Subject)
                                    </span>
                                    <span class="font-mono-xs text-muted-foreground" style="font-size: 10px;">
                                        @item.UpdatedAt.ToString("dd/MM/yyyy")
                                    </span>
                                </div>

                                <!-- Document Title -->
                                <h4 class="fw-bold mb-2 text-truncate-2" style="font-size: 1.15rem; color: var(--brown); line-height: 1.35; min-height: 2.7rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" title="@item.Title">
                                    @item.Title
                                </h4>

                                <!-- Document Excerpt -->
                                <p class="text-muted-foreground small mb-4 text-truncate-3" style="line-height: 1.55; min-height: 3.5rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                    @(string.IsNullOrWhiteSpace(item.PreviewText) ? "Bản xem trước tài liệu hiện chưa khả dụng. Nhấp mở để xem chi tiết nội dung." : item.PreviewText)
                                </p>
                            </div>

                            <!-- Footer Section -->
                            <div class="card-footer-action">
                                <div class="author-badge">
                                    <div class="author-avatar">
                                        @((string.IsNullOrWhiteSpace(item.OwnerEmail) ? "U" : item.OwnerEmail.Substring(0, 1)).ToUpper())
                                    </div>
                                    <span class="text-truncate" style="max-width: 130px;" title="@item.OwnerEmail">
                                        @(string.IsNullOrWhiteSpace(item.OwnerEmail) ? "Anonymous" : item.OwnerEmail.Split('@')[0])
                                    </span>
                                </div>

                                <a asp-controller="Documents" asp-action="Details" asp-route-slug="@item.Slug" class="read-doc-btn">
                                    <span>Đọc tài liệu</span>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Premium Minimalist Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav class="d-flex justify-content-center mt-5">
                    <ul class="pagination gap-2 border-0">
                        <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                            <a class="page-link pill-button px-3 py-2 border-0" href="?q=@(query)&subject=@(ViewBag.SelectedSubject)&page=@(Model.Page - 1)" style="border-radius: 12px; color: var(--brown); background: rgba(255,255,255,0.4); font-size: 0.85rem;">
                                Trước
                            </a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.Page == i ? "active" : "")">
                                <a class="page-link pill-button px-3.5 py-2 border-0" href="?q=@(query)&subject=@(ViewBag.SelectedSubject)&page=@i" 
                                   style="border-radius: 12px; font-size: 0.85rem; font-weight: 600; @(Model.Page == i ? "background: var(--brown) !important; color: #fff !important;" : "color: var(--brown); background: rgba(255,255,255,0.4);")">
                                    @i
                                </a>
                            </li>
                        }
                        <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link pill-button px-3 py-2 border-0" href="?q=@(query)&subject=@(ViewBag.SelectedSubject)&page=@(Model.Page + 1)" style="border-radius: 12px; color: var(--brown); background: rgba(255,255,255,0.4); font-size: 0.85rem;">
                                Sau
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        function selectSubject(subject) {
            const input = document.getElementById('selectedSubjectInput');
            if (input) {
                input.value = subject;
                input.form.submit();
            }
        }
    </script>
}
