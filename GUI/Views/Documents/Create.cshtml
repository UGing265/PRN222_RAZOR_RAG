@model GUI.Models.Documents.DocumentCreateViewModel

@{
    ViewData["Title"] = "Tải Lên";
}

<div class="page-shell grain">
    <div class="container-fluid px-4 px-md-5 py-4 py-md-5" style="max-width: 980px;">
        <div class="soft-panel editorial-shadow p-4 p-md-4" style="background: rgba(255,255,255,.72);">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h1 class="hero-title mb-0" style="font-size: clamp(1.9rem, 3vw, 2.5rem);">Tải Lên</h1>
                <a asp-controller="Documents" asp-action="MyDocuments" class="link-plain text-muted-foreground font-mono-xs">Thư Viện</a>
            </div>

            <form asp-action="Create" method="post" enctype="multipart/form-data" id="uploadForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                <div class="chunk-card mb-3 text-center" id="uploadDropzone" role="button" tabindex="0">
                    <div class="d-flex justify-content-center mb-3">
                        <div class="d-flex align-items-center justify-content-center rounded-circle" style="width:72px;height:72px;background:var(--coral-soft);color:var(--coral);font-size:28px;">⇪</div>
                    </div>
                    <h2 class="h5 fw-semibold mb-1">Kéo file vào đây</h2>
                    <p class="text-muted-foreground mb-2 small">PDF, DOC, DOCX, PPT, PPTX</p>
                    <input asp-for="UploadFile" type="file" class="d-none" id="uploadFileInput" accept=".pdf,.doc,.docx,.ppt,.pptx" />
                    <div id="selectedFileName" class="font-mono-xs text-muted-foreground">Chưa chọn file</div>
                </div>
                <span asp-validation-for="UploadFile" class="text-danger small d-block mb-3"></span>

                <div class="row g-2">
                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label font-mono-xs text-muted-foreground"></label>
                        <input asp-for="Title" class="form-control pill-input" placeholder="Tiêu đề" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Subject" class="form-label font-mono-xs text-muted-foreground"></label>
                        <input asp-for="Subject" class="form-control pill-input" placeholder="Môn / Chủ đề" />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="School" class="form-label font-mono-xs text-muted-foreground"></label>
                        <input asp-for="School" class="form-control pill-input" placeholder="Trường" />
                        <span asp-validation-for="School" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Department" class="form-label font-mono-xs text-muted-foreground"></label>
                        <input asp-for="Department" class="form-control pill-input" placeholder="Khoa / Phòng ban" />
                        <span asp-validation-for="Department" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Language" class="form-label font-mono-xs text-muted-foreground"></label>
                        <input asp-for="Language" class="form-control pill-input" placeholder="vi / en" />
                        <span asp-validation-for="Language" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Visibility" class="form-label font-mono-xs text-muted-foreground"></label>
                        <select asp-for="Visibility" class="form-select pill-input">
                            <option value="private">Riêng Tư</option>
                            <option value="public">Công Khai</option>
                            <option value="internal">Nội Bộ</option>
                        </select>
                        <span asp-validation-for="Visibility" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="SourceType" class="form-label font-mono-xs text-muted-foreground"></label>
                        <input asp-for="SourceType" class="form-control pill-input" placeholder="Nguồn" />
                        <span asp-validation-for="SourceType" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label font-mono-xs text-muted-foreground"></label>
                        <input asp-for="Description" class="form-control pill-input" placeholder="Mô tả ngắn" />
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 mt-3 flex-wrap">
                    <button type="submit" class="btn btn-dark pill-button px-4 py-3" style="background:#4a1f16;border-color:#4a1f16;">Tải Lên</button>
                </div>

                <div id="uploadProgressShell" class="mt-3 d-none">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="font-mono-xs text-muted-foreground">Đang tải lên nền</div>
                        <div class="font-mono-xs text-muted-foreground" id="uploadProgressLabel">0%</div>
                    </div>
                    <div class="progress" style="height: 10px; border-radius: 9999px; background: rgba(82,39,27,.08);">
                        <div id="uploadProgressBar" class="progress-bar" role="progressbar" style="width: 0%; background: linear-gradient(90deg, #d86a58, #4a1f16);"></div>
                    </div>
                    <div class="font-mono-xs text-muted-foreground mt-2" id="uploadProgressMeta">Đang chuẩn bị...</div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const dropzone = document.getElementById('uploadDropzone');
            const input = document.getElementById('uploadFileInput');
            const fileLabel = document.getElementById('selectedFileName');
            const form = document.getElementById('uploadForm');
            const progressShell = document.getElementById('uploadProgressShell');
            const progressBar = document.getElementById('uploadProgressBar');
            const progressLabel = document.getElementById('uploadProgressLabel');
            const progressMeta = document.getElementById('uploadProgressMeta');
            if (!dropzone || !input || !fileLabel || !form || !progressShell || !progressBar || !progressLabel || !progressMeta) return;

            const updateLabel = () => {
                fileLabel.textContent = input.files && input.files.length ? input.files[0].name : 'Chưa chọn file';
            };

            dropzone.addEventListener('click', () => input.click());
            dropzone.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    input.click();
                }
            });
            input.addEventListener('change', updateLabel);

            form.addEventListener('submit', async (e) => {
                if (!input.files || input.files.length === 0) return;
                e.preventDefault();

                progressShell.classList.remove('d-none');
                progressBar.style.width = '0%';
                progressLabel.textContent = '0%';
                progressMeta.textContent = 'Đang đẩy file vào hàng đợi...';

                let current = 0;
                const timer = setInterval(() => {
                    current = Math.min(95, current + Math.max(3, Math.floor(Math.random() * 12)));
                    progressBar.style.width = `${current}%`;
                    progressLabel.textContent = `${current}%`;
                    progressMeta.textContent = current < 40 ? 'Đang tải file...' : current < 80 ? 'Đang xử lý tài liệu...' : 'Đang hoàn tất...';
                }, 220);

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    clearInterval(timer);

                    if (!response.ok) {
                        throw new Error('Upload failed');
                    }

                    const data = await response.json();
                    progressBar.style.width = '100%';
                    progressLabel.textContent = '100%';
                    progressMeta.textContent = 'Hoàn tất. Đang chuyển trang...';
                    window.location.href = data.redirectUrl || '/dashboard';
                } catch (error) {
                    clearInterval(timer);
                    form.submit();
                }
            });
        })();
    </script>
}
