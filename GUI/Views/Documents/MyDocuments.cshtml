@model GUI.Models.Documents.MyDocumentsViewModel

@{
    ViewData["Title"] = "Thư viện của tôi";
    
    string GetStatusClass(string status) => status?.ToLower() switch
    {
        "pending" => "status-pending",
        "approved" => "status-approved",
        "rejected" => "status-rejected",
        _ => "bg-light text-dark"
    };

    string GetStatusText(string status) => status?.ToLower() switch
    {
        "pending" => "Chờ Duyệt",
        "approved" => "Đã Duyệt",
        "rejected" => "Từ Chối",
        _ => status
    };
}

<style>
    /* Premium Library Portal Styling */
    .library-card {
        background: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(82, 39, 27, 0.06);
        border-radius: 22px;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
    }

    .library-card:hover {
        transform: translateY(-6px);
        background: rgba(255, 255, 255, 0.95);
        border-color: rgba(216, 106, 88, 0.2);
        box-shadow: 0 20px 40px rgba(74, 31, 22, 0.05);
    }

    .library-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, var(--brown) 0%, var(--coral) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .library-card:hover::before {
        opacity: 1;
    }

    .subject-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 99px;
        background: rgba(216, 106, 88, 0.08) !important;
        color: var(--coral) !important;
        font-size: 0.72rem;
        font-weight: 600;
        padding: 4px 12px;
        border: 1px solid rgba(216, 106, 88, 0.1);
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 99px;
        font-size: 0.72rem;
        font-weight: 600;
        padding: 4px 12px;
    }

    .status-pending {
        background: rgba(255, 193, 7, 0.1) !important;
        color: #b58900 !important;
        border: 1px solid rgba(255, 193, 7, 0.15);
    }

    .status-approved {
        background: rgba(40, 167, 69, 0.1) !important;
        color: #28a745 !important;
        border: 1px solid rgba(40, 167, 69, 0.15);
    }

    .status-rejected {
        background: rgba(220, 53, 69, 0.1) !important;
        color: #dc3545 !important;
        border: 1px solid rgba(220, 53, 69, 0.15);
    }

    .metric-card {
        background: rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(82, 39, 27, 0.06);
        border-radius: 20px;
        padding: 16px 20px;
        transition: all 0.3s ease;
    }

    .metric-card:hover {
        background: rgba(255, 255, 255, 0.75);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(82, 39, 27, 0.03);
    }

    .card-footer-action {
        border-top: 1px solid rgba(82, 39, 27, 0.05);
        padding-top: 14px;
        margin-top: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .action-btn-outline {
        border-radius: 99px;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 6px 14px;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .action-btn-danger {
        border-radius: 99px;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 6px 14px;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #dc3545;
        border: 1px solid rgba(220, 53, 69, 0.2);
        background: transparent;
    }

    .action-btn-danger:hover {
        background: #dc3545;
        color: #ffffff;
        border-color: #dc3545;
    }

    .progress-glass {
        background: rgba(255, 255, 255, 0.45);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(82, 39, 27, 0.06);
        border-radius: 24px;
    }

    /* Premium Search & Filter Styling */
    .search-glass-panel {
        background: rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(82, 39, 27, 0.06);
        border-radius: 24px;
        transition: all 0.3s ease;
        position: relative;
        z-index: 100;
    }

    .search-glass-panel:focus-within {
        background: rgba(255, 255, 255, 0.85);
        border-color: rgba(216, 106, 88, 0.3);
        box-shadow: 0 10px 25px rgba(82, 39, 27, 0.04);
    }

    .search-input-clean {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        font-size: 0.95rem;
        color: var(--foreground);
    }

    .search-input-clean::placeholder {
        color: var(--muted);
        opacity: 0.7;
    }

    .filter-chip {
        display: inline-flex;
        align-items: center;
        padding: 6px 16px;
        border-radius: 99px;
        font-size: 0.82rem;
        font-weight: 500;
        color: var(--muted);
        background: rgba(255, 255, 255, 0.4);
        border: 1px solid rgba(82, 39, 27, 0.06);
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .filter-chip:hover {
        background: rgba(255, 255, 255, 0.8);
        color: var(--brown);
        border-color: rgba(82, 39, 27, 0.12);
        transform: translateY(-1px);
    }

    .filter-chip.active {
        background: var(--brown);
        color: #ffffff;
        border-color: var(--brown);
    }

    /* Premium Dropdown Styling */
    .premium-dropdown-menu {
        background: rgba(255, 255, 255, 0.94) !important;
        backdrop-filter: blur(16px) !important;
        -webkit-backdrop-filter: blur(16px) !important;
        border: 1px solid rgba(82, 39, 27, 0.08) !important;
        border-radius: 16px !important;
        padding: 8px !important;
        box-shadow: 0 10px 30px rgba(82, 39, 27, 0.08) !important;
        min-width: 200px !important;
        margin-top: 8px !important;
        z-index: 1050 !important;
    }

    .premium-dropdown-item {
        color: var(--brown) !important;
        font-size: 0.85rem !important;
        font-weight: 500 !important;
        padding: 8px 16px !important;
        border-radius: 10px !important;
        transition: all 0.2s ease !important;
        cursor: pointer !important;
    }

    .premium-dropdown-item:hover {
        background: rgba(216, 106, 88, 0.08) !important;
        color: var(--coral) !important;
    }

    .premium-dropdown-item.active {
        background: var(--brown) !important;
        color: #ffffff !important;
    }

    .dropdown-toggle-premium {
        color: var(--brown) !important;
        font-weight: 500 !important;
        font-size: 0.88rem !important;
        text-decoration: none !important;
        display: flex !important;
        align-items: center !important;
        gap: 6px !important;
        border: 0 !important;
        background: transparent !important;
        padding: 6px 12px !important;
    }

    .dropdown-toggle-premium::after {
        color: var(--muted) !important;
        transition: transform 0.2s ease !important;
    }

    .dropdown-toggle-premium:hover::after {
        transform: translateY(2px);
    }
</style>

<div class="page-shell grain">
    <div class="container-fluid px-4 px-md-5 py-4 py-md-5" style="max-width: 1200px;">
        
        <!-- Header Section -->
        <div class="d-flex align-items-center justify-content-between mb-5 flex-wrap gap-3">
            <div>
                <span class="font-mono-xs text-coral-deep" style="font-weight: 700; letter-spacing: 0.15em;">KHÔNG GIAN CÁ NHÂN</span>
                <h1 class="hero-title mt-2 mb-0" style="font-size: clamp(2.2rem, 5vw, 3.2rem); color: var(--brown); line-height: 1.1;">Thư Viện Của Tôi</h1>
            </div>
            <div class="d-flex gap-2 flex-shrink-0">
                <a asp-controller="Documents" asp-action="Create" class="btn btn-premium-primary pill-button px-4 py-3 d-inline-flex align-items-center gap-2" style="font-size: 0.9rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    Tải Lên Tài Liệu
                </a>
            </div>
        </div>

        <!-- Processing Queue Status Panel -->
        <div class="progress-glass p-4 mb-5 shadow-sm">
            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="spinner-grow spinner-grow-sm text-coral-deep" role="status" aria-hidden="true"></span>
                    <h2 class="h5 mb-0 fw-semibold" style="color: var(--brown);">Đang Xử Lý Nền (AI Parsing)</h2>
                </div>
                <span class="badge rounded-pill bg-light text-dark font-mono-xs px-3 py-2 border" id="uploadJobCount" style="letter-spacing: 0.05em;">@Model.ActiveUploadJobs.Count TIẾN TRÌNH</span>
            </div>
            <div id="uploadJobList" class="d-grid gap-3">
                <partial name="_UploadJobs" model="Model.ActiveUploadJobs" />
            </div>
        </div>

        <!-- Metric Dashboard Cards -->
        <div class="row g-3 mb-5">
            <div class="col-6 col-md-3">
                <div class="metric-card h-100">
                    <div class="font-mono-xs text-muted-foreground mb-1" style="font-size: 9px;">TỔNG TÀI LIỆU</div>
                    <div class="h2 fw-bold mb-0" style="color: var(--brown);">@Model.TotalDocuments</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="metric-card h-100">
                    <div class="font-mono-xs text-muted-foreground mb-1" style="font-size: 9px;">ĐANG CHỜ DUYỆT</div>
                    <div class="h2 fw-bold mb-0" style="color: #ff9f1c;">@Model.PendingDocuments</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="metric-card h-100">
                    <div class="font-mono-xs text-muted-foreground mb-1" style="font-size: 9px;">ĐÃ PHÊ DUYỆT</div>
                    <div class="h2 fw-bold mb-0" style="color: #2ec4b6;">@Model.ApprovedDocuments</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="metric-card h-100">
                    <div class="font-mono-xs text-muted-foreground mb-1" style="font-size: 9px;">BỊ TỪ CHỐI</div>
                    <div class="h2 fw-bold mb-0" style="color: #e71d36;">@Model.RejectedDocuments</div>
                </div>
            </div>
        </div>

        <!-- Sleek Unified Search & Reset bar -->
        <form method="get" asp-action="MyDocuments" class="search-glass-panel p-2 mb-4 d-flex align-items-center gap-3">
            <div class="d-flex align-items-center flex-grow-1 ps-2">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text" name="q" value="@ViewBag.Query" class="form-control search-input-clean px-3 py-2 w-100" placeholder="Tìm tiêu đề tài liệu..." />
            </div>

            <!-- Subject Dropdown Filter -->
            <input type="hidden" name="subject" id="selectedSubjectInput" value="@ViewBag.SelectedSubject" />
            <div class="dropdown pe-2 border-start d-flex align-items-center" style="border-color: rgba(0,0,0,0.12) !important;">
                <button class="dropdown-toggle-premium" type="button" id="subjectDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    @(string.IsNullOrWhiteSpace(ViewBag.SelectedSubject) ? "Tất cả môn học" : ViewBag.SelectedSubject)
                </button>
                <ul class="dropdown-menu premium-dropdown-menu dropdown-menu-end shadow-lg" aria-labelledby="subjectDropdown">
                    <li>
                        <a class="dropdown-item premium-dropdown-item @(string.IsNullOrWhiteSpace(ViewBag.SelectedSubject) ? "active" : "")" onclick="selectSubject('')">
                            Tất cả môn học
                        </a>
                    </li>
                    @if (ViewBag.Subjects is List<string> subjects)
                    {
                        foreach (var sub in subjects)
                        {
                            <li>
                                <a class="dropdown-item premium-dropdown-item @(ViewBag.SelectedSubject == sub ? "active" : "")" onclick="selectSubject('@sub')">
                                    @sub
                                </a>
                            </li>
                        }
                    }
                </ul>
            </div>
            
            <div class="d-flex align-items-center gap-2 flex-shrink-0 pe-1">
                @if (!string.IsNullOrWhiteSpace(ViewBag.Query) || !string.IsNullOrWhiteSpace(ViewBag.SelectedSubject))
                {
                    <a asp-action="MyDocuments" class="btn btn-link text-muted px-2 text-decoration-none small hover-text-dark" style="font-size: 0.88rem;">Xoá Lọc</a>
                }
                <button type="submit" class="btn btn-premium-primary pill-button py-2 px-4" style="font-size: 0.88rem; min-height: 40px;">Tìm Kiếm</button>
            </div>
        </form>

        <!-- Dynamic Filter Chips -->
        <div class="d-flex align-items-center gap-2 flex-wrap mb-5">
            <span class="text-muted small me-2" style="font-size: 0.8rem; font-weight: 500;">Gợi ý chủ đề:</span>
            @if (ViewBag.Subjects is List<string> suggSubjects && suggSubjects.Any())
            {
                @foreach (var sub in suggSubjects.Take(5))
                {
                    <a href="?subject=@sub" class="filter-chip @(ViewBag.SelectedSubject == sub ? "active" : "")">@sub</a>
                }
            }
            else
            {
                <span class="text-muted small" style="font-size: 0.8rem; font-style: italic;">Chưa có chủ đề nào</span>
            }
            
            <span class="ms-auto font-mono-xs text-muted-foreground" style="font-size: 11px;">
                Tìm thấy <strong>@Model.TotalDocuments</strong> tài liệu của bạn
            </span>
        </div>

        <!-- Document Grid -->
        <div class="row g-4">
            @if (Model.Documents.Count == 0)
            {
                <div class="col-12 text-center py-5">
                    <div class="p-5 progress-glass text-muted d-inline-block rounded-4">
                        @if (!string.IsNullOrWhiteSpace(ViewBag.Query) || !string.IsNullOrWhiteSpace(ViewBag.SelectedSubject))
                        {
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-3 text-muted" style="opacity: 0.5;">
                                <circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/>
                            </svg>
                            <p class="mb-0 fw-medium">Không tìm thấy tài liệu phù hợp trong không gian cá nhân của bạn.</p>
                            <a asp-action="MyDocuments" class="btn btn-outline-dark btn-sm pill-button mt-3 px-4">Xem Tất Cả</a>
                        }
                        else
                        {
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-3 text-muted" style="opacity: 0.5;">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
                            </svg>
                            <p class="mb-0 fw-medium">Bạn chưa tải lên tài liệu nào trong thư viện cá nhân.</p>
                            <a asp-action="Create" class="btn btn-outline-dark btn-sm pill-button mt-3 px-4">Tải Lên Ngay</a>
                        }
                    </div>
                </div>
            }
            else
            {
                @foreach (var item in Model.Documents.OrderByDescending(x => x.UpdatedAt))
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="library-card h-100 p-4">
                            <div>
                                <!-- Subject Badge and Status -->
                                <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                                    <span class="subject-badge">
                                        @(string.IsNullOrWhiteSpace(item.Subject) ? "Tài Liệu Chung" : item.Subject)
                                    </span>
                                    <span class="status-badge @GetStatusClass(item.Status)">
                                        @GetStatusText(item.Status)
                                    </span>
                                </div>
                                
                                <!-- Document Title -->
                                <h3 class="fw-semibold text-foreground text-truncate-2" style="font-size: 1.15rem; color: var(--brown); margin-bottom: 12px; height: 2.8rem; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" title="@item.Title">
                                    @item.Title
                                </h3>
                            </div>
                            
                            <!-- Card Actions and Meta Details -->
                            <div>
                                <div class="card-footer-action">
                                    <span class="font-mono-xs text-muted-foreground" style="font-size: 0.72rem;">
                                        @item.UpdatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                    
                                    <div class="d-flex align-items-center gap-1">
                                        <a asp-action="Details" asp-route-slug="@item.Slug" class="action-btn-outline btn btn-outline-dark" style="padding: 5px 12px;">
                                            Xem
                                        </a>
                                        <a asp-action="Edit" asp-route-slug="@item.Slug" class="action-btn-outline btn btn-outline-secondary" style="padding: 5px 12px;">
                                            Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-slug="@item.Slug" class="action-btn-danger" style="padding: 5px 12px;">
                                            Xoá
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Premium Minimalist Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav class="d-flex justify-content-center mt-5">
                <ul class="pagination gap-2 border-0">
                    <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                        <a class="page-link pill-button px-3 py-2 border-0" href="?q=@(ViewBag.Query)&subject=@(ViewBag.SelectedSubject)&page=@(Model.Page - 1)" style="border-radius: 12px; color: var(--brown); background: rgba(255,255,255,0.4); font-size: 0.85rem;">
                            Trước
                        </a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.Page == i ? "active" : "")">
                            <a class="page-link pill-button px-3.5 py-2 border-0" href="?q=@(ViewBag.Query)&subject=@(ViewBag.SelectedSubject)&page=@i" 
                               style="border-radius: 12px; font-size: 0.85rem; font-weight: 600; @(Model.Page == i ? "background: var(--brown) !important; color: #fff !important;" : "color: var(--brown); background: rgba(255,255,255,0.4);")">
                                @i
                            </a>
                        </li>
                    }
                    <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link pill-button px-3 py-2 border-0" href="?q=@(ViewBag.Query)&subject=@(ViewBag.SelectedSubject)&page=@(Model.Page + 1)" style="border-radius: 12px; color: var(--brown); background: rgba(255,255,255,0.4); font-size: 0.85rem;">
                            Sau
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

@section Scripts {
    <script>
        function selectSubject(subject) {
            const input = document.getElementById('selectedSubjectInput');
            if (input) {
                input.value = subject;
                input.form.submit();
            }
        }

        (function () {
            const list = document.getElementById('uploadJobList');
            const count = document.getElementById('uploadJobCount');
            if (!list || !count) return;

            const refreshJobs = async () => {
                try {
                    const response = await fetch('/documents/mine', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!response.ok) return;
                    const html = await response.text();
                    list.innerHTML = html;
                    const items = list.querySelectorAll('[data-upload-job]');
                    count.textContent = `${items.length} TIẾN TRÌNH`;
                } catch (_) {
                }
            };

            setInterval(refreshJobs, 5000);
        })();
    </script>
}
