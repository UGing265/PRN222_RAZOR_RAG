@model GUI.Models.Documents.MyDocumentsViewModel

@{
    ViewData["Title"] = "Thư Viện";
}

<div class="page-shell grain">
    <div class="container-fluid px-4 px-md-5 py-4 py-md-5" style="max-width: 1200px;">
        <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
            <div>
                <h1 class="hero-title mb-0" style="font-size: clamp(2rem, 4vw, 3rem);">Thư Viện</h1>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Documents" asp-action="Create" class="btn btn-dark pill-button px-4 py-3" style="background:#4a1f16;border-color:#4a1f16;">Tải Lên</a>
            </div>
        </div>

        <div class="soft-panel editorial-shadow p-4 mb-4" style="background: rgba(255,255,255,.72);">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="h5 mb-0">Đang xử lý nền</h2>
                <span class="font-mono-xs text-muted-foreground" id="uploadJobCount">@Model.ActiveUploadJobs.Count job</span>
            </div>
            <div id="uploadJobList" class="d-grid gap-3">
                <partial name="_UploadJobs" model="Model.ActiveUploadJobs" />
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-3"><div class="file-card"><div class="font-mono-xs text-muted-foreground">Tổng</div><div class="h3 fw-semibold mb-0">@Model.TotalDocuments</div></div></div>
            <div class="col-md-3"><div class="file-card"><div class="font-mono-xs text-muted-foreground">Đang Chờ</div><div class="h3 fw-semibold mb-0">@Model.PendingDocuments</div></div></div>
            <div class="col-md-3"><div class="file-card"><div class="font-mono-xs text-muted-foreground">Đã Duyệt</div><div class="h3 fw-semibold mb-0">@Model.ApprovedDocuments</div></div></div>
            <div class="col-md-3"><div class="file-card"><div class="font-mono-xs text-muted-foreground">Từ Chối</div><div class="h3 fw-semibold mb-0">@Model.RejectedDocuments</div></div></div>
        </div>

        <div class="row g-3">
            @foreach (var item in Model.Documents.OrderByDescending(x => x.UpdatedAt))
            {
                <div class="col-md-6 col-xl-4">
                    <div class="file-card h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between gap-3 mb-3">
                                <div class="fw-semibold text-truncate">@item.Title</div>
                                <span class="font-mono-xs text-muted-foreground">@item.Status</span>
                            </div>
                            <div class="text-muted-foreground small mb-3">@(string.IsNullOrWhiteSpace(item.Subject) ? "—" : item.Subject)</div>
                            <div class="font-mono-xs text-muted-foreground">@item.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <a asp-action="Details" asp-route-slug="@item.Slug" class="btn btn-outline-dark btn-sm pill-button">Mở</a>
                            <a asp-action="Delete" asp-route-slug="@item.Slug" class="btn btn-outline-dark btn-sm pill-button">Xoá</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const list = document.getElementById('uploadJobList');
            const count = document.getElementById('uploadJobCount');
            if (!list || !count) return;

            const refreshJobs = async () => {
                try {
                    const response = await fetch('/documents/mine', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!response.ok) return;
                    const html = await response.text();
                    list.innerHTML = html;
                    const items = list.querySelectorAll('[data-upload-job]');
                    count.textContent = `${items.length} job`;
                } catch (_) {
                }
            };

            setInterval(refreshJobs, 5000);
        })();
    </script>
}
