@model GUI.Models.Documents.MyDocumentsViewModel

@{
    ViewData["Title"] = "Thư viện tài liệu";
}

<div class="page-shell grain">
    <div class="container-fluid px-4 px-md-5 py-3 py-md-4">
        <div class="d-flex align-items-center justify-content-between mb-4 small text-muted-foreground">
            <div class="d-flex align-items-center gap-2">
                <span style="width:10px;height:10px;border-radius:9999px;border:1px solid rgba(82,39,27,.25);display:inline-block;"></span>
                <span>Thư viện tài liệu</span>
            </div>
            <div>SWD392 · FPT University</div>
        </div>

        <partial name="_UploadJobs" />

        <section class="soft-panel editorial-shadow p-4 p-md-5 mb-4" style="background: rgba(255,248,245,.8);">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                <div>
                    <div class="font-mono-xs text-muted-foreground mb-3">Issue №04 · Thư viện</div>
                    <h1 class="hero-title mb-3" style="font-size: clamp(3rem, 7vw, 5rem);">Thư viện <span class="font-serif-italic text-coral-deep">tri thức.</span></h1>
                    <p class="text-muted-foreground col-lg-8 mb-0">
                        Mỗi tài liệu là một bài viết — đã được parse, chunk và index. Sẵn sàng để trích dẫn.
                    </p>
                </div>
                <a asp-controller="Documents" asp-action="Create" class="btn btn-dark pill-button px-4 py-3 d-inline-flex align-items-center gap-2" style="background: #4a1f16; border-color:#4a1f16;">
                    <span>Tải lên mới</span>
                    <span class="badge rounded-pill text-bg-light text-dark">+@Model.TotalDocuments</span>
                </a>
            </div>

            <div class="row g-0 overflow-hidden" style="border-radius: 28px; border: 1px solid rgba(82,39,27,.08); background: rgba(255,255,255,.55);">
                <div class="col-md-3 p-4 border-end border-border">
                    <div class="font-mono-xs text-muted-foreground mb-2">Tài liệu</div>
                    <div class="display-6 fw-semibold">@Model.TotalDocuments</div>
                </div>
                <div class="col-md-3 p-4 border-end border-border">
                    <div class="font-mono-xs text-muted-foreground mb-2">Đã index</div>
                    <div class="display-6 fw-semibold">@Model.ApprovedDocuments <span class="text-coral-deep">•</span></div>
                </div>
                <div class="col-md-3 p-4 border-end border-border">
                    <div class="font-mono-xs text-muted-foreground mb-2">Tổng chunks</div>
                    <div class="display-6 fw-semibold">@Model.TotalChunks</div>
                </div>
                <div class="col-md-3 p-4">
                    <div class="font-mono-xs text-muted-foreground mb-2">Tệp</div>
                    <div class="display-6 fw-semibold">@Model.TotalFiles</div>
                </div>
            </div>

            <form asp-action="MyDocuments" method="get" class="d-flex justify-content-between align-items-center gap-3 flex-wrap mt-4">
                <div class="soft-panel px-3 py-2 flex-grow-1" style="max-width: 620px; background: rgba(255,255,255,.65);">
                    <div class="d-flex align-items-center gap-2 text-muted-foreground">
                        <span>⌕</span>
                        <input name="q" value="@(ViewBag.Query as string ?? string.Empty)" class="border-0 bg-transparent w-100 outline-0" placeholder="Tìm theo tên, môn học hoặc trường..." style="box-shadow:none;" />
                    </div>
                </div>
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <div class="d-flex align-items-center gap-2">
                    <span class="font-mono-xs text-muted-foreground">Trang @Model.Page / @Model.TotalPages</span>
                    <button type="submit" class="btn btn-dark pill-button btn-sm px-3" style="background:#4a1f16;border-color:#4a1f16;">Tìm</button>
                    <a asp-action="MyDocuments" asp-route-page="@Math.Max(1, Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-q="@(ViewBag.Query as string)" class="btn btn-outline-dark pill-button btn-sm px-3 @(Model.Page <= 1 ? "disabled" : "")">Trước</a>
                    <a asp-action="MyDocuments" asp-route-page="@Math.Min(Model.TotalPages, Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-q="@(ViewBag.Query as string)" class="btn btn-outline-dark pill-button btn-sm px-3 @(Model.Page >= Model.TotalPages ? "disabled" : "")">Sau</a>
                </div>
            </form>
        </section>

        <section>
            <div class="d-flex justify-content-between align-items-end mb-3">
                <h2 class="h4 mb-0">Danh sách <span class="font-serif-italic text-coral-deep">đầy đủ</span></h2>
                <div class="font-mono-xs text-muted-foreground">@Model.Documents.Count mục</div>
            </div>

            <div class="row g-3 g-md-4">
                @foreach (var item in Model.Documents.OrderByDescending(x => x.UpdatedAt))
                {
                    var preview = item.PreviewText ?? string.Empty;
                    if (preview.Length > 140) { preview = preview[..140] + "…"; }
                    <div class="col-md-6 col-xl-4">
                        <article class="soft-panel editorial-shadow p-4 h-100" style="border-radius: 28px;">
                            <div class="d-flex justify-content-between align-items-start mb-4">
                                <div class="font-mono-xs text-muted-foreground">#@item.Id.ToString("N")[..4] · @((item.Visibility ?? "public").ToUpperInvariant())</div>
                                <div class="font-mono-xs text-muted-foreground">⋮</div>
                            </div>
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="d-flex align-items-center justify-content-center rounded-circle" style="width:44px;height:44px;background:#f5c6b7;color:#c85c4c;">📄</div>
                                <div>
                                    <div class="fw-semibold fs-5">@item.Title</div>
                                    <div class="small text-muted-foreground">@(string.IsNullOrWhiteSpace(item.Subject) ? "Chưa có môn học" : item.Subject)</div>
                                </div>
                            </div>
                            <p class="text-muted-foreground mb-3" style="min-height: 48px;">@preview</p>
                            <div class="d-flex justify-content-between align-items-center pt-3 border-top border-border font-mono-xs text-muted-foreground">
                                <div>@item.Status</div>
                                <div>@item.ChunkCount chunks</div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-3 font-mono-xs text-muted-foreground">
                                <span>@item.UpdatedAt.ToString("dd/MM/yyyy")</span>
                                <div class="d-flex align-items-center gap-2">
                                    <a asp-action="Details" asp-route-slug="@item.Slug" class="link-plain text-foreground">Mở →</a>
                                    <a asp-action="Delete" asp-route-slug="@item.Slug" class="link-plain text-danger">Xoá</a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        </section>
    </div>
</div>
